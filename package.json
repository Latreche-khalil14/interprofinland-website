{
  "name": "interprofinland",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --ext .ts,.astro",
    "lint:fix": "eslint . --ext .ts,.astro --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize:images": "node scripts/convert-images-to-webp.js",
    "optimize:update-refs": "node scripts/update-image-references.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^7.8.2",
    "astro": "^4.16.18",
    "resend": "^6.25.0",
    "sharp": "^0.35.4",
    "web-vitals": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/tailwind": "^5.1.2",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^9.18.0",
    "eslint-plugin-astro": "^0.34.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
