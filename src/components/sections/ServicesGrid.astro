---
/**
 * Services Grid Section
 * 4-column editorial grid (2 on tablet, 1 on mobile)
 * Source: docs/design/mockups/home.md - Services section
 */

import ServiceBlock from '@/components/ui/ServiceBlock.astro';

interface ServiceItem {
  title: string;
  description: string;
  icon?: string;
  href: string;
}

interface Props {
  heading?: string;
  subheading?: string;
  services: ServiceItem[];
  viewAllHref?: string;
}

const {
  heading = 'Our Services',
  subheading = 'Discover how we can help you build your career in Finland.',
  services,
  viewAllHref = '/services',
} = Astro.props;
---

<section class="services-section" aria-labelledby="services-heading">
  <div class="container-content">
    <div class="services-header">
      <h2 id="services-heading" class="services-heading">{heading}</h2>
      {subheading && <p class="services-subheading">{subheading}</p>}
    </div>

    <div class="services-grid">
      {
        services.map((service) => (
          <ServiceBlock
            title={service.title}
            description={service.description}
            icon={service.icon}
            href={service.href}
          />
        ))
      }
    </div>

    {
      viewAllHref && (
        <div class="services-footer">
          <a href={viewAllHref} class="services-all-link">
            View All Services <span aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .services-section {
    background-color: var(--color-bg-page);
    padding-top: var(--section-spacing-md);
    padding-bottom: var(--section-spacing-md);
  }

  .services-header {
    margin-bottom: var(--space-12);
  }

  .services-heading {
    font-family: var(--font-display);
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4);
    line-height: var(--line-height-snug);
  }

  .services-subheading {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-gray-700);
    margin: 0;
    max-width: 60ch;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  .services-footer {
    margin-top: var(--space-10);
    text-align: center;
  }

  .services-all-link {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-link);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .services-all-link:hover {
    color: var(--color-text-link-hover);
    text-decoration: underline;
  }

  .services-all-link:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Tablet: 2 columns */
  @media (max-width: 1023px) and (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  /* Mobile: 1 column */
  @media (max-width: 639px) {
    .services-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-all-link {
      transition: none;
    }
  }
</style>
