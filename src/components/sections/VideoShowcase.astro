---
/**
 * VideoShowcase Component
 * Open 2-column video showcase with full controls (play/pause, volume, HD quality selector, fullscreen)
 */
import Container from '@/components/ui/Container.astro';
import Section from '@/components/ui/Section.astro';
---

<Section background="surface" class="video-showcase-section">
  <Container size="page">
    <div class="video-showcase-header">
      <span class="section-eyebrow">Meet InterProFinland · Esittelyvideot</span>
      <h2 class="video-showcase-heading">Discover Our Mission in Video</h2>
      <p class="video-showcase-desc">
        Watch our introduction videos in English and Finnish. Hear about our guidance programs, qualification recognition support, and active international community in Finland.
      </p>
    </div>

    <!-- 2-Video Side-by-Side Grid with Full Controls -->
    <div class="videos-grid">
      <!-- Video 1: English Version -->
      <article class="video-card">
        <div class="video-card-header">
          <div class="video-lang-pill">
            <span class="lang-flag" aria-hidden="true">🇬🇧</span>
            <span class="lang-label">English Version</span>
          </div>
          <span class="video-badge">Official Introduction</span>
        </div>

        <div class="video-frame-wrap">
          <iframe
            src="https://www.youtube.com/embed/xKP1M4A2f9E?controls=1&rel=0&enablejsapi=1&playsinline=1&modestbranding=0"
            title="InterProFinland — Introduction Video (English)"
            width="100%"
            height="100%"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>

        <div class="video-card-body">
          <h3 class="video-title">InterProFinland Overview (English)</h3>
          <p class="video-summary">
            A comprehensive overview of our mission, how we help international professionals recognize foreign qualifications, and connect with Finnish employers.
          </p>
          <div class="video-card-footer">
            <a
              href="https://youtu.be/xKP1M4A2f9E"
              target="_blank"
              rel="noopener noreferrer"
              class="video-yt-btn"
            >
              <span>Watch on YouTube</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>

      <!-- Video 2: Finnish Version -->
      <article class="video-card">
        <div class="video-card-header">
          <div class="video-lang-pill">
            <span class="lang-flag" aria-hidden="true">🇫🇮</span>
            <span class="lang-label">Suomenkielinen versio</span>
          </div>
          <span class="video-badge">Esittelyvideo</span>
        </div>

        <div class="video-frame-wrap">
          <iframe
            src="https://www.youtube.com/embed/NwLTtirsWUk?controls=1&rel=0&enablejsapi=1&playsinline=1&modestbranding=0"
            title="InterProFinland — Esittelyvideo (Suomeksi)"
            width="100%"
            height="100%"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>

        <div class="video-card-body">
          <h3 class="video-title">InterProFinland Esittely (Suomeksi)</h3>
          <p class="video-summary">
            Tutustu toimintaamme: kuinka tuemme kansainvälisiä osaajia, autamme tutkintojen tunnustamisprosessissa ja rakennamme monikulttuurista yhteisöä Satakunnassa.
          </p>
          <div class="video-card-footer">
            <a
              href="https://youtu.be/NwLTtirsWUk"
              target="_blank"
              rel="noopener noreferrer"
              class="video-yt-btn"
            >
              <span>Katso YouTubessa</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>
    </div>
  </Container>
</Section>

<style>
  .video-showcase-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: var(--space-10);
  }

  .video-showcase-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 2.75rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0 0 var(--space-4);
    text-align: center;
  }

  .video-showcase-desc {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 65ch;
    margin: 0 auto;
    text-align: center;
  }

  /* ── 2-Video Side-by-Side Grid ── */
  .videos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3.5vw, 2.5rem);
    margin-bottom: 0;
  }

  .video-card {
    background-color: var(--color-white);
    border: 1.5px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  .video-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary-300, #93c5fd);
    box-shadow: 0 12px 32px rgba(19, 31, 91, 0.12);
  }

  .video-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    background-color: #f8fafc;
    border-bottom: 1px solid var(--color-border-default);
  }

  .video-lang-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-primary-500);
  }

  .lang-flag {
    font-size: 1.125rem;
    line-height: 1;
  }

  .video-badge {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #131F5B;
    background-color: #FFD26F;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  /* ── 16:9 Video Frame with Full Controls Enabled ── */
  .video-frame-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: #0b1129;
  }

  .video-frame-wrap iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .video-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .video-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2);
    line-height: 1.3;
  }

  .video-summary {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--space-4);
    flex: 1;
  }

  .video-card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-default);
  }

  .video-yt-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary-600);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle);
    background-color: #ffffff;
    transition: all 180ms ease;
  }

  .video-yt-btn:hover {
    color: #ffffff;
    background-color: var(--color-primary-600);
    border-color: var(--color-primary-600);
    box-shadow: 0 4px 12px rgba(19, 31, 91, 0.2);
  }

  @media (max-width: 900px) {
    .videos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
