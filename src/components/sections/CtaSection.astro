---
/**
 * CTA Section
 * Centered minimal call-to-action
 * Source: docs/design/mockups/home.md - Final CTA section
 */

interface Props {
  heading: string;
  subheading?: string;
  cta: { label: string; href: string };
}

const { heading, subheading, cta } = Astro.props;
---

<section class="cta-section" aria-labelledby="cta-heading">
  <div class="cta-inner container-narrow">
    <h2 id="cta-heading" class="cta-heading">{heading}</h2>
    {subheading && <p class="cta-sub">{subheading}</p>}
    <a href={cta.href} class="cta-btn">{cta.label}</a>
  </div>
</section>

<style>
  .cta-section {
    background-color: var(--color-bg-page);
    padding-top: var(--section-spacing-md);
    padding-bottom: var(--section-spacing-md);
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: var(--font-size-display-2);
    font-weight: var(--font-weight-bold);
    line-height: var(--line-height-tight);
    color: var(--color-text-primary);
    margin: 0;
    max-width: 22ch;
    text-wrap: balance;
  }

  .cta-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: var(--line-height-loose);
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 55ch;
  }

  /* ── CTA Button — Gold → Navy flip ── */
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: #FFD26F;
    color: #131F5B;
    border: 2px solid #FFD26F;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-4) var(--space-10);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 18px rgba(255, 210, 111, 0.4);
    transition: background-color 200ms ease, color 200ms ease,
                border-color 200ms ease, transform 150ms ease, box-shadow 200ms ease;
  }

  .cta-btn:hover {
    background-color: #1E3A8A;
    border-color: #1E3A8A;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(19, 31, 91, 0.32);
  }

  .cta-btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(19, 31, 91, 0.2);
  }

  .cta-btn:focus-visible {
    outline: 3px solid #FFD26F;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-btn {
      transition: none;
    }
  }
</style>
