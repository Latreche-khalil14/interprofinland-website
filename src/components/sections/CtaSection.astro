---
/**
 * CTA Section
 * Centered call-to-action supporting single or dual actions and alternating background rhythm
 */

interface Props {
  background?: 'default' | 'surface' | 'primary-tint';
  eyebrow?: string;
  heading: string;
  subheading?: string;
  cta: { label: string; href: string; target?: string };
  secondaryCta?: { label: string; href: string; target?: string };
}

const { background = 'default', eyebrow, heading, subheading, cta, secondaryCta } = Astro.props;
---

<section class={`cta-section bg-${background}`} aria-labelledby="cta-heading">
  <div class="cta-inner container-narrow">
    {eyebrow && (
      <span class="cta-eyebrow">{eyebrow}</span>
    )}
    <h2 id="cta-heading" class="cta-heading" set:html={heading} />
    {subheading && <p class="cta-sub">{subheading}</p>}
    <div class="cta-actions">
      <a
        href={cta.href}
        class="cta-btn cta-btn--primary"
        target={cta.target}
        rel={cta.target === '_blank' ? 'noopener noreferrer' : undefined}
      >
        {cta.label}
      </a>
      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class="cta-btn cta-btn--secondary"
          target={secondaryCta.target}
          rel={secondaryCta.target === '_blank' ? 'noopener noreferrer' : undefined}
        >
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-section {
    border-top: 1px solid var(--color-border-subtle, #e2e8f0);
    padding: clamp(5rem, 8vw, 7.5rem) 0;
    position: relative;
    width: 100%;
  }

  .bg-default {
    background-color: var(--color-bg-page, #ffffff);
  }

  .bg-surface {
    background-color: var(--color-bg-surface, #f8fafc);
  }

  .bg-primary-tint {
    background-color: var(--color-primary-50, #eef5fc);
  }

  .cta-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    max-width: 760px;
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .cta-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary-600, #1e3a8a);
    line-height: 1;
  }

  .cta-eyebrow::before,
  .cta-eyebrow::after {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    background-color: #ffd26f;
    flex-shrink: 0;
  }

  .cta-heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: var(--font-weight-extrabold);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--color-text-primary, #0f172a);
    margin: 0;
    max-width: 24ch;
    text-wrap: balance;
  }

  .cta-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 1.7;
    color: var(--color-text-secondary, #475569);
    margin: 0;
    max-width: 58ch;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  /* ── CTA Buttons ── */
  .cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-md);
    min-width: 170px;
    transition: all 250ms ease;
  }

  .cta-btn--primary {
    background-color: #ffd26f;
    color: #131f5b;
    border: 2px solid #ffd26f;
    box-shadow: 0 4px 18px rgba(255, 210, 111, 0.35);
  }

  .cta-btn--primary:hover {
    background-color: #ffe28f;
    border-color: #ffe28f;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 210, 111, 0.45);
  }

  .cta-btn--secondary {
    background-color: transparent;
    color: #131f5b;
    border: 2px solid #131f5b;
  }

  .cta-btn--secondary:hover {
    color: #ffffff;
    border-color: #131f5b;
    background-color: #131f5b;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(19, 31, 91, 0.2);
  }

  .cta-btn:active {
    transform: translateY(0);
  }

  .cta-btn:focus-visible {
    outline: 3px solid #ffd26f;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-btn {
      transition: none;
    }
  }
</style>
