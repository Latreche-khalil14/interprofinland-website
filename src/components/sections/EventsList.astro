---
/**
 * Events List Section
 * Editorial vertical list — date as visual anchor
 * Source: docs/design/mockups/home.md - Events section
 */

import EventItem from '@/components/ui/EventItem.astro';

interface EventData {
  title: string;
  description: string;
  startDate: Date;
  endDate?: Date;
  location?: string;
  registrationUrl?: string;
  href?: string;
}

interface Props {
  heading?: string;
  subheading?: string;
  events: EventData[];
  viewAllHref?: string;
  centered?: boolean;
}

const {
  heading = 'Upcoming Events & Workshops',
  subheading = 'Join us for workshops, seminars, and networking opportunities.',
  events,
  viewAllHref = '/events',
  centered = false,
} = Astro.props;
---

<section class="events-section" aria-labelledby="events-heading">
  <div class="container-content">
    <div class={`events-header ${centered ? 'centered' : ''}`}>
      <h2 id="events-heading" class="events-heading">{heading}</h2>
      {subheading && <p class="events-subheading">{subheading}</p>}
    </div>

    {
      events.length > 0 ? (
        <div class="events-list" role="list">
          {events.map((event) => (
            <div role="listitem">
              <EventItem {...event} />
            </div>
          ))}
        </div>
      ) : (
        <p class="events-empty">No upcoming events at the moment. Check back soon.</p>
      )
    }

    {
      viewAllHref && events.length > 0 && (
        <div class="events-footer">
          <a href={viewAllHref} class="btn-view-all">
            View All Events
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .events-section {
    background-color: var(--color-bg-page);
    padding-top: var(--section-spacing-md);
    padding-bottom: var(--section-spacing-md);
  }

  .events-header {
    margin-bottom: var(--space-12);
  }

  .events-header.centered {
    text-align: center;
  }

  .events-heading {
    font-family: var(--font-display);
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-4);
    line-height: var(--line-height-snug);
  }

  .events-subheading {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-gray-700);
    margin: 0;
    max-width: 60ch;
  }

  .events-header.centered .events-subheading {
    margin-inline: auto;
  }

  .events-list {
    max-width: 56rem;
  }

  .events-empty {
    font-family: var(--font-body);
    color: var(--color-text-secondary);
    padding: var(--space-8) 0;
  }

  .events-footer {
    margin-top: var(--space-10);
    text-align: center;
  }

  .btn-view-all {
    display: inline-flex;
    align-items: center;
    background-color: transparent;
    color: var(--color-primary-500);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    padding: calc(var(--space-3) - 2px) calc(var(--space-6) - 2px);
    border: 2px solid var(--color-primary-500);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .btn-view-all:hover {
    background-color: var(--color-primary-50);
  }

  .btn-view-all:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-view-all {
      transition: none;
    }
  }
</style>
