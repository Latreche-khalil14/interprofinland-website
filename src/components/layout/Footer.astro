---
/**
 * Footer Component
 * Site-wide footer with complete official address, office hours, visiting notice, and contacts
 * Source: docs/design/component-visual-language.md - Footer Navigation
 */

const year = new Date().getFullYear();

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const footerLinks: Record<string, { label: string; links: FooterLink[] }> = {
  organization: {
    label: 'Organization',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Community', href: '/community' },
      { label: 'Projects', href: '/projects' },
      { label: 'Stories', href: '/stories' },
      {
        label: 'Apply for Membership',
        href: 'https://form.jotform.com/InterProFinland/membership-application-form',
        external: true,
      },
    ],
  },
  services: {
    label: 'Services',
    links: [
      { label: 'Career Guidance', href: '/services/career-guidance' },
      { label: 'Qualification Recognition', href: '/services/qualification-recognition' },
      { label: 'Mentorship', href: '/services/mentorship' },
      { label: 'Networking & Events', href: '/services/networking' },
    ],
  },
  resources: {
    label: 'Resources',
    links: [
      { label: 'Magazine', href: '/magazine' },
      { label: 'Events', href: '/events' },
      { label: 'Contact', href: '/contact' },
      { label: 'Privacy Policy', href: '/privacy-policy' },
      { label: 'Cookie Policy', href: '/cookie-policy' },
    ],
  },
};
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner container-page">
    <!-- Top: Org info + Office Details + Nav columns -->
    <div class="footer-top">
      <!-- Brand & Mission column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="InterProFinland — Home">
          <img
            src="/images/logo.webp"
            alt="InterProFinland"
            class="footer-logo-img"
            width="150"
            height="44"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="footer-tagline">
          Empowering international professionals living in Finland through individualized guidance,
          qualification recognition support, mentorship, and regional connections.
        </p>

        <!-- Social Media Links -->
        <div class="footer-social">
          <a
            href="https://www.facebook.com/interprofinland"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Follow us on Facebook"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/company/interprofinland"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Follow us on LinkedIn"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href="https://www.instagram.com/interprofinland"
            target="_blank"
            rel="noopener noreferrer"
            class="social-link"
            aria-label="Follow us on Instagram"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.630c-.789.306-1.459.717-2.126 1.384S.935 3.35.630 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.630c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.794.646-1.439 1.44-1.439.793-.001 1.44.645 1.44 1.439z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Office & Contact Info column -->
      <div class="footer-contact-block">
        <h3 class="footer-nav-heading">Office &amp; Inquiries</h3>
        <address class="footer-address">
          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">📍</span>
            <div>
              <strong>Office Address:</strong>
              <span>Otavankatu 5 A, 28100, Pori, Finland</span>
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">🕒</span>
            <div>
              <strong>Office Hours:</strong>
              <span>Mon–Fri, 9:00–15:00</span>
              <span class="contact-sub">Sat–Sun: Closed</span>
              <span class="contact-sub">Visits: By appointment only (Mon &amp; Wed)</span>
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">✉️</span>
            <div>
              <strong>General Inquiries:</strong>
              <a href="mailto:info@interprofinland.fi" class="footer-link-highlight"
                >info@interprofinland.fi</a
              >
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">📞</span>
            <div>
              <strong>Phone:</strong>
              <a href="tel:+358417282563" class="footer-link-highlight">+358 41 728 2563</a>
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">🎓</span>
            <div>
              <strong>Diploma Recognition Support:</strong>
              <a href="mailto:degree.amplify@interprofinland.fi" class="footer-link-highlight"
                >degree.amplify@interprofinland.fi</a
              >
            </div>
          </div>
        </address>
      </div>

      <!-- Navigation columns -->
      <nav class="footer-nav" aria-label="Footer navigation">
        {
          Object.values(footerLinks).map((section) => (
            <div class="footer-nav-column">
              <h3 class="footer-nav-heading">{section.label}</h3>
              <ul class="footer-nav-list" role="list">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="footer-nav-link"
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <!-- Bottom: copyright & legal -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {year} InterProFinland (International Professionals in Finland). All rights reserved.
      </p>
      <div class="footer-legal">
        <a
          href="https://wa.me/358449367069"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-legal-link">Book an Appointment</a
        >
        <span aria-hidden="true">·</span>
        <a href="/privacy-policy" class="footer-legal-link">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/cookie-policy" class="footer-legal-link">Cookie Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/contact" class="footer-legal-link">Contact Us</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #131f5b;
    color: var(--color-gray-300);
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-inner {
    padding-top: clamp(3.5rem, 8vw, 5rem);
    padding-bottom: var(--space-8);
  }

  /* ── Top Section ── */
  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 1.2fr 1.6fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: var(--space-8);
  }

  /* ── Brand ── */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    background-color: #ffffff;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm, 6px);
    width: fit-content;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .footer-logo:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .footer-logo-img {
    height: 38px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    display: block;
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: var(--line-height-loose);
    color: var(--color-gray-400);
    margin: 0;
    max-width: 36ch;
  }

  .footer-appointment-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }

  .footer-appointment-note p {
    margin: 0;
  }

  .footer-appointment-note strong {
    color: var(--color-white);
  }

  /* ── Contact & Address Block ── */
  .footer-contact-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.875rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-gray-300);
    line-height: 1.45;
  }

  .contact-item strong {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-gray-400);
    font-weight: var(--font-weight-medium);
  }

  .contact-sub {
    display: block;
    font-size: 0.75rem;
    color: var(--color-gray-500);
  }

  .contact-icon {
    font-size: 0.9375rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .footer-link-highlight {
    color: var(--color-primary-400, #4db3c4);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      text-decoration var(--transition-fast);
    word-break: break-all;
  }

  .footer-link-highlight:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  /* ── Nav Columns ── */
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .footer-nav-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-nav-heading {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-400);
    margin: 0;
  }

  .footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-nav-link {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--color-gray-300);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: inline-block;
  }

  .footer-nav-link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  .footer-nav-link:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Bottom Bar ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copyright {
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin: 0;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-legal-link {
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-gray-400);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-legal-link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  .footer-legal-link:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) and (min-width: 769px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    .footer-nav {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, 1fr);
      margin-top: var(--space-2);
    }
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding-top: 2.25rem;
      padding-bottom: 1.5rem;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-bottom: var(--space-6);
      margin-bottom: var(--space-4);
    }

    .footer-brand {
      gap: var(--space-3);
    }

    .footer-tagline {
      font-size: 0.875rem;
      line-height: 1.55;
      max-width: 100%;
    }

    .footer-appointment-note {
      padding: var(--space-2) var(--space-3);
      font-size: 0.78125rem;
      gap: var(--space-2);
    }

    .footer-contact-block {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md, 12px);
      padding: var(--space-4);
      gap: var(--space-3);
    }

    .footer-address {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      font-size: 0.8125rem;
    }

    .contact-item {
      gap: var(--space-2);
      line-height: 1.35;
    }

    .contact-item strong {
      font-size: 0.75rem;
    }

    /* 2-Column compact navigation to save 60% vertical space */
    .footer-nav {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5) var(--space-4);
      padding: var(--space-1) 0;
    }

    .footer-nav-column {
      gap: var(--space-2);
    }

    .footer-nav-heading {
      font-size: 0.6875rem;
      margin-bottom: 2px;
    }

    .footer-nav-list {
      gap: 6px;
    }

    .footer-nav-link {
      font-size: 0.84375rem;
      padding: 1px 0;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2);
      padding-top: var(--space-2);
    }

    .footer-copyright {
      font-size: 0.78125rem;
      text-align: center;
    }

    .footer-legal {
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-2);
      font-size: 0.78125rem;
    }

    .footer-legal-link {
      font-size: 0.78125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-nav-link,
    .footer-legal-link,
    .footer-link-highlight {
      transition: none;
    }
  }

  /* ── Social Media Links ── */
  .footer-social {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-gray-300);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .social-link:hover {
    background-color: var(--color-primary-600);
    color: white;
    transform: translateY(-2px);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--color-primary-600);
    outline-offset: 2px;
  }

  .social-link svg {
    width: 20px;
    height: 20px;
  }
</style>
