---
/**
 * Footer Component
 * Site-wide footer with complete official address, office hours, visiting notice, and contacts
 * Source: docs/design/component-visual-language.md - Footer Navigation
 */

const year = new Date().getFullYear();

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const footerLinks: Record<string, { label: string; links: FooterLink[] }> = {
  organization: {
    label: 'Organization',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Community', href: '/community' },
      { label: 'Projects', href: '/projects' },
      { label: 'Stories', href: '/stories' },
      {
        label: 'Apply for Membership',
        href: 'https://form.jotform.com/InterProFinland/membership-application-form',
        external: true,
      },
    ],
  },
  services: {
    label: 'Services',
    links: [
      { label: 'Career Guidance', href: '/services/career-guidance' },
      { label: 'Qualification Recognition', href: '/services/qualification-recognition' },
      { label: 'Mentorship', href: '/services/mentorship' },
      { label: 'Networking & Events', href: '/services/networking' },
    ],
  },
  resources: {
    label: 'Resources',
    links: [
      { label: 'Magazine', href: '/magazine' },
      { label: 'Events', href: '/events' },
      { label: 'Contact', href: '/contact' },
      { label: 'Privacy Policy', href: '/privacy-policy' },
      { label: 'Cookie Policy', href: '/cookie-policy' },
    ],
  },
};
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-inner container-page">
    <!-- Top: Org info + Office Details + Nav columns -->
    <div class="footer-top">
      <!-- Brand & Mission column -->
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label="InterProFinland — Home">
          <img
            src="/images/logo.jpg"
            alt="InterProFinland"
            class="footer-logo-img"
            width="150"
            height="44"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="footer-tagline">
          Empowering international professionals living in Finland through individualized guidance,
          qualification recognition support, mentorship, and regional connections.
        </p>
      </div>

      <!-- Office & Contact Info column -->
      <div class="footer-contact-block">
        <h3 class="footer-nav-heading">Office &amp; Inquiries</h3>
        <address class="footer-address">
          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">📍</span>
            <div>
              <strong>Office Address:</strong>
              <span>Otavankatu 5 A, 28100, Pori, Finland</span>
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">🕒</span>
            <div>
              <strong>Office Hours:</strong>
              <span>Mon–Fri, 9:00–15:00</span>
              <span class="contact-sub">Sat–Sun: Closed</span>
              <span class="contact-sub">Visits: By appointment only (Mon &amp; Wed)</span>
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">✉️</span>
            <div>
              <strong>General Inquiries:</strong>
              <a href="mailto:info@interprofinland.fi" class="footer-link-highlight"
                >info@interprofinland.fi</a
              >
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">📞</span>
            <div>
              <strong>Phone:</strong>
              <a href="tel:+358417282563" class="footer-link-highlight">+358 41 728 2563</a>
            </div>
          </div>

          <div class="contact-item">
            <span class="contact-icon" aria-hidden="true">🎓</span>
            <div>
              <strong>Diploma Recognition Support:</strong>
              <a href="mailto:degree.amplify@interprofinland.fi" class="footer-link-highlight"
                >degree.amplify@interprofinland.fi</a
              >
            </div>
          </div>
        </address>
      </div>

      <!-- Navigation columns -->
      <nav class="footer-nav" aria-label="Footer navigation">
        {
          Object.values(footerLinks).map((section) => (
            <div class="footer-nav-column">
              <h3 class="footer-nav-heading">{section.label}</h3>
              <ul class="footer-nav-list" role="list">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="footer-nav-link"
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <!-- Bottom: copyright & legal -->
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {year} InterProFinland (International Professionals in Finland). All rights reserved.
      </p>
      <div class="footer-legal">
        <a
          href="https://wa.me/358449367069"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-legal-link">Book an Appointment</a
        >
        <span aria-hidden="true">·</span>
        <a href="/privacy-policy" class="footer-legal-link">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/cookie-policy" class="footer-legal-link">Cookie Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/contact" class="footer-legal-link">Contact Us</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #131f5b;
    color: var(--color-gray-300);
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-inner {
    padding-top: clamp(3.5rem, 8vw, 5rem);
    padding-bottom: var(--space-8);
  }

  /* ── Top Section ── */
  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 1.2fr 1.6fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    margin-bottom: var(--space-8);
  }

  /* ── Brand ── */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    background-color: #ffffff;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm, 6px);
    width: fit-content;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .footer-logo:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .footer-logo-img {
    height: 38px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    display: block;
  }

  .footer-tagline {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: var(--line-height-loose);
    color: var(--color-gray-400);
    margin: 0;
    max-width: 36ch;
  }

  .footer-appointment-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }

  .footer-appointment-note p {
    margin: 0;
  }

  .footer-appointment-note strong {
    color: var(--color-white);
  }

  /* ── Contact & Address Block ── */
  .footer-contact-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-address {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.875rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: var(--color-gray-300);
    line-height: 1.45;
  }

  .contact-item strong {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-gray-400);
    font-weight: var(--font-weight-medium);
  }

  .contact-sub {
    display: block;
    font-size: 0.75rem;
    color: var(--color-gray-500);
  }

  .contact-icon {
    font-size: 0.9375rem;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .footer-link-highlight {
    color: var(--color-primary-400, #4db3c4);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      text-decoration var(--transition-fast);
    word-break: break-all;
  }

  .footer-link-highlight:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  /* ── Nav Columns ── */
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .footer-nav-column {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-nav-heading {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-400);
    margin: 0;
  }

  .footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-nav-link {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    color: var(--color-gray-300);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: inline-block;
  }

  .footer-nav-link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  .footer-nav-link:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Bottom Bar ── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copyright {
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin: 0;
  }

  .footer-legal {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-legal-link {
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-gray-400);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-legal-link:hover {
    color: var(--color-white);
    text-decoration: underline;
  }

  .footer-legal-link:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ── Responsive ── */
  @media (max-width: 1023px) and (min-width: 769px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    .footer-nav {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, 1fr);
      margin-top: var(--space-2);
    }
  }

  @media (max-width: 768px) {
    .footer-inner {
      padding-top: 2.25rem;
      padding-bottom: 1.5rem;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding-bottom: var(--space-6);
      margin-bottom: var(--space-4);
    }

    .footer-brand {
      gap: var(--space-3);
    }

    .footer-tagline {
      font-size: 0.875rem;
      line-height: 1.55;
      max-width: 100%;
    }

    .footer-appointment-note {
      padding: var(--space-2) var(--space-3);
      font-size: 0.78125rem;
      gap: var(--space-2);
    }

    .footer-contact-block {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md, 12px);
      padding: var(--space-4);
      gap: var(--space-3);
    }

    .footer-address {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      font-size: 0.8125rem;
    }

    .contact-item {
      gap: var(--space-2);
      line-height: 1.35;
    }

    .contact-item strong {
      font-size: 0.75rem;
    }

    /* 2-Column compact navigation to save 60% vertical space */
    .footer-nav {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5) var(--space-4);
      padding: var(--space-1) 0;
    }

    .footer-nav-column {
      gap: var(--space-2);
    }

    .footer-nav-heading {
      font-size: 0.6875rem;
      margin-bottom: 2px;
    }

    .footer-nav-list {
      gap: 6px;
    }

    .footer-nav-link {
      font-size: 0.84375rem;
      padding: 1px 0;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--space-2);
      padding-top: var(--space-2);
    }

    .footer-copyright {
      font-size: 0.78125rem;
      text-align: center;
    }

    .footer-legal {
      justify-content: center;
      flex-wrap: wrap;
      gap: var(--space-2);
      font-size: 0.78125rem;
    }

    .footer-legal-link {
      font-size: 0.78125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-nav-link,
    .footer-legal-link,
    .footer-link-highlight {
      transition: none;
    }
  }
</style>
