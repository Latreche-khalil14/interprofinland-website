---
/**
 * Header / Site Navigation — Editorial Style
 * Logo · About · Services ▾ · Events · Projects · Community · Magazine · Stories · Contact →
 * Source: docs/design/component-visual-language.md - Navigation
 */

interface NavItem {
  label: string;
  href: string;
  hasDropdown?: boolean;
}

const serviceLinks = [
  { label: 'Career Guidance', href: '/services/career-guidance' },
  { label: 'Qualification Recognition', href: '/services/qualification-recognition' },
  { label: 'Mentorship', href: '/services/mentorship' },
  { label: 'Networking', href: '/services/networking' },
] as const;

const mainLinks: NavItem[] = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services', hasDropdown: true },
  { label: 'Events', href: '/events' },
  { label: 'Projects', href: '/projects' },
  { label: 'Community', href: '/community' },
  { label: 'Magazine', href: '/magazine' },
  { label: 'Stories', href: '/stories' },
  { label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header" role="banner">
  <!-- Scroll Progress Indicator Bar -->
  <div id="scroll-progress-bar" class="scroll-progress-bar" aria-hidden="true"></div>

  <div class="header-inner container-page">
    <!-- Logo -->
    <a href="/" class="site-logo" aria-label="InterProFinland — Home">
      <img
        src="/images/brand/logo/logo.jpg"
        alt="InterProFinland"
        class="logo-img"
        width="200"
        height="56"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul class="nav-list" role="list">
        {
          mainLinks.map((link) =>
            link.hasDropdown ? (
              <li class="nav-item has-dropdown">
                <a
                  href={link.href}
                  class={`nav-link nav-link--dropdown ${isActive(link.href) ? 'is-active' : ''}`}
                  aria-haspopup="true"
                  aria-expanded="false"
                  id="services-menu-btn"
                >
                  <span>{link.label}</span>
                  <span class="dropdown-chevron" aria-hidden="true">
                    ▾
                  </span>
                </a>
                <div class="dropdown-panel" role="region" aria-labelledby="services-menu-btn">
                  <div class="dropdown-panel-inner">
                    <ul class="dropdown-list" role="list">
                      {serviceLinks.map((s) => (
                        <li>
                          <a
                            href={s.href}
                            class={`dropdown-link ${isActive(s.href) ? 'is-active' : ''}`}
                            aria-current={isActive(s.href) ? 'page' : undefined}
                          >
                            {s.label}
                          </a>
                        </li>
                      ))}
                      <li class="dropdown-all-link-row">
                        <a href="/services" class="dropdown-all-link">
                          All Services →
                        </a>
                      </li>
                    </ul>
                  </div>
                </div>
              </li>
            ) : (
              <li class="nav-item">
                <a
                  href={link.href}
                  class={`nav-link ${isActive(link.href) ? 'is-active' : ''}`}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <!-- Join Us CTA (desktop) + Mobile Toggle -->
    <div class="header-actions">
      <a
        href="https://form.jotform.com/InterProFinland/membership-application-form"
        class="header-contact-cta"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Join Us — Membership Application (opens in new tab)"
      >
        <span>Join Us</span>
        <span class="cta-arrow" aria-hidden="true">→</span>
      </a>

      <!-- Mobile Menu Toggle -->
      <button
        class="menu-toggle"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Open navigation menu"
        type="button"
      >
        <span class="hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Overlay -->
<div
  id="mobile-menu"
  class="mobile-menu"
  aria-hidden="true"
  role="dialog"
  aria-label="Navigation menu"
  aria-modal="true"
>
  <div class="mobile-menu-inner">
    <div class="mobile-menu-header">
      <a href="/" class="site-logo" aria-label="InterProFinland — Home" tabindex="-1">
        <img
          src="/images/brand/logo/logo.jpg"
          alt="InterProFinland"
          class="logo-img"
          width="170"
          height="50"
          loading="lazy"
        />
      </a>
      <button class="menu-close" aria-label="Close navigation menu" type="button">
        <span aria-hidden="true">✕</span>
      </button>
    </div>

    <nav aria-label="Mobile navigation">
      <ul class="mobile-nav-list" role="list">
        {
          mainLinks.map((link) =>
            link.hasDropdown ? (
              <li class="mobile-nav-item mobile-nav-item--parent">
                <a
                  href={link.href}
                  class={`mobile-nav-link ${isActive(link.href) ? 'is-active' : ''}`}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
                <ul class="mobile-sub-list" role="list">
                  {serviceLinks.map((s) => (
                    <li>
                      <a
                        href={s.href}
                        class={`mobile-sub-link ${isActive(s.href) ? 'is-active' : ''}`}
                        aria-current={isActive(s.href) ? 'page' : undefined}
                      >
                        {s.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="mobile-nav-item">
                <a
                  href={link.href}
                  class={`mobile-nav-link ${isActive(link.href) ? 'is-active' : ''}`}
                  aria-current={isActive(link.href) ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            )
          )
        }

        <li class="mobile-nav-item mobile-nav-item--contact">
          <a
            href="https://form.jotform.com/InterProFinland/membership-application-form"
            class="mobile-contact-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>Join Us (Membership)</span>
            <span aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</div>

<!-- Backdrop -->
<div class="mobile-backdrop" aria-hidden="true"></div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const closeBtn = document.querySelector<HTMLButtonElement>('.menu-close');
  const menu = document.getElementById('mobile-menu');
  const backdrop = document.querySelector<HTMLElement>('.mobile-backdrop');
  const focusable = 'a[href]:not([tabindex="-1"]), button:not([disabled])';

  function openMenu() {
    menu?.removeAttribute('aria-hidden');
    backdrop?.classList.add('is-visible');
    document.body.style.overflow = 'hidden';
    toggle?.setAttribute('aria-expanded', 'true');
    toggle?.setAttribute('aria-label', 'Close navigation menu');
    closeBtn?.focus();
  }

  function closeMenu() {
    menu?.setAttribute('aria-hidden', 'true');
    backdrop?.classList.remove('is-visible');
    document.body.style.overflow = '';
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open navigation menu');
    toggle?.focus();
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  // Close menu when a link is clicked
  menu?.querySelectorAll('a[href]').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Trap focus inside open mobile menu
  menu?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key !== 'Tab') return;
    const els = Array.from(menu.querySelectorAll<HTMLElement>(focusable));
    const first = els[0];
    const last = els[els.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last?.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first?.focus();
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      closeMenu();
    }
  });

  // Services dropdown keyboard support on desktop
  const dropdownLink = document.querySelector<HTMLAnchorElement>('.nav-link--dropdown');
  const dropdownPanel = document.querySelector<HTMLElement>('.dropdown-panel');

  dropdownLink?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      dropdownPanel?.classList.add('is-open');
      dropdownLink.setAttribute('aria-expanded', 'true');
      const firstLink = dropdownPanel?.querySelector<HTMLAnchorElement>('a');
      firstLink?.focus();
    }
  });

  dropdownPanel?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      dropdownPanel.classList.remove('is-open');
      dropdownLink?.setAttribute('aria-expanded', 'false');
      dropdownLink?.focus();
    }
  });

  // Scroll Progress Bar calculation (Hardware Accelerated)
  const progressBar = document.getElementById('scroll-progress-bar');
  if (progressBar) {
    let ticking = false;
    const updateProgress = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight =
        document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const progress = docHeight > 0 ? Math.min(Math.max(scrollTop / docHeight, 0), 1) : 0;
      progressBar.style.transform = `scaleX(${progress})`;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateProgress);
          ticking = true;
        }
      },
      { passive: true }
    );

    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();
  }
</script>

<style>
  /* ── Header Bar ── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border-default);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.03);
  }

  /* ── Scroll Progress Indicator ── */
  .scroll-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3.5px;
    background: linear-gradient(90deg, #ffd26f 0%, #ffc340 50%, #ffd26f 100%);
    box-shadow: 0 1px 8px rgba(255, 210, 111, 0.6);
    transform-origin: left center;
    transform: scaleX(0);
    z-index: 100;
    pointer-events: none;
    will-change: transform;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    height: 5.75rem; /* Spacious high-end editorial height */
  }

  /* ── Logo with Page-Load Entrance Sway & Hover Micro-interaction ── */
  .site-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    animation: logoEntranceSway 1s cubic-bezier(0.22, 1, 0.36, 1) both;
    transition:
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 300ms ease;
  }

  .site-logo:hover {
    transform: translateY(-2px) scale(1.02);
  }

  .site-logo:active {
    transform: translateY(0) scale(0.99);
  }

  .site-logo:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  .logo-img {
    height: 54px; /* Prominent, crisp logo size */
    width: auto;
    max-width: 220px;
    object-fit: contain;
    display: block;
    transition: filter 300ms ease;
  }

  .site-logo:hover .logo-img {
    filter: drop-shadow(0 4px 12px rgba(19, 31, 91, 0.12));
  }

  @keyframes logoEntranceSway {
    0% {
      opacity: 0;
      transform: translateX(-16px) scale(0.95);
      filter: blur(2px);
    }
    45% {
      opacity: 1;
      transform: translateX(6px) scale(1.02);
      filter: blur(0);
    }
    70% {
      transform: translateX(-3px) scale(0.995);
    }
    88% {
      transform: translateX(1.5px) scale(1.005);
    }
    100% {
      opacity: 1;
      transform: translateX(0) scale(1);
      filter: blur(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-logo {
      animation: none;
      transition: none;
    }
  }

  /* ── Desktop Nav ── */
  .desktop-nav {
    display: none;
    flex: 1;
    justify-content: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  /* Shared nav-link styles */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-display);
    font-size: 1rem; /* 16px prominent font size */
    font-weight: 500;
    color: var(--color-gray-700);
    text-decoration: none;
    padding: var(--space-3) var(--space-4);
    background: none;
    border: none;
    cursor: pointer;
    letter-spacing: 0.01em;
    position: relative;
    transition: color var(--transition-fast);
  }

  /* Editorial Underline indicator */
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: var(--space-4);
    right: var(--space-4);
    height: 2px;
    background-color: var(--color-primary-600);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms ease;
  }

  .nav-link:hover {
    color: var(--color-primary-600);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .nav-link.is-active {
    color: var(--color-primary-500);
    font-weight: 600;
  }

  .nav-link:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .dropdown-chevron {
    font-size: 0.75rem;
    color: var(--color-gray-500);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  /* ── Hover Dropdown for Desktop ── */
  @media (min-width: 1024px) {
    .has-dropdown:hover .dropdown-panel,
    .has-dropdown:focus-within .dropdown-panel,
    .dropdown-panel.is-open {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .has-dropdown:hover .dropdown-chevron,
    .has-dropdown:focus-within .dropdown-chevron,
    .dropdown-panel.is-open + .nav-link .dropdown-chevron {
      transform: rotate(180deg);
      color: var(--color-primary-600);
    }
  }

  /* ── Services Dropdown Panel ── */
  .dropdown-panel {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 0.75rem;
    min-width: 260px;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out),
      visibility var(--duration-fast) var(--ease-out);
    z-index: var(--z-dropdown, 50);
    pointer-events: none;
  }

  .dropdown-panel-inner {
    background-color: var(--color-white);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.12);
    padding: var(--space-3) 0;
  }

  .dropdown-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dropdown-link {
    display: block;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-normal);
    color: var(--color-gray-700);
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .dropdown-link:hover {
    color: var(--color-primary-600);
    background-color: var(--color-primary-50);
  }

  .dropdown-link.is-active {
    color: var(--color-primary-600);
    font-weight: var(--font-weight-semibold);
  }

  .dropdown-link:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: -2px;
  }

  .dropdown-all-link-row {
    border-top: 1px solid var(--color-border-default);
    margin-top: var(--space-2);
    padding-top: var(--space-2);
  }

  .dropdown-all-link {
    display: block;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-600);
    text-decoration: none;
    padding: var(--space-2) var(--space-6);
    transition: color var(--transition-fast);
  }

  .dropdown-all-link:hover {
    color: var(--color-primary-700);
    text-decoration: underline;
  }

  /* ── Header Actions (Contact CTA + Mobile toggle) ── */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  /* ── Contact CTA Button — Gold → Navy flip ── */
  .header-contact-cta {
    display: none;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #131f5b;
    text-decoration: none;
    white-space: nowrap;
    align-items: center;
    gap: var(--space-2);
    padding: 0.75rem 1.625rem;
    border: 2px solid #ffd26f;
    border-radius: 6px;
    background-color: #ffd26f;
    box-shadow: 0 4px 14px rgba(255, 210, 111, 0.35);
    transition:
      color 200ms ease,
      border-color 200ms ease,
      background-color 200ms ease,
      transform 150ms ease,
      box-shadow 200ms ease;
  }

  .header-contact-cta:hover {
    color: #ffffff;
    background-color: #1e3a8a;
    border-color: #1e3a8a;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(19, 31, 91, 0.3);
  }

  .cta-arrow {
    transition: transform 200ms ease;
    font-size: 1.125rem;
  }

  .header-contact-cta:hover .cta-arrow {
    transform: translateX(3px);
  }

  .header-contact-cta:focus-visible {
    outline: 3px solid #ffd26f;
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }

  /* ── Hamburger Button ── */
  .menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .menu-toggle:hover {
    background-color: var(--color-gray-100);
  }

  .menu-toggle:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }

  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 1.5rem;
  }

  .hamburger span {
    display: block;
    height: 2.5px;
    background-color: var(--color-gray-700);
    border-radius: 1px;
    transition: all var(--duration-fast) var(--ease-in-out);
  }

  /* ── Mobile Menu Overlay ── */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background-color: var(--color-white);
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    transform: translateX(100%);
    transition:
      opacity var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      visibility var(--duration-base) var(--ease-out);
  }

  .mobile-menu:not([aria-hidden='true']) {
    visibility: visible;
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-menu-inner {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-6) var(--container-padding);
    gap: var(--space-6);
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-default);
  }

  .menu-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.375rem;
    color: var(--color-gray-700);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .menu-close:hover {
    background-color: var(--color-gray-100);
  }

  .menu-close:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }

  /* Mobile nav list */
  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .mobile-nav-item {
    border-bottom: 1px solid var(--color-border-default);
  }

  .mobile-nav-link {
    display: block;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    text-decoration: none;
    padding: var(--space-4) 0;
    transition: color var(--transition-fast);
    min-height: 3rem;
  }

  .mobile-nav-link:hover {
    color: var(--color-primary-500);
  }

  .mobile-nav-link.is-active {
    color: var(--color-primary-500);
    font-weight: var(--font-weight-semibold);
  }

  .mobile-nav-link:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Mobile sub-links (Services) */
  .mobile-sub-list {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
  }

  .mobile-sub-link {
    display: block;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: var(--font-weight-normal);
    color: var(--color-gray-600);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color var(--transition-fast);
    border-left: 2px solid var(--color-border-default);
    padding-left: var(--space-3);
  }

