---
/**
 * Event Item Component
 * Editorial list layout with large date as visual anchor
 * Source: docs/design/mockups/home.md - Events section
 */

import { formatDate } from '@/utils/formatDate';

interface Props {
  title: string;
  description: string;
  startDate: Date;
  endDate?: Date;
  location?: string;
  registrationUrl?: string;
  href?: string;
}

const { title, description, startDate, location, registrationUrl, href } = Astro.props;

const day = startDate.toLocaleDateString('en-US', { day: '2-digit' });
const monthYear = startDate
  .toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  .toUpperCase();
const time = startDate.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
---

<article class="event-item">
  <div class="event-date" aria-label={formatDate(startDate)}>
    <span class="event-day">{day}</span>
    <span class="event-month">{monthYear}</span>
  </div>

  <div class="event-content">
    <h3 class="event-title">
      {href ? <a href={href}>{title}</a> : title}
    </h3>

    <p class="event-description">{description}</p>

    <p class="event-meta">
      <span>{time}</span>
      {
        location && (
          <>
            <>
              <span aria-hidden="true"> · </span>
              <span>{location}</span>
            </>
          </>
        )
      }
    </p>

    <div class="event-actions">
      {
        registrationUrl && (
          <a href={registrationUrl} class="btn-register" rel="noopener noreferrer" target="_blank">
            Register
          </a>
        )
      }
      {
        href && (
          <a href={href} class="link-more">
            Learn More <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .event-item {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-8);
    padding: var(--space-8) 0;
    border-bottom: 1px solid var(--color-border-default);
  }

  .event-item:first-child {
    border-top: 1px solid var(--color-border-default);
  }

  /* Large date — visual anchor */
  .event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    padding-top: var(--space-1);
  }

  .event-day {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-500);
    line-height: 1;
  }

  .event-month {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
  }

  .event-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .event-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-snug);
    color: var(--color-text-primary);
    margin: 0;
  }

  .event-title a {
    color: inherit;
    text-decoration: none;
  }

  .event-title a:hover {
    color: var(--color-primary-500);
    text-decoration: underline;
  }

  .event-title a:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .event-description {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: var(--line-height-loose);
    color: var(--color-text-secondary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .event-meta {
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-gray-500);
    margin: 0;
  }

  .event-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-1);
  }

  .btn-register {
    display: inline-flex;
    align-items: center;
    background-color: var(--color-primary-500);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .btn-register:hover {
    background-color: var(--color-primary-600);
  }

  .btn-register:focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }

  .link-more {
    color: var(--color-text-link);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-medium);
    transition: color var(--transition-fast);
  }

  .link-more:hover {
    color: var(--color-text-link-hover);
    text-decoration: underline;
  }

  .link-more:focus-visible {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Mobile — stack date above content */
  @media (max-width: 639px) {
    .event-item {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .event-date {
      flex-direction: row;
      gap: var(--space-2);
      align-items: baseline;
    }

    .event-day {
      font-size: 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-register,
    .link-more {
      transition: none;
    }
  }
</style>
