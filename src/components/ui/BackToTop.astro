---
/**
 * BackToTop Component
 * Floating scroll-to-top button with gold & royal navy flip styling and smooth scrolling
 */
---

<button
  id="back-to-top"
  class="back-to-top"
  type="button"
  aria-label="Back to top of page"
  title="Back to top"
>
  <span class="back-to-top-icon" aria-hidden="true">↑</span>
</button>

<script>
  const backToTopBtn = document.getElementById('back-to-top');

  if (backToTopBtn) {
    let isVisible = false;
    let ticking = false;

    const handleScroll = () => {
      const scrollPos = window.scrollY || document.documentElement.scrollTop;
      const shouldShow = scrollPos > 320;

      if (shouldShow !== isVisible) {
        isVisible = shouldShow;
        backToTopBtn.classList.toggle('is-visible', isVisible);
      }
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(handleScroll);
          ticking = true;
        }
      },
      { passive: true }
    );

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
      // Return focus to top of page for screen readers
      const mainContent = document.getElementById('main-content');
      mainContent?.focus();
    });

    handleScroll();
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    bottom: clamp(1.5rem, 4vw, 2.5rem);
    right: clamp(1.5rem, 4vw, 2.5rem);
    z-index: 90;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.125rem; /* 50px */
    height: 3.125rem;
    border-radius: 50%;
    background-color: var(--color-gold, #ffd26f);
    color: var(--color-primary-500, #131f5b);
    border: 2px solid var(--color-gold, #ffd26f);
    cursor: pointer;
    box-shadow: 0 4px 18px var(--color-gold-shadow, rgba(255, 210, 111, 0.45));
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.85);
    transition:
      opacity 280ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 280ms ease,
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      box-shadow 200ms ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .back-to-top:hover {
    background-color: var(--color-primary-600, #1e3a8a);
    border-color: var(--color-primary-600, #1e3a8a);
    color: #ffffff;
    transform: translateY(-4px) scale(1.08);
    box-shadow: 0 8px 24px rgba(19, 31, 91, 0.35);
  }

  .back-to-top:active {
    transform: translateY(0) scale(0.96);
    box-shadow: 0 2px 8px rgba(19, 31, 91, 0.25);
  }

  .back-to-top:focus-visible {
    outline: 3px solid #ffd26f;
    outline-offset: 3px;
  }

  .back-to-top-icon {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1;
    transition: transform 200ms ease;
  }

  .back-to-top:hover .back-to-top-icon {
    transform: translateY(-2px);
  }

  @media (max-width: 640px) {
    .back-to-top {
      bottom: 1.25rem;
      right: 1.25rem;
      width: 2.75rem;
      height: 2.75rem;
    }

    .back-to-top-icon {
      font-size: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
    .back-to-top:hover .back-to-top-icon {
      transform: none;
    }
  }
</style>
