---
/**
 * Loading Spinner Component
 * Accessible loading indicator
 */

interface Props {
  size?: 'sm' | 'md' | 'lg';
  text?: string;
  centered?: boolean;
}

const { size = 'md', text = 'Loading...', centered = false } = Astro.props;

const sizeClass = size === 'sm' ? 'loading-spinner-sm' : size === 'lg' ? 'loading-spinner-lg' : '';
---

<div class:list={['loading-wrapper', { centered }]}>
  <div class={`loading-spinner ${sizeClass}`} role="status" aria-live="polite">
    <span class="sr-only">{text}</span>
  </div>
  {text && <p class="loading-text">{text}</p>}
</div>

<style>
  .loading-wrapper {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .loading-wrapper.centered {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: var(--space-8) 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>
