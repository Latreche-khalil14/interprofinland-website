---
/**
 * PageLoader Component
 * Luxury entrance splash preloader with logo sway animation, gold progress indicator, and smooth exit
 */
---

<div id="page-loader" class="page-loader" aria-hidden="true">
  <div class="loader-backdrop"></div>
  <div class="loader-content">
    <div class="logo-wrapper">
      <img
        src="/images/logo.jpg"
        alt="InterProFinland"
        class="loader-logo"
        width="280"
        height="78"
        loading="eager"
        decoding="sync"
      />
      <div class="logo-shine" aria-hidden="true"></div>
    </div>

    <div class="loader-progress-track" aria-hidden="true">
      <div class="loader-progress-bar"></div>
    </div>

    <p class="loader-tagline">Connecting Global Talent in Finland</p>
  </div>
</div>

<script>
  function hideLoader() {
    const loader = document.getElementById('page-loader');
    if (!loader || loader.classList.contains('is-hidden')) return;

    loader.classList.add('is-loaded');
    setTimeout(() => {
      loader.classList.add('is-hidden');
      document.body.classList.add('is-page-ready');
    }, 600);
  }

  // Ensure loader runs smoothly on page load
  if (document.readyState === 'complete') {
    setTimeout(hideLoader, 700);
  } else {
    window.addEventListener('load', () => {
      setTimeout(hideLoader, 600);
    });
  }

  // Fallback safety timeout so user is never stuck
  setTimeout(hideLoader, 1800);
</script>

<style>
  .page-loader {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100vw;
    height: 100vh;
    z-index: var(--z-modal, 1000);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    pointer-events: all;
    opacity: 1;
    visibility: visible;
    transition:
      opacity 500ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 600ms ease;
  }

  .page-loader.is-loaded {
    opacity: 0;
    transform: scale(1.02);
    pointer-events: none;
    visibility: hidden;
  }

  .page-loader.is-hidden {
    display: none !important;
  }

  .loader-backdrop {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at center,
      rgba(238, 242, 255, 0.65) 0%,
      rgba(255, 255, 255, 1) 75%
    );
    pointer-events: none;
  }

  .loader-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-5);
    padding: var(--space-8);
  }

  .logo-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    animation: loaderLogoSway 1.6s ease-in-out infinite alternate;
  }

  .loader-logo {
    height: 72px;
    width: auto;
    max-width: 300px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 8px 20px rgba(19, 31, 91, 0.14));
    animation: loaderLogoEntrance 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* Shimmer beam across the logo */
  .logo-shine {
    position: absolute;
    top: 0;
    left: -120%;
    width: 80%;
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 210, 111, 0.4) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-20deg);
    animation: loaderShimmer 1.4s ease-in-out infinite;
  }

  /* Progress bar track */
  .loader-progress-track {
    width: 180px;
    height: 4px;
    background-color: rgba(19, 31, 91, 0.08);
    border-radius: 9999px;
    overflow: hidden;
    position: relative;
    margin-top: var(--space-2);
  }

  .loader-progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: linear-gradient(90deg, #ffd26f 0%, #131f5b 100%);
    border-radius: 9999px;
    transform-origin: left center;
    animation: loaderProgress 1.1s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  .loader-tagline {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary-500);
    margin: 0;
    opacity: 0.9;
    animation: loaderFadeIn 0.8s ease forwards 0.2s;
  }

  /* Keyframe Animations */
  @keyframes loaderLogoEntrance {
    0% {
      opacity: 0;
      transform: translateY(12px) scale(0.92);
      filter: blur(4px);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: drop-shadow(0 6px 16px rgba(19, 31, 91, 0.12));
    }
  }

  @keyframes loaderLogoSway {
    0% {
      transform: translateX(-4px) rotate(-0.5deg);
    }
    100% {
      transform: translateX(4px) rotate(0.5deg);
    }
  }

  @keyframes loaderShimmer {
    0% {
      left: -120%;
    }
    100% {
      left: 140%;
    }
  }

  @keyframes loaderProgress {
    0% {
      transform: translateX(-100%) scaleX(0.2);
    }
    50% {
      transform: translateX(0%) scaleX(0.8);
    }
    100% {
      transform: translateX(100%) scaleX(0.2);
    }
  }

  @keyframes loaderFadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 0.85;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader {
      display: none !important;
    }
  }
</style>
