---
/**
 * Google Analytics Component  
 * Add your GA4 Measurement ID in .env as PUBLIC_GA_MEASUREMENT_ID
 */

const measurementId = import.meta.env['PUBLIC_GA_MEASUREMENT_ID'] as string | undefined;
const isDev = import.meta.env.DEV;
---

{!isDev && measurementId && (
  <Fragment>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}></script>
    <script is:inline>
      {`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '${measurementId}');
      `}
    </script>
  </Fragment>
)}
