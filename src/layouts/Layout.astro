---
/**
 * Base Layout Component
 * Wraps every page with Header, Footer, SEO meta, and global styles
 */

import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import PageLoader from '@/components/ui/PageLoader.astro';
import BackToTop from '@/components/ui/BackToTop.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'InterProFinland',
  description = 'Supporting international professionals in Finland with career guidance, mentorship, and qualification recognition.',
  image = '/images/og-image.jpg',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://www.interprofinland.fi');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL.origin)} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, canonicalURL.origin)} />

    <!-- Google Fonts for Inter and Lora -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics -->
    <!-- Uncomment and add GA4 ID when ready -->
    <!--<GoogleAnalytics />-->
    
    <!-- Structured Data -->
    <StructuredData />
  </head>

  <body>
    <!-- Initial Splash Page Loader -->
    <PageLoader />

    <!-- Skip to main content (accessibility) -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <!-- Back to Top Floating Button -->
    <BackToTop />
  </body>
</html>
