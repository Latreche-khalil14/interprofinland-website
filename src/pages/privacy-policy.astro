---
/**
 * Privacy Policy — InterProFinland
 */
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Layout
  title="Privacy Policy — InterProFinland"
  description="Learn how International Professionals Finland ry collects, uses, and protects your personal data."
>

  <!-- Subnav -->
  <div class="policy-subnav">
    <Container size="page">
      <nav class="subnav-breadcrumbs" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Privacy Policy</span>
      </nav>
    </Container>
  </div>

  <!-- Header -->
  <Section background="default">
    <Container size="narrow">
      <div class="policy-header">
        <h1 class="policy-title">Privacy Policy</h1>
        <p class="policy-intro">
          At International Professionals Finland ry (InterProFinland), we are committed to protecting your privacy and ensuring the security of your personal data. This Privacy Policy explains how we collect, use, and safeguard your information.
        </p>
        <p class="policy-date"><strong>Last updated:</strong> January 2025</p>
      </div>
    </Container>
  </Section>

  <!-- Content -->
  <Section background="surface">
    <Container size="narrow">
      <div class="policy-content">

        <section class="policy-section">
          <h2>1. Who We Are</h2>
          <p>
            <strong>Organization:</strong> International Professionals Finland ry<br>
            <strong>Business ID:</strong> [To be added]<br>
            <strong>Address:</strong> Otavankatu 5 A, 28100 Pori, Finland<br>
            <strong>Email:</strong> <a href="mailto:info@interprofinland.fi">info@interprofinland.fi</a>
          </p>
          <p>
            We are a registered non-profit organization in Finland dedicated to supporting international professionals in their career integration and professional development.
          </p>
        </section>

        <section class="policy-section">
          <h2>2. What Personal Data We Collect</h2>
          <p>We may collect and process the following types of personal data:</p>
          
          <h3>2.1 Information You Provide Directly</h3>
          <ul>
            <li><strong>Contact Information:</strong> Name, email address, phone number</li>
            <li><strong>Professional Information:</strong> Education background, professional qualifications, work experience, field of expertise</li>
            <li><strong>Membership Information:</strong> Membership status, program participation</li>
            <li><strong>Communication Data:</strong> Your messages, inquiries, and correspondence with us</li>
            <li><strong>Event Participation:</strong> Registration details for workshops, seminars, and networking events</li>
          </ul>

          <h3>2.2 Information Collected Automatically</h3>
          <ul>
            <li><strong>Website Usage Data:</strong> IP address, browser type, pages visited, time spent on pages</li>
            <li><strong>Cookies:</strong> See our <a href="/cookie-policy">Cookie Policy</a> for details</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>3. How We Use Your Personal Data</h2>
          <p>We use your personal data for the following purposes:</p>
          <ul>
            <li><strong>Service Delivery:</strong> To provide our programs, services, and support (Degree Amplify, One Mentor One, SATAtalents, etc.)</li>
            <li><strong>Communication:</strong> To respond to your inquiries, send program updates, and share relevant information</li>
            <li><strong>Event Management:</strong> To organize and manage workshops, seminars, and networking events</li>
            <li><strong>Membership Administration:</strong> To manage memberships and program participation</li>
            <li><strong>Improvement:</strong> To improve our services, website, and user experience</li>
            <li><strong>Legal Compliance:</strong> To comply with legal obligations and protect our rights</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>4. Legal Basis for Processing</h2>
          <p>We process your personal data based on the following legal grounds under GDPR:</p>
          <ul>
            <li><strong>Consent:</strong> When you have given explicit consent (e.g., newsletter subscription, event registration)</li>
            <li><strong>Contractual Necessity:</strong> To fulfill our obligations related to membership or service delivery</li>
            <li><strong>Legitimate Interest:</strong> To improve our services and communicate relevant information to our community</li>
            <li><strong>Legal Obligation:</strong> To comply with Finnish and EU legal requirements</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>5. How We Share Your Data</h2>
          <p>We do not sell, rent, or trade your personal data. We may share your information only in the following circumstances:</p>
          <ul>
            <li><strong>Service Providers:</strong> Trusted third-party service providers who assist us (e.g., email services, event platforms) under strict confidentiality agreements</li>
            <li><strong>Partners:</strong> Program partners and collaborators when necessary for service delivery (with your consent)</li>
            <li><strong>Legal Requirements:</strong> When required by law, regulation, or legal process</li>
            <li><strong>Protection of Rights:</strong> To protect our rights, property, or safety, or that of our members</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>6. International Data Transfers</h2>
          <p>
            Your data is primarily stored and processed within the European Economic Area (EEA). If we transfer data outside the EEA, we ensure appropriate safeguards are in place, such as:
          </p>
          <ul>
            <li>EU Standard Contractual Clauses</li>
            <li>Adequacy decisions by the European Commission</li>
            <li>Other legally approved transfer mechanisms</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>7. Data Retention</h2>
          <p>We retain your personal data only as long as necessary for the purposes outlined in this policy:</p>
          <ul>
            <li><strong>Active Members:</strong> During membership and for up to 2 years after membership ends</li>
            <li><strong>Contact Form Inquiries:</strong> Up to 1 year after the last interaction</li>
            <li><strong>Event Participants:</strong> Up to 2 years for follow-up and community engagement</li>
            <li><strong>Legal Requirements:</strong> As required by Finnish law (e.g., accounting records)</li>
          </ul>
          <p>After the retention period, we securely delete or anonymize your data.</p>
        </section>

        <section class="policy-section">
          <h2>8. Your Rights Under GDPR</h2>
          <p>As a data subject under GDPR, you have the following rights:</p>
          <ul>
            <li><strong>Right to Access:</strong> Request a copy of your personal data</li>
            <li><strong>Right to Rectification:</strong> Request correction of inaccurate or incomplete data</li>
            <li><strong>Right to Erasure:</strong> Request deletion of your data ("right to be forgotten")</li>
            <li><strong>Right to Restrict Processing:</strong> Request limitation of how we use your data</li>
            <li><strong>Right to Data Portability:</strong> Receive your data in a structured, machine-readable format</li>
            <li><strong>Right to Object:</strong> Object to processing based on legitimate interests</li>
            <li><strong>Right to Withdraw Consent:</strong> Withdraw consent at any time (without affecting prior processing)</li>
            <li><strong>Right to Lodge a Complaint:</strong> File a complaint with the Finnish Data Protection Ombudsman</li>
          </ul>
          <p>
            To exercise your rights, contact us at <a href="mailto:info@interprofinland.fi">info@interprofinland.fi</a>. We will respond within 30 days.
          </p>
        </section>

        <section class="policy-section">
          <h2>9. Data Security</h2>
          <p>We implement appropriate technical and organizational measures to protect your data:</p>
          <ul>
            <li>Encryption of data in transit (HTTPS/SSL)</li>
            <li>Access controls and authentication</li>
            <li>Regular security assessments</li>
            <li>Staff training on data protection</li>
            <li>Secure data storage and backup procedures</li>
          </ul>
          <p>
            While we take reasonable precautions, no method of transmission over the internet is 100% secure. We cannot guarantee absolute security.
          </p>
        </section>

        <section class="policy-section">
          <h2>10. Children's Privacy</h2>
          <p>
            Our services are not directed to individuals under 16 years of age. We do not knowingly collect personal data from children. If we become aware that we have collected data from a child without parental consent, we will delete it promptly.
          </p>
        </section>

        <section class="policy-section">
          <h2>11. Changes to This Policy</h2>
          <p>
            We may update this Privacy Policy from time to time to reflect changes in our practices or legal requirements. We will notify you of significant changes by:
          </p>
          <ul>
            <li>Posting the updated policy on our website with a new "Last updated" date</li>
            <li>Sending an email notification to registered members (for material changes)</li>
          </ul>
          <p>We encourage you to review this policy periodically.</p>
        </section>

        <section class="policy-section">
          <h2>12. Contact Us</h2>
          <p>If you have questions, concerns, or requests regarding this Privacy Policy or our data practices, please contact us:</p>
          <p>
            <strong>Email:</strong> <a href="mailto:info@interprofinland.fi">info@interprofinland.fi</a><br>
            <strong>Address:</strong> Otavankatu 5 A, 28100 Pori, Finland<br>
            <strong>Phone:</strong> [To be added]
          </p>
          <p>
            <strong>Data Protection Authority:</strong><br>
            Finnish Data Protection Ombudsman<br>
            Website: <a href="https://tietosuoja.fi/en/" target="_blank" rel="noopener">tietosuoja.fi/en/</a>
          </p>
        </section>

      </div>

      <div class="policy-footer">
        <p>By using our services, you acknowledge that you have read and understood this Privacy Policy.</p>
      </div>

    </Container>
  </Section>

</Layout>

<style>
  /* Subnav */
  .policy-subnav {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 12px 0;
  }

  .subnav-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .crumb-link {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    transition: color 140ms ease;
  }

  .crumb-link:hover { color: #131F5B; }

  .crumb-sep { color: #cbd5e1; font-size: 0.75rem; }

  .crumb-current {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #131F5B;
  }

  /* Header */
  .policy-header {
    text-align: center;
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2rem);
  }

  .policy-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 var(--space-4);
    letter-spacing: -0.02em;
  }

  .policy-intro {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: #475569;
    line-height: 1.65;
    margin: 0 auto var(--space-3);
    max-width: 65ch;
  }

  .policy-date {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: #64748b;
    margin: 0;
  }

  /* Content */
  .policy-content {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: clamp(2rem, 5vw, 3rem);
  }

  .policy-section {
    margin-bottom: clamp(2rem, 4vw, 2.5rem);
  }

  .policy-section:last-child {
    margin-bottom: 0;
  }

  .policy-section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.01em;
  }

  .policy-section h3 {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    font-weight: 700;
    color: #1e293b;
    margin: var(--space-4) 0 var(--space-2);
  }

  .policy-section p {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.8vw, 1rem);
    color: #475569;
    line-height: 1.7;
    margin: 0 0 var(--space-3);
  }

  .policy-section p:last-child {
    margin-bottom: 0;
  }

  .policy-section ul {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.8vw, 1rem);
    color: #475569;
    line-height: 1.7;
    margin: 0 0 var(--space-3);
    padding-left: 1.5rem;
  }

  .policy-section li {
    margin-bottom: 0.5rem;
  }

  .policy-section li:last-child {
    margin-bottom: 0;
  }

  .policy-section a {
    color: #131F5B;
    text-decoration: underline;
    transition: color 150ms ease;
  }

  .policy-section a:hover {
    color: #1E3A8A;
  }

  /* Footer */
  .policy-footer {
    text-align: center;
    padding: var(--space-5) 0 0;
  }

  .policy-footer p {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: #64748b;
    font-style: italic;
    margin: 0;
  }
</style>
