---
/**
 * Privacy Policy — InterProFinland
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Layout
  title="Privacy Policy — InterProFinland"
  description="How InterProFinland collects, uses, and protects your personal information."
>
  <Section>
    <Container size="content">
      <div style="text-align: center; max-width: 800px; margin: 0 auto; padding: 4rem 2rem;">
      <h1>Privacy Policy</h1>
      
      <h2 style="margin-top: 2rem;">📋 Page Sections</h2>
      <p style="text-align: left; line-height: 2;">
        • Privacy Policy<br>
        • Data processing<br>
        • Contact details<br>
        • Relevant legal information
      </p>

      <p style="background: #fff3cd; padding: 1rem; border-radius: 8px; margin: 2rem 0;">
        <strong>⚠️ Note:</strong> Simple legal page — no excessive design.
      </p>

      <p style="margin-top: 2rem;"><em>Page under construction</em></p>
      </div>
    </Container>
  </Section>
</Layout>
