---
/**
 * Foreign Qualification & Degree Recognition — InterProFinland
 * Comprehensive guidance on OPH, Valvira, and Finnish credential equivalency.
 * Luxury editorial design matching Home and About design systems.
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import CtaSection from '@/components/sections/CtaSection.astro';

/* ── Competent Authorities Directory in Finland ── */
const authorities = [
  {
    code: 'OPH',
    category: 'Higher Education & Teaching',
    name: 'Finnish National Agency for Education (Opetushallitus)',
    scope: 'Evaluates foreign higher education qualifications for equivalence with Finnish university degrees (Bachelor, Master, Doctorate). Grants eligibility decisions for public sector posts, teachers, subject instructors, and early childhood educators.',
    link: 'https://www.oph.fi/en/services/recognition-and-international-comparability-qualifications',
  },
  {
    code: 'Valvira',
    category: 'Healthcare & Social Welfare',
    name: 'National Supervisory Authority for Welfare and Health',
    scope: 'Grants official practice rights, professional registrations, and title protection for regulated healthcare and social welfare practitioners (doctors, nurses, dentists, pharmacists, psychologists, social workers).',
    link: 'https://valvira.fi/en/rights-to-practise',
  },
  {
    code: 'Ruokavirasto',
    category: 'Veterinary & Food Safety',
    name: 'Finnish Food Authority',
    scope: 'Approves qualifications and issues official practice licenses for veterinarians, animal health practitioners, and food safety inspectors qualifying outside the EU/EEA.',
    link: 'https://www.ruokavirasto.fi/en/',
  },
  {
    code: 'Traficom',
    category: 'Transport & Maritime',
    name: 'Finnish Transport and Communications Agency',
    scope: 'Validates professional qualifications, maritime captain licenses, aviation pilot credentials, and specialized transport engineering endorsements.',
    link: 'https://www.traficom.fi/en/',
  },
];

/* ── 4-Stage Recognition Roadmap ── */
const roadmapStages = [
  {
    stage: '01',
    title: 'Determine Authority & Pathway',
    description:
      'We help you identify whether your profession is regulated or non-regulated in Finland, determining whether you need an academic comparability statement (OPH) or formal licensure from a specific agency (Valvira).',
    finnishTerm: 'Toimivaltainen viranomainen',
  },
  {
    stage: '02',
    title: 'Assemble Dossier & Sworn Translations',
    description:
      'Compiling your degree certificate, Diploma Supplement, and complete transcripts. Arranging certified translations prepared by an authorized translator when documents are in non-official languages.',
    finnishTerm: 'Auktorisoitu kääntäjä',
  },
  {
    stage: '03',
    title: 'Submit Application & Track Progress',
    description:
      'Submitting your formal dossier to the relevant authority, monitoring progress, managing verification requests, and preparing any supplementary clarifications if requested.',
    finnishTerm: 'Hakemuksen käsittely',
  },
  {
    stage: '04',
    title: 'Adaptation Period or Full Practice Rights',
    description:
      'For regulated professions requiring conditional decisions, navigating required aptitude tests, supervised adaptation periods, or supplementary university modules to achieve full licensure.',
    finnishTerm: 'Kelpoisuuskoe / Sopeutumisaika',
  },
];

/* ── Essential Document Requirements ── */
const documentRequirements = [
  {
    title: 'Official Degree Certificate & Diploma',
    detail: 'Original certificate in the native language plus certified English, Finnish, or Swedish translation.',
  },
  {
    title: 'Official Academic Transcript (Diploma Supplement)',
    detail: 'Comprehensive record of completed courses, study hours, credits (ECTS equivalent), and grading scale description.',
  },
  {
    title: 'Professional License / Certificate of Good Standing',
    detail: 'Required for regulated healthcare and legal professions to confirm active, unencumbered practice rights in your home country.',
  },
  {
    title: 'Valid Passport or Official Identity Document',
    detail: 'Official identification verifying personal identity, nationality, and right of residence in Finland.',
  },
];

/* ── Specific Recognition FAQs ── */
const recognitionFaqs = [
  {
    q: 'How long does the OPH degree comparability process typically take?',
    a: 'Processing times for OPH comparability decisions typically range from 2 to 4 months once all required certified documents have been received by the agency.',
  },
  {
    q: 'Do I need a decision if my profession is non-regulated (e.g. IT or Business)?',
    a: 'For private sector non-regulated roles, employers can hire based on skills without a state decision. However, an OPH statement officially confirms your academic level (e.g., Master’s level) and provides credibility.',
  },
  {
    q: 'What is the difference between an academic statement and professional recognition?',
    a: 'An academic statement compares degree level (e.g., your Bachelor equals a Finnish Kandidaatti). Professional recognition grants the legal right to practice a specific regulated profession in Finland.',
  },
  {
    q: 'How does InterProFinland assist with Valvira or OPH paperwork?',
    a: 'We review your documents for completeness, help clarify authority instructions, advise on certified translation requirements, and connect you with peers who completed the same process. Note that official decisions are issued solely by competent Finnish authorities.',
  },
];
---

<Layout
  title="Foreign Qualification & Degree Recognition — InterProFinland"
  description="Step-by-step guidance on validating foreign degrees, navigating OPH and Valvira regulations, and achieving professional practice rights in Finland."
>
  <!-- SUBNAV -->
  <div class="community-subnav">
    <Container size="page">
      <div class="subnav-inner">
        <nav class="subnav-breadcrumbs" aria-label="Breadcrumb">
          <a href="/" class="crumb-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Home
          </a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <a href="/services" class="crumb-link">Services</a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span class="crumb-current" aria-current="page">Qualification Recognition</span>
        </nav>
        <span class="subnav-tagline">Validate your foreign credentials in Finland</span>
      </div>
    </Container>
  </div>

  <!-- HERO SECTION -->
  <Section background="surface">
    <Container size="page">
      <div class="service-hero-layout">
        <div class="service-hero-content">

          <h1 class="service-hero-title">
            Foreign Qualification &amp; Degree <span class="service-hero-serif">Recognition in Finland</span>
          </h1>

          <p class="service-hero-lead">
            Navigating Finnish regulatory authorities can be complex. We provide step-by-step guidance
            to help you understand qualification requirements, compile authentic application dossiers, and navigate
            comparability or licensing pathways.
          </p>

          <!-- Key Areas - Desktop -->
          <div class="hero-areas-list" aria-label="Key Recognition Focus Areas">
            <span class="area-item">OPH Comparability Decisions</span>
            <span class="area-divider">•</span>
            <span class="area-item">Valvira Healthcare Licensing</span>
            <span class="area-divider">•</span>
            <span class="area-item">Sworn Translation Guidance</span>
            <span class="area-divider">•</span>
            <span class="area-item">Regulated Profession Rights</span>
          </div>

          <!-- Mobile Image with Overlay Chips -->
          <div class="hero-image-mobile">
            <div class="service-hero-frame">
              <img
                src="/images/services/Qualification-Recognition/recognition-hero.jpg"
                alt="Professional reviewing international degree certificates and academic credentials for Finnish recognition process"
                class="service-hero-img"
                width="800"
                height="450"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="hero-areas-list-overlay">
              <span class="area-item">OPH Comparability</span>
              <span class="area-item">Valvira Licensing</span>
              <span class="area-item">Sworn Translations</span>
              <span class="area-item">Profession Rights</span>
            </div>
          </div>

          <div class="service-hero-actions">
            <a
              href="https://form.jotform.com/InterProFinland/membership-application-form"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary-action"
            >
              <span>Request Recognition Guidance</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="#roadmap" class="btn-secondary-action">
              <span>Explore 4-Stage Roadmap</span>
            </a>
          </div>
        </div>

        <div class="service-hero-media hero-image-desktop">
          <div class="service-hero-frame">
            <img
              src="/images/services/Qualification-Recognition/recognition-hero.jpg"
              alt="Professional reviewing international degree certificates and academic credentials for Finnish recognition process"
              class="service-hero-img"
              width="800"
              height="450"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       AUTHORITIES DIRECTORY — Elegant List Layout
       ========================================================================== -->
  <Section>
    <div id="authorities-directory"></div>
    <Container size="page">
      <div class="auth-section-layout">

        <!-- Left: Header -->
        <div class="auth-section-header">
          <span class="section-eyebrow">Regulatory Authorities</span>
          <h2 class="auth-section-title">Who Evaluates Your Credentials in Finland?</h2>
          <p class="auth-section-lead">
            Different competent authorities handle specific fields. Each body has a defined
            scope — knowing which one governs your profession is the first step.
          </p>
        </div>

        <!-- Right: Authority List -->
        <div class="auth-list">
          {
            authorities.map((auth) => (
              <div class="auth-row">
                <div class="auth-row-left">
                  <span class="auth-badge">{auth.code}</span>
                </div>
                <div class="auth-row-body">
                  <div class="auth-row-meta">
                    <span class="auth-field">{auth.category}</span>
                  </div>
                  <h3 class="auth-row-name">{auth.name}</h3>
                  <p class="auth-row-scope">{auth.scope}</p>
                </div>
                <div class="auth-row-action">
                  <a href={auth.link} target="_blank" rel="noopener noreferrer" class="auth-portal-link">
                    <span>Portal</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            ))
          }
        </div>

      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       ROADMAP — Vertical Timeline
       ========================================================================== -->
  <Section background="surface">
    <div id="roadmap"></div>
    <Container size="page">
      <div class="roadmap-section-layout">

        <!-- Header -->
        <div class="roadmap-section-header">
          <span class="section-eyebrow">Step-by-Step Roadmap</span>
          <h2 class="roadmap-section-title">The 4 Stages of the Recognition Journey</h2>
          <p class="roadmap-section-lead">
            A structured sequence ensures all documentation meets Finnish legal standards
            before formal submission.
          </p>
        </div>

        <!-- Timeline -->
        <div class="timeline">
          {
            roadmapStages.map((st, i) => (
              <div class="timeline-item">
                <div class="timeline-marker">
                  <span class="timeline-number">{st.stage}</span>
                  {i < roadmapStages.length - 1 && <span class="timeline-line" aria-hidden="true" />}
                </div>
                <div class="timeline-body">
                  <h3 class="timeline-title">{st.title}</h3>
                  <p class="timeline-desc">{st.description}</p>
                  <span class="timeline-term">{st.finnishTerm}</span>
                </div>
              </div>
            ))
          }
        </div>

      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       SPLIT EDITORIAL: Document Preparation & Translations (4:3 Media Frame)
       ========================================================================== -->
  <Section>
    <Container size="page">
      <div class="editorial-split-layout">
        <div class="split-content-side">
          <span class="section-eyebrow">Document Checklist</span>
          <h2 class="split-heading">Required Documents &amp; Translation Standards</h2>
          <p class="split-lead">
            Finnish authorities maintain strict standards for document authentication. Having certified
            translations and complete transcripts ready is vital.
          </p>

          <div class="document-disclaimer-note">
            <span class="disclaimer-icon" aria-hidden="true">ℹ</span>
            <p class="disclaimer-text">
              <strong>Important:</strong> Document requirements vary depending on your specific profession,
              country of qualification, and the competent evaluating authority.
            </p>
          </div>

          <div class="requirements-list">
            {
              documentRequirements.map((doc) => (
                <div class="requirement-item">
                  <div class="req-check" aria-hidden="true">✓</div>
                  <div class="req-info">
                    <h4 class="req-title">{doc.title}</h4>
                    <p class="req-detail">{doc.detail}</p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div class="split-visual-side">
          <div class="split-image-frame">
            <img
              src="/images/services/Qualification-Recognition/1.jfif"
              alt="International degree documents, diplomas, and certified translations required for Finnish qualification recognition"
              class="split-img"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       HANDBOOK SPOTLIGHT: Qualifications Recognition in Finland Handbook
       ========================================================================== -->
  <Section background="surface">
    <Container size="page">
      <div class="handbook-spotlight-card">
        <div class="handbook-content">
          <div class="handbook-badge-row">
            <span class="handbook-pill">Official Member Resource</span>
            <span class="handbook-free-tag">Available Free to Members</span>
          </div>

          <h2 class="handbook-title">Qualifications Recognition in Finland Handbook</h2>
          <p class="handbook-subtitle">
            Your Essential Guide to Navigating Credential Equivalency, Regulated Professions, and Application Steps
          </p>

          <p class="handbook-desc">
            Finland’s qualification recognition process can be intricate, but you don't have to navigate it alone.
            Our comprehensive handbook provides clear, step-by-step instructions designed to fast-track your career.
          </p>

          <div class="handbook-highlights-grid">
            <div class="handbook-item">
              <span class="handbook-check" aria-hidden="true">✓</span>
              <div>
                <strong>System Overview &amp; Authorities:</strong> Clear breakdown of OPH, Valvira, Ruokavirasto, and Traficom procedures.
              </div>
            </div>
            <div class="handbook-item">
              <span class="handbook-check" aria-hidden="true">✓</span>
              <div>
                <strong>Sector-Specific Focus:</strong> In-depth guidance for Healthcare, Social Welfare, Teaching, and Early Childhood Education.
              </div>
            </div>
            <div class="handbook-item">
              <span class="handbook-check" aria-hidden="true">✓</span>
              <div>
                <strong>Application Success Tips:</strong> How to avoid common documentation mistakes, handle translations, and prepare for aptitude tests.
              </div>
            </div>
          </div>

          <div class="handbook-actions">
            <a
              href="https://form.jotform.com/InterProFinland/membership-application-form"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-handbook-primary"
            >
              <span>Get the Handbook via Membership</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="handbook-visual">
          <div class="handbook-media-frame">
            <img
              src="/images/home/handbook-cover.webp"
              alt="Qualifications Recognition in Finland Handbook cover"
              class="handbook-cover-img"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       SPECIFIC RECOGNITION FAQS
       ========================================================================== -->
  <Section>
    <Container size="page">
      <div class="section-header-center">
        <span class="section-eyebrow">Recognition FAQs</span>
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <p class="section-intro">
          Direct answers to common questions on foreign degree evaluation in Finland.
        </p>
      </div>

      <div class="faqs-grid">
        {
          recognitionFaqs.map((faq) => (
            <details class="faq-accordion-item">
              <summary class="faq-accordion-trigger">
                <span class="faq-q-text">{faq.q}</span>
                <span class="faq-accordion-icon" aria-hidden="true">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="faq-accordion-body">
                <p class="faq-a-text">{faq.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       BOTTOM CTA
       ========================================================================== -->
  <CtaSection
    heading="Need Guidance on Your Foreign Degree in Finland?"
    subheading="Book a consultation with our advisory team to review your qualifications, identify competent authorities, and map out your official recognition pathway."
    background="surface"
    cta={{
      label: 'Request Recognition Guidance',
      href: 'https://form.jotform.com/InterProFinland/membership-application-form',
      target: '_blank',
    }}
    secondaryCta={{
      label: 'Explore All Services',
      href: '/services',
    }}
  />
</Layout>

<style>
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary-500);
    margin-bottom: var(--space-3);
    line-height: 1;
  }

  .section-eyebrow::before,
  .section-eyebrow::after {
    content: '';
    display: block;
    width: 28px;
    height: 2.5px;
    background-color: #ffd26f;
    flex-shrink: 0;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3);
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-align: center;
    text-wrap: balance;
  }

  .section-intro {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 65ch;
    margin: 0 auto var(--space-6);
    line-height: var(--line-height-relaxed);
    text-align: center;
  }

  .section-header-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* ── Hero Section (16:9 Frame) ── */
  .service-hero-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(0.5rem, 1.5vw, 1.5rem) 0 clamp(2rem, 3vw, 3rem);
  }

  .service-hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .service-hero-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  .breadcrumb-back {
    color: var(--color-primary-600, #1E3A8A);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .breadcrumb-back:hover {
    color: #131F5B;
    text-decoration: underline;
  }

  .breadcrumb-separator {
    color: var(--color-gray-400);
  }

  .breadcrumb-current {
    color: var(--color-gray-600);
  }

  .service-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.85rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1.18;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .service-hero-serif {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: var(--font-weight-regular);
    color: var(--color-primary-600, #1E3A8A);
  }

  .service-hero-lead {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: var(--line-height-relaxed);
    color: var(--color-gray-800);
    margin: 0;
  }

  /* Key Areas List — Clean & Simple */
  .hero-areas-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-gray-600);
  }

  .area-item {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .area-divider {
    color: var(--color-gray-400);
    font-weight: 300;
  }

  .service-hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero-chip {
    font-family: var(--font-display);
    font-size: 0.78125rem;
    font-weight: 600;
    color: #131F5B;
    background-color: #ffffff;
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    padding: 4px 10px;
    border-radius: var(--radius-sm, 6px);
  }

  .service-hero-actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .btn-primary-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-gold, #FFD26F);
    color: #131F5B;
    border: 2px solid var(--color-gold, #FFD26F);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px var(--color-gold-shadow, rgba(255, 210, 111, 0.35));
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 150ms ease;
  }

  .btn-primary-action:hover {
    background-color: var(--color-primary-600, #1E3A8A);
    border-color: var(--color-primary-600, #1E3A8A);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: #131F5B;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border: 2px solid #131F5B;
    background-color: transparent;
    border-radius: var(--radius-sm);
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 150ms ease;
  }

  .btn-secondary-action:hover {
    background-color: #131F5B;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .service-hero-frame {
    position: relative;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    box-shadow: 0 12px 32px -8px rgba(19, 31, 91, 0.12),
                0 0 0 1px rgba(19, 31, 91, 0.08);
    background-color: #f8fafc;
  }

  .service-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 500ms ease;
  }

  .service-hero-frame:hover .service-hero-img {
    transform: scale(1.03);
  }

  /* ══════════════════════════════════════════════
     AUTHORITIES — Elegant Side-by-Side List
  ══════════════════════════════════════════════ */

  .auth-section-layout {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  .auth-section-header {
    position: sticky;
    top: 2rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .auth-section-header .section-eyebrow {
    margin-bottom: 1.25rem;
  }

  .auth-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.25;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .auth-section-lead {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-gray-500);
    margin: 1.25rem 0 0;
  }

  /* List of authorities */
  .auth-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .auth-row {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    gap: var(--space-4);
    align-items: start;
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border-subtle, #e2e8f0);
    transition: background-color 200ms ease;
  }

  .auth-row:first-child {
    border-top: 1px solid var(--color-border-subtle, #e2e8f0);
  }

  .auth-row-left {
    padding-top: 4px;
  }

  .auth-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.75rem;
    color: var(--color-text-primary);
    background-color: #f1f5f9;
    border: 1.5px solid #cbd5e1;
    padding: 5px 8px;
    border-radius: 6px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .auth-row-body {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .auth-row-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: 12px;
  }

  .auth-field {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gray-400, #94a3b8);
  }

  .auth-row-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 14px;
    line-height: 1.35;
  }

  .auth-row-scope {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-gray-500, #64748b);
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--color-border-subtle, #f1f5f9);
  }

  .auth-row-action {
    padding-top: 3px;
    flex-shrink: 0;
  }

  .auth-portal-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-gray-600, #475569);
    text-decoration: none;
    padding: 5px 10px;
    border: 1.5px solid #e2e8f0;
    border-radius: 6px;
    transition: border-color 200ms ease, background-color 200ms ease, color 200ms ease;
    white-space: nowrap;
  }

  .auth-portal-link:hover {
    background-color: var(--color-text-primary, #0f172a);
    border-color: var(--color-text-primary, #0f172a);
    color: #ffffff;
  }

  /* ══════════════════════════════════════════════
     ROADMAP — Vertical Timeline
  ══════════════════════════════════════════════ */

  .roadmap-section-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .roadmap-section-header {
    text-align: center;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .roadmap-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.8vw, 2.25rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .roadmap-section-lead {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-gray-600);
    margin: 0;
  }

  /* Timeline */
  .timeline {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    width: 100%;
    max-width: 1100px;
    position: relative;
  }

  /* Shared top line connecting all circles */
  .timeline::before {
    content: '';
    position: absolute;
    top: 26px;
    left: calc(12.5% + 26px);
    right: calc(12.5% + 26px);
    height: 1px;
    background: #e2e8f0;
    z-index: 0;
  }

  .timeline-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding: 0 var(--space-3);
    position: relative;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    position: relative;
  }

  .timeline-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    background-color: #ffffff;
    color: var(--color-text-primary, #0f172a);
    border: 2px solid #cbd5e1;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1rem;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    letter-spacing: -0.01em;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  /* Remove old ::after connector */
  .timeline-item:not(:last-child)::after {
    display: none;
  }

  /* Horizontal connector line between items */
  .timeline-line {
    display: none;
  }

  .timeline-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-align: center;
    padding-top: var(--space-2);
    width: 100%;
  }

  .timeline-title {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .timeline-desc {
    font-family: var(--font-body);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-gray-500, #64748b);
    margin: 0;
  }

  .timeline-term {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-style: italic;
    color: var(--color-gray-400, #94a3b8);
    margin-top: 2px;
  }

  /* ══════════════════════════════════════════════
     RESPONSIVE — Authorities & Roadmap
  ══════════════════════════════════════════════ */

  @media (max-width: 1024px) {
    /* Authorities: stack vertically */
    .auth-section-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .auth-section-header {
      position: static;
      text-align: center;
      align-items: center;
    }

    .auth-section-header .section-eyebrow {
      margin-bottom: 1rem;
    }

    .auth-section-title {
      margin: 0;
    }

    .auth-section-lead {
      margin: 1rem 0 0;
      max-width: 56ch;
    }

    /* Roadmap: 2 columns on tablet */
    .timeline {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-10) 0;
    }

    .timeline::before {
      display: none;
    }

    .timeline-item:nth-child(1)::after,
    .timeline-item:nth-child(2)::after {
      display: none;
    }
  }

  @media (max-width: 640px) {
    /* Authorities: simplify row for small screens */
    .auth-row {
      grid-template-columns: 52px 1fr;
      grid-template-rows: auto auto;
    }

    .auth-row-action {
      grid-column: 2;
      padding-top: var(--space-2);
    }

    /* Roadmap: single column on mobile */
    .timeline {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .timeline::before {
      display: none;
    }

    .timeline-item {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-4);
      padding: var(--space-5) 0;
      border-bottom: 1px solid var(--color-border-subtle, #e2e8f0);
    }

    .timeline-item:first-child {
      border-top: 1px solid var(--color-border-subtle, #e2e8f0);
    }

    .timeline-item:not(:last-child)::after {
      display: none;
    }

    .timeline-marker {
      width: auto;
      flex-shrink: 0;
    }

    .timeline-number {
      width: 40px;
      height: 40px;
      font-size: 0.875rem;
    }

    .timeline-body {
      text-align: left;
      padding-top: 6px;
      gap: 4px;
    }

    .timeline-title {
      font-size: 0.875rem;
    }

    .timeline-desc {
      font-size: 0.8125rem;
    }

    .roadmap-section-header {
      text-align: center;
    }

    /* Authorities: simplify row for small screens */
    .auth-row {
      grid-template-columns: 52px 1fr;
      grid-template-rows: auto auto;
    }

    .auth-row-action {
      grid-column: 2;
      padding-top: var(--space-2);
    }

    .auth-badge {
      font-size: 0.6875rem;
      padding: 4px 7px;
    }

    .auth-row-name {
      font-size: 0.9375rem;
    }

    .auth-row-scope {
      font-size: 0.8125rem;
    }
  }

  /* ── Split Editorial: Document Checklist (4:3 Frame) ── */
  .editorial-split-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .split-content-side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .split-heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.22;
    margin: 0;
  }

  .split-lead {
    font-family: var(--font-body);
    font-size: 0.96875rem;
    line-height: 1.6;
    color: var(--color-gray-700);
    margin: 0 0 var(--space-2);
  }

  .document-disclaimer-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: var(--radius-md, 10px);
    padding: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .disclaimer-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: #1E3A8A;
    color: #ffffff;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .disclaimer-text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.55;
    color: #1e40af;
    margin: 0;
  }

  .requirements-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    width: 100%;
  }

  .requirement-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background-color: #f8fafc;
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-md, 10px);
    padding: var(--space-3) var(--space-4);
  }

  .req-check {
    color: var(--color-primary-600, #1E3A8A);
    font-weight: 800;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .req-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .req-title {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: #131F5B;
    margin: 0;
  }

  .req-detail {
    font-family: var(--font-body);
    font-size: 0.84375rem;
    line-height: 1.5;
    color: var(--color-gray-600);
    margin: 0;
  }

  .split-image-frame {
    position: relative;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: 0 10px 28px -6px rgba(19, 31, 91, 0.12),
                0 0 0 1px rgba(19, 31, 91, 0.08);
    background-color: #f8fafc;
  }

  .split-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 450ms ease;
  }

  .split-image-frame:hover .split-img {
    transform: scale(1.03);
  }

  /* ── FAQs Accordion ── */
  .faqs-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 860px;
    margin: 0 auto;
  }

  .faq-accordion-item {
    background: #ffffff;
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-lg, 14px);
    padding: var(--space-5) var(--space-6);
    transition: border-color 200ms ease, box-shadow 200ms ease, background-color 200ms ease;
  }

  .faq-accordion-item[open] {
    border-color: #93c5fd;
    box-shadow: 0 6px 20px -4px rgba(19, 31, 91, 0.08);
  }

  .faq-accordion-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-accordion-trigger::-webkit-details-marker {
    display: none;
  }

  .faq-q-text {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.35;
    margin: 0;
    transition: color 200ms ease;
  }

  .faq-accordion-item[open] .faq-q-text {
    color: var(--color-primary-600, #1E3A8A);
  }

  .faq-accordion-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm, 6px);
    background-color: #f1f5f9;
    color: #131F5B;
    flex-shrink: 0;
    transition: transform 250ms ease, background-color 200ms ease, color 200ms ease;
  }

  .faq-accordion-item[open] .faq-accordion-icon {
    transform: rotate(180deg);
    background-color: #131F5B;
    color: #FFD26F;
  }

  .faq-accordion-body {
    padding-top: var(--space-3);
    margin-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle, #f1f5f9);
  }

  .faq-a-text {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-gray-700);
    margin: 0;
  }

  /* ── Handbook Spotlight Card ── */
  .handbook-spotlight-card {
    background: linear-gradient(145deg, #131F5B 0%, #0a1133 100%);
    border: 1.5px solid rgba(255, 210, 111, 0.35);
    border-radius: var(--radius-xl, 24px);
    padding: clamp(2rem, 3.5vw, 3.25rem);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 3.5vw, 3.25rem);
    align-items: center;
    box-shadow: 0 20px 50px -10px rgba(19, 31, 91, 0.4);
  }

  .handbook-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .handbook-badge-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .handbook-pill {
    color: #FFD26F;
    font-family: var(--font-display);
    font-size: 0.78125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .handbook-free-tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #131F5B;
    background-color: #FFD26F;
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .handbook-title {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 2.5vw, 2.25rem);
    font-weight: var(--font-weight-bold);
    color: #ffffff;
    line-height: 1.18;
    margin: 0;
  }

  .handbook-subtitle {
    font-family: var(--font-display);
    font-size: 0.96875rem;
    font-weight: 600;
    color: #FFD26F;
    margin: 0;
    line-height: 1.35;
  }

  .handbook-desc {
    font-family: var(--font-body);
    font-size: 0.90625rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }

  .handbook-highlights-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md, 12px);
    padding: var(--space-4);
  }

  .handbook-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: #ffffff;
    font-size: 0.84375rem;
    line-height: 1.45;
  }

  .handbook-check {
    color: #FFD26F;
    font-weight: 800;
  }

  .handbook-actions {
    margin-top: var(--space-2);
  }

  .btn-handbook-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: #FFD26F;
    color: #131F5B;
    border: 2px solid #FFD26F;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px rgba(255, 210, 111, 0.35);
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 150ms ease;
  }

  .btn-handbook-primary:hover {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #131F5B;
    transform: translateY(-2px);
  }

  .handbook-media-frame {
    position: relative;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(255, 210, 111, 0.25);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
  }

  .handbook-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 500ms ease;
  }

  .handbook-media-frame:hover .handbook-cover-img {
    transform: scale(1.03);
  }

  /* ── Responsive Adaptations ── */
  /* Mobile Image with Overlay */
  .hero-image-mobile {
    display: none;
    width: 100%;
    position: relative;
    margin: var(--space-4) 0;
  }

  .hero-areas-list-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    background: linear-gradient(to top, rgba(19, 31, 91, 0.85), transparent);
    padding: var(--space-4) var(--space-3) var(--space-3);
    border-radius: 0 0 var(--radius-lg, 16px) var(--radius-lg, 16px);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
  }

  .hero-areas-list-overlay .area-item {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
    font-size: 0.625rem;
    font-weight: 400;
    padding: 2px 6px;
    backdrop-filter: blur(4px);
    text-align: center;
    line-height: 1.3;
    border-radius: var(--radius-sm);
  }

  /* ── Mobile Optimizations (≤1024px) ── */
  @media (max-width: 1024px) {
    /* Hero Layout */
    .service-hero-layout {
      grid-template-columns: 1fr;
      gap: var(--space-4);
      padding: var(--space-2) 0 var(--space-4);
    }

    .service-hero-content {
      align-items: center;
      text-align: center;
    }

    .service-hero-title {
      text-align: center;
    }

    .service-hero-lead {
      text-align: center;
      max-width: 100%;
    }

    /* Hide desktop image and regular chips */
    .hero-image-desktop {
      display: none;
    }

    .hero-areas-list {
      display: none;
    }

    /* Show mobile image with overlay */
    .hero-image-mobile {
      display: block;
    }

    /* Center section eyebrows */
    .section-eyebrow {
      justify-content: center;
      width: 100%;
    }

    /* Center CTAs */
    .service-hero-actions {
      justify-content: center;
      width: 100%;
    }

    /* Reduce section spacing */
    .section-header-center {
      margin-bottom: var(--space-4);
    }

    /* Authorities grid to single column */
    .authorities-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    /* Roadmap grid to single column */
    .roadmap-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    /* Keep number + title side by side on mobile */
    .roadmap-header {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
    }

    .roadmap-number {
      width: 40px;
      height: 40px;
      font-size: 1rem;
      flex-shrink: 0;
    }

    .roadmap-title {
      font-size: 1rem;
