---
/**
 * Qualification Recognition Service — InterProFinland
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Layout
  title="Foreign Qualification & Degree Recognition — InterProFinland"
  description="Navigate the recognition of your international qualifications and professional credentials in Finland."
>
  <Section>
    <Container size="content">
      <div style="text-align: center; max-width: 800px; margin: 0 auto; padding: 4rem 2rem;">
      <h1>Foreign Qualification & Degree Recognition</h1>
      
      <h2 style="margin-top: 2rem;">📋 Page Sections</h2>
      <p style="text-align: left; line-height: 2;">
        • Hero<br>
        • Why recognition matters<br>
        • Overview of the process<br>
        • Step-by-step support<br>
        • Competent authorities (OPH, Valvira, other)<br>
        • Regulated professions<br>
        • Complementary studies<br>
        • Educational institutions<br>
        • Qualification Recognition Handbook<br>
        • Degree AMPLIFY<br>
        • Related resources<br>
        • CTA
      </p>

      <p style="background: #fff3cd; padding: 1rem; border-radius: 8px; margin: 2rem 0;">
        <strong>⚠️ Important:</strong> InterProFinland provides guidance through the process; we are not the official recognition authority.
      </p>

      <p style="margin-top: 2rem;"><em>Page under construction</em></p>
      <p><a href="/services" style="color: #131f5b;">← Back to Services</a></p>
      </div>
    </Container>
  </Section>
</Layout>
