---
/**
 * Mentorship Service — InterProFinland
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Layout
  title="1-on-1 Mentorship & Peer Community — InterProFinland"
  description="Connect with experienced professionals and participate in peer support programs."
>
  <Section>
    <Container size="content">
      <div style="text-align: center; max-width: 800px; margin: 0 auto; padding: 4rem 2rem;">
      <h1>1-on-1 Mentorship & Peer Community</h1>
      
      <h2 style="margin-top: 2rem;">📋 Page Sections</h2>
      <p style="text-align: left; line-height: 2;">
        • Hero<br>
        • What is mentorship?<br>
        • Who it is for<br>
        • How mentorship works<br>
        • Mentor perspective<br>
        • Mentee perspective<br>
        • Peer support<br>
        • Language / community connection<br>
        • Related programs<br>
        • Success stories<br>
        • CTA
      </p>

      <p style="background: #fff3cd; padding: 1rem; border-radius: 8px; margin: 2rem 0;">
        <strong>⚠️ Note:</strong> No registration system in V1 — external application process.
      </p>

      <p style="margin-top: 2rem;"><em>Page under construction</em></p>
      <p><a href="/services" style="color: #131f5b;">← Back to Services</a></p>
      </div>
    </Container>
  </Section>
</Layout>
