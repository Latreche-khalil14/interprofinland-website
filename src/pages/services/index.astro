  <Section>
    <Container size="content">
      <div style="text-align: center; max-width: 800px; margin: 0 auto; padding: 4rem 2rem;">
      <h1>Services Hub</h1>
      
      <h2 style="margin-top: 2rem;">📋 Page Sections</h2>
      <p style="text-align: left; line-height: 2;">
        • Hero<br>
        • Intro<br>
        • 4 Main Services<br>
        • Supporting Programs<br>
        • How support works<br>
        • Related Projects<br>
        • Related Community Activities<br>
        • CTA
      </p>

      <h2 style="margin-top: 2rem;">🎯 Main Services</h2>
      <p style="text-align: left; line-height: 2;">
        <a href="/services/career-guidance" style="color: #131f5b;">→ Career Guidance</a><br>
        <a href="/services/qualification-recognition" style="color: #131f5b;">→ Qualification Recognition</a><br>
        <a href="/services/mentorship" style="color: #131f5b;">→ Mentorship</a><br>
