---
/**
 * Services Hub — InterProFinland
 * Dedicated, in-depth directory of professional advisory, qualification recognition,
 * mentorship, and employer matchmaking services.
 * Clean luxury editorial design with 4:3 and 16:9 placeholder media framing.
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import CtaSection from '@/components/sections/CtaSection.astro';

/* ── 4 Dedicated Core Services ── */
const services = [
  {
    index: '01',
    category: 'Labour Market Advisory',
    title: 'Career Guidance & Workplace Culture',
    description:
      'Personalized consultation designed to align your international background with Finnish recruitment expectations, workplace standards, and strategic job search methodologies.',
    benefits: [
      'Tailoring your CV and cover letter to Finnish industry norms and ATS standards',
      'Navigating the Finnish hidden job market and direct outreach to decision-makers',
      'Understanding collective labour agreements (TES), employment contracts, and salary benchmarks',
      'Interview coaching, communication etiquette, and workplace culture orientation',
    ],
    image: '/images/services/career-guidance/career-consultation.jpg',
    imageAlt: 'Career guidance consultation and Finnish labour market advising',
    href: '/services/career-guidance',
    ctaText: 'Explore Career Guidance',
  },
  {
    index: '02',
    category: 'Diploma Equivalency & Licensing',
    title: 'Foreign Qualification & Degree Recognition',
    description:
      'Comprehensive step-by-step assistance navigating Finnish regulatory bodies to validate your overseas educational credentials and gain official practice rights in Finland.',
    benefits: [
      'Identifying the competent regulatory authority (OPH, Valvira, Ruokavirasto, Traficom)',
      'Assembling application dossiers, transcript verification, and sworn translation advisory',
      'Guidance on comparative academic statements vs. full professional practice rights',
      'Navigating supplementary studies, aptitude tests, and adaptation training periods',
    ],
    image: '/images/services/Qualification-Recognition/2.png',
    imageAlt: 'Foreign qualification recognition and diploma equivalency support',
    href: '/services/qualification-recognition',
    ctaText: 'Explore Degree Recognition',
  },
  {
    index: '03',
    category: '1-on-1 Mentoring',
    title: 'One Mentor One (OmO) & Professional Mentorship',
    description:
      'Structured individual mentorship pairing you with experienced professionals established in your specific industry in Finland for strategic guidance and career growth.',
    benefits: [
      '6-month structured matching with industry peers and established professionals',
      'Goal-setting frameworks focused on career transition and professional milestones',
      'Unwritten rules of Finnish workplace culture and industry networking guidance',
      'Direct feedback on portfolio presentation, technical skills, and industry positioning',
    ],
    image: '/images/services/mentorship/one-toone.png',
    imageAlt: 'One-on-one professional mentorship session',
    href: '/services/mentorship',
    ctaText: 'Explore Mentorship Program',
  },
  {
    index: '04',
    category: 'Employer Matchmaking',
    title: 'Networking & Regional Opportunities',
    description:
      'Connecting international professionals directly with regional employers, municipal development agencies, and professional networks looking for global expertise.',
    benefits: [
      'Direct matchmaking roundtables with recruiting companies across Satakunta and nationwide',
      'Participation in specialized international recruitment fairs and employer speed-dating',
      'Interdisciplinary networking seminars with business leaders and municipal partners',
      'Access to partner initiatives, regional startup hubs, and innovation projects',
    ],
    image: '/images/services/networking/hero.png',
    imageAlt: 'Professional networking and employer matchmaking in Finland',
    href: '/services/networking',
    ctaText: 'Explore Networking & Matchmaking',
  },
];

/* ── Qualification Recognition Decision Pathways ── */
const recognitionPaths = [
  {
    title: 'Regulated Professions (Säännellyt ammatit)',
    badge: 'Mandatory Official Decision',
    description:
      'Professions where Finnish law specifies required educational qualifications or official licensing before you are legally permitted to practice.',
    examples: 'Healthcare professionals (doctors, nurses, dentists via Valvira), teachers & educators (via OPH), veterinarians, lawyers, maritime officers.',
    action: 'Requires formal application, transcript assessment, sworn translations, and often supplementary clinical/academic adaptation.',
  },
  {
    title: 'Non-Regulated Professions (Muut ammatit)',
    badge: 'Comparative Academic Statement',
    description:
      'Professions where Finnish employers independently assess your suitability and qualifications during the recruitment process without mandatory state licensing.',
    examples: 'Software engineers, marketing specialists, business analysts, data scientists, project managers, graphic designers, HR specialists.',
    action: 'OPH comparability statement is optional but strongly recommended to clearly demonstrate educational level (Bachelor, Master) to Finnish employers.',
  },
];

/* ── Service Consultation Workflow ── */
const workflowSteps = [
  {
    step: '01',
    title: 'Intake & Document Submission',
    desc: 'Submit your initial application with your CV, academic degree copies, and career goals via our secure online intake form.',
  },
  {
    step: '02',
    title: '1-on-1 Advisory Consultation',
    desc: 'Meet with an advisor (in-person at our Pori office or online via Teams/Zoom) for a comprehensive review of your situation.',
  },
  {
    step: '03',
    title: 'Customized Action Roadmap',
    desc: 'Receive an actionable plan outlining your qualification recognition route, CV improvements, or mentorship matching timeline.',
  },
  {
    step: '04',
    title: 'Ongoing Follow-Up & Pairing',
    desc: 'Access continuous guidance, attend targeted workshops, and connect directly with mentors and regional employment opportunities.',
  },
];

/* ── Document Readiness Checklist ── */
const documentChecklist = [
  {
    title: 'Degree Certificates & Diplomas',
    detail: 'Original language copies and certified English/Finnish/Swedish translations of higher education certificates.',
  },
  {
    title: 'Transcript of Records / Diploma Supplement',
    detail: 'Detailed course breakdown with credit units (ECTS or equivalent), grades, and official syllabi where applicable.',
  },
  {
    title: 'Current Professional CV',
    detail: 'Updated CV detailing your international work history, key projects, technical proficiencies, and language skills.',
  },
  {
    title: 'Proof of Identity & Residency Status',
    detail: 'Valid passport, Finnish residence permit card, or official identification documents for verification.',
  },
];

/* ── Specific Services FAQ ── */
const faqs = [
  {
    q: 'Are your advisory services and consultations free of charge?',
    a: 'Yes, all advisory consultations, CV reviews, qualification recognition guidance, and mentorship matching provided by InterProFinland are completely free for international professionals living in Finland.',
  },
  {
    q: 'How do I book an individual guidance consultation?',
    a: 'Consultations are organized by appointment on Mondays and Wednesdays. You can apply through our online application form or reach out directly to schedule a dedicated in-person or remote slot.',
  },
  {
    q: 'Do you submit OPH or Valvira applications on my behalf?',
    a: 'We guide you through the entire application preparation process, review your documents for completeness, and clarify requirements. However, the formal submission and state administrative fees remain the responsibility of the applicant.',
  },
  {
    q: 'Can I access your services if I reside outside the Satakunta region?',
    a: 'Yes! While our office is located in Pori, all individual guidance sessions, document reviews, webinars, and mentorship matching are available online for international professionals across all regions of Finland.',
  },
];
---

<Layout
  title="Services & Advisory Pathways — InterProFinland"
  description="Explore InterProFinland's specialized advisory services: career guidance, foreign degree recognition, One Mentor One mentoring, and regional employer matchmaking."
>
  <!-- SUBNAV -->
  <div class="community-subnav">
    <Container size="page">
      <div class="subnav-inner">
        <nav class="subnav-breadcrumbs" aria-label="Breadcrumb">
          <a href="/" class="crumb-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Home
          </a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span class="crumb-current" aria-current="page">Services</span>
        </nav>
        <span class="subnav-tagline">Comprehensive guidance for international professionals</span>
      </div>
    </Container>
  </div>

  <!-- HERO SECTION -->
  <Section background="surface">
    <Container size="page">
      <div class="services-hero-layout">
        <div class="services-hero-info">
          <div class="services-hero-pill-row">
            <span class="section-eyebrow">Advisory &amp; Support Pathways</span>
            <span class="hero-status-pill">Comprehensive Guidance</span>
          </div>

          <h1 class="services-hero-title">
            Tailored Career &amp; Recognition Services for <span class="services-hero-serif">International Talents</span>
          </h1>

          <p class="services-hero-lead">
            Navigating the Finnish professional landscape requires structured support. Our dedicated services
            guide you through foreign credential validation, job search adaptation, industry mentoring, and direct
            employer connections.
          </p>

          <div class="services-hero-media-wrap-mobile">
            <div class="services-hero-frame">
              <img
                src="/images/services/career-guidance/career-consultation.jpg"
                alt="InterProFinland individualized advisory consultation and career pathways"
                class="services-hero-img"
                width="800"
                height="450"
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="services-hero-audience-chips">
              <span class="audience-chip">Foreign Degree Holders</span>
              <span class="audience-chip">Skilled Job Seekers</span>
              <span class="audience-chip">Regulated Profession Licensure</span>
              <span class="audience-chip">Mid-Career Professionals</span>
            </div>
          </div>

          <div class="services-hero-actions">
            <a
              href="https://form.jotform.com/InterProFinland/membership-application-form"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-services-primary"
            >
              <span>Book an Advisory Consultation</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="#core-services-list" class="btn-services-secondary">
              <span>Explore All 4 Services</span>
            </a>
          </div>
        </div>

        <div class="services-hero-media-wrap-desktop">
          <div class="services-hero-frame">
            <img
              src="/images/services/career-guidance/career-consultation.jpg"
              alt="InterProFinland individualized advisory consultation and career pathways"
              class="services-hero-img"
              width="800"
              height="450"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       THE 4 CORE SERVICES: Alternating Editorial Split Rows (4:3 Media Frame)
       ========================================================================== -->
  <Section>
    <div id="core-services-list"></div>
    <Container size="page">
      <div class="services-section-header">
        <span class="section-eyebrow">Core Service Pillars</span>
        <h2 class="section-heading">Four Comprehensive Support Pathways</h2>
        <p class="section-intro">
          Each service is designed to tackle a specific stage of your professional journey in Finland,
          delivering practical clarity and tangible progress.
        </p>
      </div>

      <div class="services-editorial-stack">
        {
          services.map((svc, idx) => (
            <article class={`service-editorial-card ${idx % 2 !== 0 ? 'is-reversed' : ''}`}>
              <div class="service-editorial-content">
                <div class="service-meta-header">
                  <span class="service-index-number">{svc.index}</span>
                  <div class="service-header-text">
                    <span class="service-category-tag">{svc.category}</span>
                    <h3 class="service-heading">
                      <a href={svc.href} class="service-heading-link">{svc.title}</a>
                    </h3>
                  </div>
                </div>

                <p class="service-description-text">{svc.description}</p>

                <div class="service-benefits-block">
                  <span class="benefits-label">Key Service Elements:</span>
                  <ul class="benefits-list" role="list">
                    {svc.benefits.map((b) => (
                      <li>
                        <span class="check-icon" aria-hidden="true">✓</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="service-actions-row">
                  <a href={svc.href} class="btn-service-view">
                    <span>{svc.ctaText}</span>
                    <span class="cta-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </div>

              <div class="service-editorial-visual">
                <div class="service-image-box">
                  <img
                    src={svc.image}
                    alt={svc.imageAlt}
                    class="service-box-img"
                    width="800"
                    height="600"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       DECISION MATRIX: Regulated vs. Non-Regulated Professions
       ========================================================================== -->
  <Section background="surface">
    <Container size="page">
      <div class="services-section-header">
        <span class="section-eyebrow">Guidance Framework</span>
        <h2 class="section-heading">Understanding Your Qualification Pathway in Finland</h2>
        <p class="section-intro">
          The procedure for using foreign qualifications in Finland depends primarily on whether your
          profession is legally regulated by Finnish legislation.
        </p>
      </div>

      <div class="pathways-comparison-grid">
        {
          recognitionPaths.map((path) => (
            <div class="pathway-matrix-card">
              <div class="pathway-card-header">
                <span class="pathway-badge">{path.badge}</span>
                <h3 class="pathway-title">{path.title}</h3>
              </div>
              <p class="pathway-desc">{path.description}</p>
              
              <div class="pathway-meta-box">
                <strong>Typical Professions:</strong>
                <p>{path.examples}</p>
              </div>

              <div class="pathway-action-box">
                <strong>Next Step:</strong>
                <p>{path.action}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="pathways-cta-footer">
        <a href="/services/qualification-recognition" class="btn-services-primary">
          <span>Read Comprehensive Recognition Guide</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       WORKFLOW SECTION: What to Expect in the Advisory Process
       ========================================================================== -->
  <Section>
    <Container size="page">
      <div class="services-section-header">
        <span class="section-eyebrow">Service Delivery Workflow</span>
        <h2 class="section-heading">What to Expect When You Contact Us</h2>
        <p class="section-intro">
          A structured, confidential advisory process built to give you actionable clarity in every consultation.
        </p>
      </div>

      <div class="workflow-steps-grid">
        {
          workflowSteps.map((wf) => (
            <div class="workflow-step-card">
              <div class="workflow-header">
                <span class="step-badge">{wf.step}</span>
                <h3 class="step-title">{wf.title}</h3>
              </div>
              <p class="step-desc">{wf.desc}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       DOCUMENT READINESS: What to Prepare Before Your Consultation
       ========================================================================== -->
  <Section background="surface">
    <Container size="page">
      <div class="services-section-header">
        <span class="section-eyebrow">Consultation Preparation</span>
        <h2 class="section-heading">Document Readiness Checklist</h2>
        <p class="section-intro">
          To maximize the value of your one-on-one session, prepare the following materials in advance.
        </p>
      </div>

      <div class="checklist-grid">
        {
          documentChecklist.map((item, i) => (
            <div class="checklist-card">
              <div class="checklist-icon-box">
                <span class="checklist-number">0{i + 1}</span>
              </div>
              <div class="checklist-content">
                <h3 class="checklist-title">{item.title}</h3>
                <p class="checklist-detail">{item.detail}</p>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       FAQ SECTION: Specific Practical Service Questions
       ========================================================================== -->
  <Section>
    <Container size="page">
      <div class="services-section-header">
        <span class="section-eyebrow">Practical Details</span>
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <p class="section-intro">
          Answers to common questions regarding eligibility, appointment scheduling, and advisory scope.
        </p>
      </div>

      <div class="services-faq-grid">
        {
          faqs.map((faq) => (
            <details class="faq-accordion-item">
              <summary class="faq-accordion-trigger">
                <span class="faq-q-text">{faq.q}</span>
                <span class="faq-accordion-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="faq-accordion-body">
                <p class="faq-a-text">{faq.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       BOTTOM CTA SECTION
       ========================================================================== -->
  <CtaSection
    heading="Take the Next Step in Your Professional Career"
    subheading="Whether you need foreign diploma recognition, CV review, or an experienced mentor in your field, our advisory network is here to support you."
    cta={{
      label: 'Apply for Advisory Guidance',
      href: 'https://form.jotform.com/InterProFinland/membership-application-form',
    }}
  />
</Layout>

<style>
  /* ══════════════════════════════════════════════════════════════════════════
     SERVICES HUB — DEDICATED EDITORIAL DESIGN SYSTEM
     ══════════════════════════════════════════════════════════════════════════ */

  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary-500, #1E3A8A);
    margin-bottom: var(--space-3);
    line-height: 1;
  }

  .section-eyebrow::before,
  .section-eyebrow::after {
    content: '';
    display: block;
    width: 28px;
    height: 2.5px;
    background-color: #ffd26f;
    flex-shrink: 0;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3);
    line-height: 1.15;
    letter-spacing: -0.025em;
    text-align: center;
    text-wrap: balance;
  }

  .section-intro {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 65ch;
    margin: 0 auto var(--space-6);
    line-height: var(--line-height-relaxed);
    text-align: center;
  }

  .section-header-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* ── Hero Section (16:9 / 4:2.25 Frame) ── */
  .services-hero-layout {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.5rem, 3vw, 2.5rem) 0;
  }

  @media (max-width: 768px) {
    .services-hero-layout {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }
    
    .services-hero-media-wrap {
      order: 2;
    }
    
    .services-hero-info {
      order: 1;
    }
  }

  .services-hero-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .services-hero-pill-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero-status-pill {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #131F5B;
    background-color: #FFD26F;
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .services-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.85rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1.18;
    letter-spacing: -0.025em;
    margin: 0;
  }

  .services-hero-serif {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: var(--font-weight-regular);
    color: var(--color-primary-600, #1E3A8A);
  }

  .services-hero-lead {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: var(--line-height-relaxed);
    color: var(--color-gray-800);
    margin: 0;
  }

  .services-hero-audience-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: var(--space-2) 0;
  }

  .audience-chip {
    font-family: var(--font-display);
    font-size: 0.78125rem;
    font-weight: 600;
    color: #131F5B;
    background-color: #ffffff;
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    padding: 4px 10px;
    border-radius: var(--radius-sm, 6px);
  }

  .services-hero-actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .btn-services-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-gold, #FFD26F);
    color: #131F5B;
    border: 2px solid var(--color-gold, #FFD26F);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px var(--color-gold-shadow, rgba(255, 210, 111, 0.35));
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 150ms ease;
  }

  .btn-services-primary:hover {
    background-color: var(--color-primary-600, #1E3A8A);
    border-color: var(--color-primary-600, #1E3A8A);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-services-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: #131F5B;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border: 2px solid #131F5B;
    background-color: transparent;
    border-radius: var(--radius-sm);
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 150ms ease;
  }

  .btn-services-secondary:hover {
    background-color: #131F5B;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .services-hero-media-wrap {
    width: 100%;
  }

  .services-hero-media-wrap-mobile {
    display: none;
    width: 100%;
    position: relative;
  }

  .services-hero-media-wrap-desktop {
    display: block;
    width: 100%;
  }

  .services-hero-frame {
    position: relative;
    position: relative;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    box-shadow: 0 12px 32px -8px rgba(19, 31, 91, 0.12),
                0 0 0 1px rgba(19, 31, 91, 0.08);
    background-color: #f8fafc;
  }

  .services-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 500ms ease;
  }

  .services-hero-frame:hover .services-hero-img {
    transform: scale(1.03);
  }

  /* ── 4 Core Services Editorial Stack (4:3 Media Frame) ── */
  .services-section-header {
    text-align: center;
    margin-bottom: var(--space-6);
  }

