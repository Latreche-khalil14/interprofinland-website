---
/**
 * Career Guidance & Workplace Culture — InterProFinland
 * Dedicated in-depth service page for labour market navigation, CV tailoring, and workplace integration.
 * Luxury editorial design matching Home and About design systems.
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import CtaSection from '@/components/sections/CtaSection.astro';

/* ── 3 Core Advisory Pillars ── */
const advisoryPillars = [
  {
    number: '01',
    title: 'Finnish-Standard CV & Application Tailoring',
    description:
      'Finnish employers expect concise, transparent, and impact-driven CVs. We guide you in highlighting transferable international experience, language capabilities, and technical competencies according to Finnish hiring standards.',
    highlights: [
      'Concise 1–2 page reverse-chronological layout formatted for Finnish ATS systems',
      'Framing international projects and quantifiable achievements clearly',
      'Tailoring targeted cover letters addressing specific role requirements',
    ],
  },
  {
    number: '02',
    title: 'Unlocking the Hidden Job Market (Piilotyöpaikat)',
    description:
      'Many open positions in Finland are filled through professional networks, direct recruiter outreach, and proactive applications before ever being advertised on public job boards. We provide systematic strategies for direct outreach and industry mapping.',
    highlights: [
      'Identifying growing regional companies and decision-makers in your sector',
      'Constructing professional outreach messages in English and Finnish',
      'Optimizing your LinkedIn profile for Finnish recruiters and search algorithms',
    ],
  },
  {
    number: '03',
    title: 'Workplace Culture & Labour Legislation (TES)',
    description:
      'Understanding Finnish working norms—flat hierarchy, direct communication, punctuality, and high autonomy—is essential for passing trial periods and building long-term career growth in Finland.',
    highlights: [
      'Collective labour agreements (Työehtosopimus / TES) and realistic salary benchmarking using industry standards',
      'Trial period (Koeaika) expectations, employee rights, and occupational health orientation',
      'Communication nuances, autonomy, and constructive feedback in Finnish teams',
    ],
  },
];

/* ── Interview & Preparation Checklist (Visual 2x2 Numbered Cards) ── */
const interviewTips = [
  {
    number: '01',
    title: 'Directness & Authenticity',
    text: 'Finnish interviewers value factual honesty over exaggeration. Clearly state what you know, acknowledge areas you are learning, and give concrete, measurable examples of your past work.',
  },
  {
    number: '02',
    title: 'Company Preparation & Strategy',
    text: `Demonstrate thoughtful research on the organization's current operations, industry position, and technological ecosystem. Ask strategic questions about team workflows.`,
  },
  {
    number: '03',
    title: 'Salary Expectation & Negotiation',
    text: 'In Finland, job candidates are frequently asked for a salary request (Palkkatoive). We assist you in benchmarking realistic ranges using public union statistics and collective agreements.',
  },
  {
    number: '04',
    title: 'Language Proficiency & Commitment',
    text: 'Clearly articulate your current Finnish language learning plan, even for English-speaking workplaces, showing long-term dedication to team integration.',
  },
];

/* ── Specific Career FAQs ── */
const careerFaqs = [
  {
    q: 'What should I bring to a CV and career advisory session?',
    a: 'Please bring your current CV, links to your LinkedIn or portfolio, examples of job descriptions you are targeting, and any questions regarding Finnish working life.',
  },
  {
    q: 'Do you help with finding internships or first jobs in Finland?',
    a: 'Yes, we assist international graduates and newly arrived professionals in identifying entry pathways, trainee programs, and municipal employment initiatives.',
  },
  {
    q: 'Are career guidance consultations conducted in English or Finnish?',
    a: 'Consultations can be held in English or Finnish based on your preference and comfort level.',
  },
  {
    q: 'Can you review my contract before I sign with an employer?',
    a: 'We can provide general orientation on standard Finnish contract elements (working hours, trial period clauses, TES references). For legal disputes, we refer to specialized trade unions.',
  },
];

/* ── Process steps ── */
const processSteps = [
  {
    icon: '📋',
    step: '01',
    title: 'Initial Assessment',
    desc: 'We review your background, qualifications, and career goals to map the most effective Finnish job search strategy.',
  },
  {
    icon: '✏️',
    step: '02',
    title: 'CV & Materials Review',
    desc: 'Your CV, cover letter, and LinkedIn profile are refined to meet Finnish employer expectations and ATS requirements.',
  },
  {
    icon: '🎯',
    step: '03',
    title: 'Market Strategy',
    desc: 'We identify target companies, sectors, and hidden opportunities specific to your field and Finnish region.',
  },
  {
    icon: '🤝',
    step: '04',
    title: 'Interview Readiness',
    desc: 'Mock interviews, salary negotiation practice, and Finnish workplace culture coaching to boost your confidence.',
  },
];
---

<Layout
  title="Career Guidance & Workplace Culture — InterProFinland"
  description="Master the Finnish labour market with individualized CV reviews, hidden job search strategies, interview coaching, and workplace culture orientation."
>
  <!-- ==========================================================================
       HERO SECTION: Clear Visual Hierarchy — Title → Description → Chips → CTAs → Image
       ========================================================================== -->
  <Section background="surface">
    <Container size="page">
      <!-- Breadcrumb -->
      <nav class="service-breadcrumb" aria-label="Breadcrumb">
        <a href="/services" class="breadcrumb-back">← Back to Services</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">Career Guidance</span>
      </nav>

      <!-- Hero: Two-Column Layout (Text Left · Image Right) -->
      <div class="hero-split-layout">
        <!-- Left: Text block -->
        <div class="hero-text-block">
          <h1 class="hero-title">
            Career Guidance &amp; Finnish <span class="hero-title-serif">Workplace Culture</span>
          </h1>

          <p class="hero-description">
            Gain strategic clarity and practical tools to navigate the Finnish employment landscape,
            tailor your application materials, and confidently integrate into Finnish working life.
          </p>

          <!-- Key Areas -->
          <div class="hero-areas-list" aria-label="Key Guidance Areas">
            <span class="area-item">CV &amp; Cover Letter Review</span>
            <span class="area-divider">•</span>
            <span class="area-item">Hidden Job Market Strategy</span>
            <span class="area-divider">•</span>
            <span class="area-item">Interview Coaching</span>
            <span class="area-divider">•</span>
            <span class="area-item">Labour Rights &amp; TES</span>
          </div>

          <!-- CTAs -->
          <div class="hero-cta-row">
            <a
              href="https://form.jotform.com/InterProFinland/membership-application-form"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
              id="hero-primary-cta"
            >
              <span>Apply for Career Advisory</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="#advisory-pillars" class="btn-ghost" id="hero-secondary-cta">
              <span>View Guidance Pillars</span>
            </a>
          </div>
        </div>

        <!-- Right: Image -->
        <div class="hero-image-block">
          <div class="hero-image-frame">
            <img
              src="/images/services/career-guidance/career-consultation.jpg"
              alt="Career advisor and international professional reviewing CV and career strategy together"
              class="hero-img"
              width="800"
              height="600"
              loading="eager"
              decoding="async"
            />
            <div class="hero-image-overlay" aria-hidden="true">
              <span class="hero-image-caption">1-on-1 Career Advisory · CV Review · Interview Prep</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       HOW IT WORKS: 4-Step Process (Clean & Elegant)
       ========================================================================== -->
  <Section>
    <Container size="page">
      <div class="section-header-center">
        <span class="section-eyebrow">Our Process</span>
        <h2 class="section-heading">How Career Guidance Works</h2>
        <p class="section-intro">
          A structured, personalized approach designed to move you from uncertainty to a confident
          Finnish job search strategy in four focused sessions.
        </p>
      </div>

      <div class="process-grid">
        {
          processSteps.map((s) => (
            <div class="process-step">
              <div class="step-header">
                <div class="step-number">{s.step}</div>
                <h3 class="step-title">{s.title}</h3>
              </div>
              <p class="step-description">{s.desc}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       CORE GUIDANCE PILLARS (3-Column Cards)
       ========================================================================== -->
  <Section background="surface">
    <div id="advisory-pillars"></div>
    <Container size="page">
      <div class="section-header-center">
        <span class="section-eyebrow">Strategic Advisory</span>
        <h2 class="section-heading">How We Support Your Career Journey</h2>
        <p class="section-intro">
          Our structured career guidance covers the essential components required to transition
          from international credentials to meaningful Finnish employment.
        </p>
      </div>

      <div class="pillars-grid">
        {
          advisoryPillars.map((p) => (
            <div class="pillar-card">
              <div class="pillar-header">
                <span class="pillar-index">{p.number}</span>
                <h3 class="pillar-title">{p.title}</h3>
              </div>
              <p class="pillar-desc">{p.description}</p>

              <ul class="pillar-highlights" role="list">
                {p.highlights.map((h) => (
                  <li>
                    <span class="check-icon" aria-hidden="true">✓</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       SPLIT EDITORIAL: Mastering the Finnish Job Interview (4:3 Media Frame)
       ========================================================================== -->
  <Section>
    <Container size="page">
      <div class="editorial-split-layout">
        <div class="split-content-side">
          <span class="section-eyebrow">Interview Preparation</span>
          <h2 class="split-heading">Mastering the Finnish Recruitment Interview</h2>
          <p class="split-lead">
            Interviews in Finland have distinct cultural expectations. Understanding these nuances
            helps you present your experience with credibility and confidence.
          </p>

          <div class="tips-grid">
            {
              interviewTips.map((tip) => (
                <div class="tip-card">
                  <div class="tip-card-header">
                    <span class="tip-number" aria-hidden="true">{tip.number}</span>
                    <h3 class="tip-title">{tip.title}</h3>
                  </div>
                  <p class="tip-text">{tip.text}</p>
                </div>
              ))
            }
          </div>
        </div>

        <div class="split-visual-side">
          <div class="split-image-frame">
            <img
              src="/images/services/career-guidance/interview-coaching.jpg"
              alt="Finnish job interview coaching and mock recruitment session"
              class="split-img"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            />
          </div>
          <!-- Stats block -->
          <div class="split-stats-block">
            <div class="stat-item">
              <span class="stat-number">73%</span>
              <span class="stat-label">of Finnish jobs are filled through networks</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="stat-item">
              <span class="stat-number">1–2</span>
              <span class="stat-label">page Finnish CV standard</span>
            </div>
            <div class="stat-divider" aria-hidden="true"></div>
            <div class="stat-item">
              <span class="stat-number">EN/FI</span>
              <span class="stat-label">advisory sessions available</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       SPECIFIC FAQS
       ========================================================================== -->
  <Section background="surface">
    <Container size="page">
      <div class="section-header-center">
        <span class="section-eyebrow">Career Guidance FAQs</span>
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <p class="section-intro">
          Common inquiries about our career advisory consultations and support scope.
        </p>
      </div>

      <div class="faqs-grid">
        {
          careerFaqs.map((faq) => (
            <details class="faq-accordion-item">
              <summary class="faq-accordion-trigger">
                <span class="faq-q-text">{faq.q}</span>
                <span class="faq-accordion-icon" aria-hidden="true">
                  <svg
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="faq-accordion-body">
                <p class="faq-a-text">{faq.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ==========================================================================
       BOTTOM CTA
       ========================================================================== -->
  <CtaSection
    heading="Ready to Accelerate Your Career in Finland?"
    subheading="Book a dedicated 1-on-1 career guidance session to review your CV, target open opportunities, and master Finnish workplace standards."
    background="surface"
    cta={{
      label: 'Apply for Career Advisory',
      href: 'https://form.jotform.com/InterProFinland/membership-application-form',
      target: '_blank',
    }}
    secondaryCta={{
      label: 'Explore All Services',
      href: '/services',
    }}
  />
</Layout>

<style>
  /* ── Breadcrumb ── */
  .service-breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: var(--space-5);
  }

  .breadcrumb-back {
    color: var(--color-primary-600, #1E3A8A);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .breadcrumb-back:hover {
    color: #131F5B;
    text-decoration: underline;
  }

  .breadcrumb-sep {
    color: var(--color-gray-400);
  }

  .breadcrumb-current {
    color: var(--color-gray-500);
  }

  /* ── Hero Split Layout (Text Left · Image Right) ── */
  .hero-split-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(0.5rem, 1.5vw, 1.5rem) 0 clamp(2rem, 3vw, 3rem);
  }

  .hero-text-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .hero-title-serif {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: var(--font-weight-regular);
    color: var(--color-primary-600, #1E3A8A);
  }

  .hero-description {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-gray-700);
    margin: 0;
    max-width: 68ch;
  }

  /* Key Areas List — Clean & Simple */
  .hero-areas-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-gray-600);
  }

  .area-item {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .area-divider {
    color: var(--color-gray-400);
    font-weight: 300;
  }

  /* CTAs */
  .hero-cta-row {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    flex-wrap: wrap;
    margin-top: var(--space-1);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-gold, #FFD26F);
    color: #131F5B;
    border: 2px solid var(--color-gold, #FFD26F);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px rgba(255, 210, 111, 0.35);
    transition: background-color 200ms ease, color 200ms ease, border-color 200ms ease, transform 150ms ease;
  }

  .btn-primary:hover {
    background-color: #131F5B;
    border-color: #131F5B;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-gray-700);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    padding: var(--space-3) var(--space-5);
    border: 1.5px solid var(--color-border-subtle, #e2e8f0);
    background-color: transparent;
    border-radius: var(--radius-sm);
    transition: border-color 200ms ease, color 200ms ease, background-color 200ms ease;
  }

  .btn-ghost:hover {
    border-color: #131F5B;
    color: #131F5B;
    background-color: #f8fafc;
  }

  /* Hero Image Block */
  .hero-image-block {
    width: 100%;
  }

  .hero-image-frame {
    position: relative;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: 0 16px 48px -12px rgba(19, 31, 91, 0.18),
                0 0 0 1px rgba(19, 31, 91, 0.06);
    background-color: #f1f5f9;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    transition: transform 600ms ease;
  }

  .hero-image-frame:hover .hero-img {
    transform: scale(1.02);
  }

  .hero-image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-4) var(--space-6);
    background: linear-gradient(to top, rgba(19, 31, 91, 0.65) 0%, transparent 100%);
    display: flex;
    align-items: flex-end;
  }

  .hero-image-caption {
    font-family: var(--font-display);
    font-size: 0.78125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.85);
  }

  /* ── Section Utilities ── */
  .section-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary-500);
    margin-bottom: var(--space-3);
    line-height: 1;
  }

  .section-eyebrow::before,
  .section-eyebrow::after {
    content: '';
    display: block;
    width: 28px;
    height: 2.5px;
    background-color: #ffd26f;
    flex-shrink: 0;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .section-intro {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 65ch;
    margin: 0 auto var(--space-6);
    line-height: var(--line-height-relaxed);
    text-align: center;
  }

  .section-header-center {
    text-align: center;
    margin-bottom: var(--space-6);
  }

  /* ── Process Grid (Clean & Elegant) ── */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    max-width: 1000px;
    margin: 0 auto;
  }

  .process-step {
    background: #ffffff;
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: all 300ms ease;
    position: relative;
  }

  .process-step:hover {
    border-color: #1E3A8A;
    box-shadow: 0 8px 24px -4px rgba(19, 31, 91, 0.08);
    transform: translateY(-2px);
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md, 12px);
    background-color: #1E3A8A;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .step-description {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-gray-700);
    margin: 0;
  }

  /* ── 3 Pillars Grid ── */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .pillar-card {
    background: #ffffff;
    border: 1px solid var(--color-border-subtle, #e2e8f0);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .pillar-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px -6px rgba(19, 31, 91, 0.1);
  }

  .pillar-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-bottom: 1px solid var(--color-border-subtle, #e2e8f0);
    padding-bottom: var(--space-3);
  }

  .pillar-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md, 10px);
    background-color: #1E3A8A;
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .pillar-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .pillar-desc {
    font-family: var(--font-body);
    font-size: 0.90625rem;
    line-height: 1.6;
    color: var(--color-gray-700);
    margin: 0;
  }

  .pillar-highlights {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pillar-highlights li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-family: var(--font-body);
