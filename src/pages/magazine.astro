---
/**
 * Magazine — InterProFinland
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Layout
  title="Magazine — InterProFinland"
  description="Stories, practical guidance and insights for international professionals in Finland."
>
  <Section>
    <Container size="content">
      <div style="text-align: center; max-width: 800px; margin: 0 auto; padding: 4rem 2rem;">
      <h1>InterProFinland Magazine</h1>
      
      <h2 style="margin-top: 2rem;">📋 Page Sections</h2>
      <p style="text-align: left; line-height: 2;">
        • Hero<br>
        • Magazine introduction<br>
        • Issue archive<br>
        • Covers<br>
        • Issue metadata<br>
        • PDF access<br>
        • Featured issue<br>
        • Qualification Handbook / resources<br>
        • Future issues<br>
        • Contribution CTA (if actually approved)
      </p>

      <p style="background: #fff3cd; padding: 1rem; border-radius: 8px; margin: 2rem 0;">
        <strong>⚠️ Note:</strong> No CMS needed — static content management.
      </p>

      <p style="margin-top: 2rem;"><em>Page under construction</em></p>
      </div>
    </Container>
  </Section>
</Layout>
