---
/**
 * About Page — InterProFinland
 * Who we are, our mission, and how we support international professionals
 * Editorial layout matching Homepage design patterns
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';


/* ── Core Values ── */
const values = [
  {
    number: '01',
    title: 'Potentiality',
    description:
      'We believe that there is an inherent ability in every single one of us which can be nurtured and developed to the fullest capacity.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>`,
  },
  {
    number: '02',
    title: 'Recognition',
    description:
      'We believe that all humans deserve to be seen in the totality of their existence, not just in the fragment of the present, but as an entity with a past, skills, and identity that should be recognised.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`,
  },
  {
    number: '03',
    title: 'Professionalism',
    description:
      'We believe that underutilization of professional skills and training amounts to brain waste, and that harnessing the skills and talents inherent in a society enriches its economy.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>`,
  },
  {
    number: '04',
    title: 'Growth',
    description:
      'We believe that Growth is a natural occurrence which is vital to human existence and wellbeing, and that everyone deserves a chance to grow professionally, economically, and in other areas they need to grow in.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline><polyline points="16 7 22 7 22 13"></polyline></svg>`,
  },
  {
    number: '05',
    title: 'Inclusion',
    description:
      'We believe that a society is at its best if all who live within it are carried along in all areas, with none left devoid of the feeling of belongingness.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`,
  },
];

/* ── Impact Statistics ── */
const impact = [
  { number: '1,800+', label: 'Community Members' },
  { number: '80+', label: 'Professions Represented' },
  { number: '74', label: 'Nationalities' },
  { number: '2021', label: 'Established' },
];

/* ── Team Members ── */
const leadership = {
  chairperson: {
    name: 'Henriika Ilkko',
    role: 'Chairperson',
    bio: "Henriika has successfully led numerous projects and excelled in IT, Quality Management and Project Management Office (PMO) functions in her impressive career. In her role as Chairperson, Henriika plays a crucial role in guiding our organization's strategic direction, fostering growth, and ensuring continued excellence in all our endeavors.",
    image: '/images/about/team/henriika-chairperson.webp',
  },
  ceo: {
    name: 'Olivia Kumpula',
    role: 'CEO & Founder',
    bio: 'Olivia founded InterProFinland after experiencing firsthand the challenges international professionals face in Finland. Through her expat blog and YouTube channel "My Finland Story," she documented integration experiences and realized that many internationals encounter similar barriers in utilizing their skills and transitioning into the Finnish workforce.',
    website: 'www.oliviakumpula.com',
    image: '/images/about/team/olivia-ceo.webp',
    linkedin: 'https://www.linkedin.com/in/oliviakumpula',
  },
};

const team = [
  {
    name: 'Matthew Bowen',
    role: 'CAO',
    image: '/images/about/team/matthew-cao.webp',
    linkedin: 'https://www.linkedin.com/in/matthew-j-bowen',
  },
  {
    name: 'Meha Bouazizi',
    role: 'Media / Marketing',
    image: '/images/about/team/meha-media.webp',
    linkedin: 'https://www.linkedin.com/in/meha-bouazizi',
  },
  {
    name: 'Temitope Popoola',
    role: 'Funding / Project Coordinator',
    image: '/images/about/team/temitope-funding.webp',
    linkedin: 'https://www.linkedin.com/in/popoola-temitope',
  },
  {
    name: 'Bruna Eklund',
    role: 'Project & Event Coordinator',
    image: '/images/about/team/bruna-events.webp',
  },
  {
    name: 'Pooja Mattoo',
    role: 'Kielikaverit (Language Club) Coordinator',
    image: '/images/about/team/pooja-language.webp',
  },
  {
    name: 'Gabriel Ebah',
    role: 'Facilitator, Media & Marketing (Volunteer)',
    image: '/images/about/team/gabriel-facilitator.webp',
  },
];

/* ── Key Focus Areas ── */
const focusAreas = [
  {
    number: '01',
    title: 'Bridging Qualification Gaps',
    description:
      'Navigating the Finnish qualification recognition process is complex. We provide step-by-step guidance through OPH, Valvira, and other competent authorities, helping professionals validate their international credentials.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>`,
  },
  {
    number: '02',
    title: 'Building Professional Networks',
    description:
      'Access to the right connections transforms career trajectories. Through mentorship matching, industry events, and community clubs, we create opportunities for meaningful professional relationships.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
  },
  {
    number: '03',
    title: 'Understanding Finnish Work Culture',
    description:
      'Success in Finland requires more than qualifications. We help professionals understand Finnish workplace expectations, communication styles, and cultural nuances that make the difference.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>`,
  },
  {
    number: '04',
    title: 'Creating Pathways to Employment',
    description:
      'From labour market orientation to job search strategies, we support professionals in identifying opportunities that match their expertise and building careers that reflect their true potential.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>`,
  },
];


---

<Layout
  title="About InterProFinland — Supporting International Talent Integration"
  description="Learn about InterProFinland's mission to support international professionals in Finland through individualized guidance, mentorship, qualification recognition, and community building."
>
  <!-- HERO -->
  <Section background="surface">
    <Container size="page">
      <div class="about-purpose-manifesto">
        <div class="about-purpose-right">
          <span class="section-eyebrow">About InterProFinland</span>
          <h1 class="about-purpose-title">
            Empowering International Professionals to <span class="about-purpose-serif">Thrive in Finland</span>
          </h1>
          
          <p class="about-purpose-lead">
            We are a support network dedicated to helping international professionals overcome
            barriers, validate their qualifications, and build meaningful careers in the Finnish
            labour market.
          </p>

          <!-- Impact Stats -->
          <div class="about-impact-stats-row">
            {
              impact.map((stat) => (
                <div class="about-impact-stat">
                  <strong class="about-impact-number">{stat.number}</strong>
                  <span class="about-impact-label">{stat.label}</span>
                </div>
              ))
            }
          </div>

          <p class="about-purpose-subtext">
            Since 2021, we've built a vibrant community of international professionals, fostering connections, facilitating qualification recognition, and creating pathways to meaningful employment across Finland.
          </p>
        </div>

        <div class="about-purpose-left">
          <div class="about-purpose-image-wrap">
            <img
              src="/images/about/About InterProFinland.jpg"
              alt="About InterProFinland - International Professionals Finland ry community"
              class="about-purpose-img"
              width="800"
              height="500"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- OUR STORY -->
  <Section>
    <Container size="page">
      <div class="about-story-manifesto">
        <div class="about-story-visual-col">
          <div class="about-story-image-wrap">
            <img
              src="/images/about/olvia2.webp"
              alt="Olivia Kumpula, Founder and CEO of InterProFinland"
              class="about-story-img"
              width="800"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="about-story-content-col">
          <span class="section-eyebrow">Our Story</span>
          <h2 class="section-heading">
            How <span class="about-story-serif">InterProFinland</span> Began
          </h2>

          <!-- Mobile Image: Placed after big heading -->
          <div class="about-story-image-wrap about-story-image-wrap--mobile">
            <img
              src="/images/about/olvia2.webp"
              alt="Olivia Kumpula, Founder and CEO of InterProFinland"
              class="about-story-img"
              width="800"
              height="1000"
              loading="lazy"
              decoding="async"
            />
          </div>
          
          <div class="about-story-content">
            <p class="about-story-text">
              When our founder, <strong>Olivia Kumpula</strong>, moved to Finland, she spent the first
              few years trying to find her place in her new home country. Through her expat blog and
              YouTube channel, <em>'My Finland Story'</em>, she documented her life and experiences in
              Finland and shared tips for integrating into Finland's society and culture.
            </p>

            <p class="about-story-text">
              She also started an interactive club on Clubhouse called <em
                >'The Finns and Foreigners Club'</em
              >. Through connections made in the club, she realized that almost all international
              professionals encounter similar challenges which hinder them from utilizing their skills
              and transitioning into the Finnish workforce.
            </p>

            <p class="about-story-text">
              Although a number of resources are available, many internationals still have trouble
              locating these resources and applying them to their personal situations. In <strong
                >2021</strong
              >, Olivia assembled a team of professionals and <strong
                >International Professionals Finland ry</strong
              > was established.
            </p>
          </div>

          <div class="about-story-action">
            <a href={`https://${leadership.ceo.website}`} class="about-story-cta-link" target="_blank" rel="noopener noreferrer">
              <span>Visit Olivia's Website</span>
              <span class="cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- MISSION & VISION -->
  <Section background="surface">
    <Container size="page">
      <div class="about-editorial-header">
        <div class="about-editorial-title-wrap">
          <span class="section-eyebrow">Our Mission & Vision</span>
          <h2 class="section-heading">Why We Exist & What We're Building</h2>
        </div>
        <p class="about-editorial-desc">
          A clear purpose guiding our work and a vision for an inclusive Finland where international expertise enriches the entire workforce.
        </p>
      </div>

      <div class="about-editorial-layout">
        <!-- Mission -->
        <article class="about-editorial-split">
          <div class="about-split-content">
            <div class="about-service-index-badge">
              <span>Mission</span>
            </div>
            <h3 class="about-service-title">Why We Exist</h3>

            <!-- Mobile Image: Placed after title -->
            <div class="about-split-visual about-split-visual--mobile">
              <img
                src="/images/about/Mission.jpg"
                alt="InterProFinland mission - International professionals receiving guidance and support"
                class="about-split-image"
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
            </div>

            <p class="about-service-description">
              Providing a support network and tailored guidance to help international professionals in
              Finland overcome barriers, utilize their skills, and build meaningful careers.
            </p>
            <p class="about-service-subdescription">
              Through diverse programs and services, we assist international professionals qualified for a profession abroad to overcome obstacles hindering them from utilizing their skills in Finland. We provide customized support, mentorship, networking opportunities, and one-on-one guidance as they take career steps toward transitioning into the Finnish workforce.
            </p>
          </div>
          <div class="about-split-visual about-split-visual--desktop">
            <img
              src="/images/about/Mission.jpg"
              alt="InterProFinland mission - International professionals receiving guidance and support"
              class="about-split-image"
              width="800"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </div>
        </article>

        <!-- Vision -->
        <article class="about-editorial-split is-reversed">
          <div class="about-split-content">
            <div class="about-service-index-badge">
              <span>Vision</span>
            </div>
            <h3 class="about-service-title">What We're Building Toward</h3>

            <!-- Mobile Image: Placed after title -->
            <div class="about-split-visual about-split-visual--mobile">
              <img
                src="/images/about/vision.webp"
                alt="InterProFinland vision - Diverse professional community thriving in Finland"
                class="about-split-image"
                width="800"
                height="500"
                loading="lazy"
                decoding="async"
              />
            </div>

            <p class="about-service-description">
              An inclusive Finland with a balanced workforce that thrives on both local and
              international expertise.
            </p>
            <p class="about-service-subdescription">
              We envision a future where international professionals seamlessly integrate into Finnish society, contributing their unique skills while the Finnish economy benefits sustainably from the diverse global expertise living here.
            </p>
          </div>
          <div class="about-split-visual about-split-visual--desktop">
            <img
              src="/images/about/vision.webp"
              alt="InterProFinland vision - Diverse professional community thriving in Finland"
              class="about-split-image"
              width="800"
              height="500"
              loading="lazy"
              decoding="async"
            />
          </div>
        </article>
      </div>
    </Container>
  </Section>

  <!-- VALUES -->
  <Section>
    <Container size="page">
      <div class="about-values-editorial-wrap">
        <div class="about-values-editorial-left">
          <span class="section-eyebrow">Our Values</span>
          <h2 class="about-values-editorial-heading">What Guides<br />Our Work</h2>
          <p class="about-values-editorial-sub">
            Five core principles that shape every decision we make and every program we create.
          </p>
          <div class="about-values-divider" aria-hidden="true"></div>
          <p class="about-values-editorial-note">
            We are an organization built on principles, not products.
          </p>
        </div>

        <ol class="about-values-list" role="list">
          {
            values.map((value) => (
              <li class="about-values-list-item">
                <div class="about-values-item-number" aria-hidden="true">{value.number}</div>
                <div class="about-values-item-body">
                  <h3 class="about-values-item-title">{value.title}</h3>
                  <p class="about-values-item-desc">{value.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </Container>
  </Section>

  <!-- WHAT WE DO -->
  <Section background="surface">
    <Container size="page">
      <div class="about-focus-section-header">
        <span class="section-eyebrow">What We Do</span>
        <h2 class="section-heading">Four Pillars of Support</h2>
        <p class="section-intro">
          Our work is organized around four interconnected focus areas that address the most
          critical challenges international professionals face in Finland.
        </p>
      </div>

      <div class="about-focus-areas-layout">
        {
          focusAreas.map((area) => (
            <article class="about-focus-card">
              <div class="about-focus-card-header">
                <div class="about-focus-index-badge">
                  <span>{area.number}</span>
                </div>
                <div class="about-focus-icon" set:html={area.icon} />
                <h3 class="about-focus-title">{area.title}</h3>
              </div>
              <p class="about-focus-desc">{area.description}</p>
            </article>
          ))
        }
      </div>

      <div class="about-focus-cta-row">
        <a href="/services" class="about-focus-cta-link">
          <span>Explore Our Services in Detail</span>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </Section>

  <!-- LEADERSHIP & TEAM -->
  <Section>
    <Container size="page">
      <div class="team-section">
        <span class="section-eyebrow">Leadership & Team</span>
        <h2 class="section-heading">The People Behind InterProFinland</h2>

        <div class="leadership-grid">
          <!-- CEO & Founder -->
          <div class="leader-card featured">
            <div class="leader-image-wrap">
              <img
                src={"/images/about/team/olivia-ceo.webp"}
                alt={leadership.ceo.name}
                width="240"
                height="240"
                loading="lazy"
                decoding="async"
                class="leader-photo"
              />
            </div>
            <div class="leader-header">
              <h3 class="leader-name">{leadership.ceo.name}</h3>
              <span class="leader-role">{leadership.ceo.role}</span>
            </div>
            <p class="leader-bio">{leadership.ceo.bio}</p>
            <div class="leader-links">
              <a
                href={`https://${leadership.ceo.website}`}
                class="leader-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit Website →
              </a>
              <a
                href={leadership.ceo.linkedin}
                class="leader-link leader-link-linkedin"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${leadership.ceo.name} on LinkedIn`}
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
                LinkedIn
              </a>
            </div>
          </div>

          <!-- Chairperson -->
          <div class="leader-card featured">
            <div class="leader-image-wrap">
              <img
                src={"/images/about/team/henriika-chairperson.webp"}
                alt={leadership.chairperson.name}
                width="240"
                height="240"
                loading="lazy"
                decoding="async"
                class="leader-photo"
              />
            </div>
            <div class="leader-header">
              <h3 class="leader-name">{leadership.chairperson.name}</h3>
              <span class="leader-role">{leadership.chairperson.role}</span>
            </div>
            <p class="leader-bio">{leadership.chairperson.bio}</p>
          </div>
        </div>

        <!-- Core Team -->
        <div class="core-team-section">
          <h3 class="team-subheading">Meet the Team</h3>
          <p class="team-intro">
            We are made up of an amazing team of staff, interns and volunteers, working either
            backstage or upfront to help bring the association's vision to light.
          </p>

          <div class="team-grid">
            {
              team.map((member) => (
                <div class="team-member-card">
                  <div class="team-member-image-wrap">
                    <img
                      src={member.image}
                      alt={member.name}
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                      class="team-member-photo"
                    />
                  </div>
                  <h4 class="member-name">{member.name}</h4>
                  <span class="member-role">{member.role}</span>
                  {member.linkedin && (
                    <a
                      href={member.linkedin}
                      class="member-linkedin"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${member.name} on LinkedIn`}
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                      </svg>
                      <span class="sr-only">LinkedIn</span>
                    </a>
                  )}
                </div>
              ))
            }
          </div>

          <div class="team-cta">
            <p class="team-cta-text">You are welcome to join the team.</p>
            <a href="/contact" class="team-cta-btn">
              <span>Get Involved</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- COMMUNITY IN ACTION -->
  <Section background="surface">
    <Container size="page">
      <div class="about-community-section-header">
        <span class="section-eyebrow">Community in Action</span>
        <h2 class="section-heading">Our Vibrant Community</h2>
        <p class="section-intro">
          Through workshops, networking events, and social gatherings, our community comes together
          to support each other's professional growth and integration in Finland.
        </p>
      </div>

      <div class="about-programs-showcase-list">
        <!-- 01 Networking -->
        <article class="about-program-showcase-card">
          <div class="about-program-showcase-content">
