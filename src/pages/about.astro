.about-focus-areas-layout {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-8);
  margin-bottom: var(--space-12);
}

.about-focus-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
  padding: var(--space-10);
  background: #ffffff;
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-lg);
  transition: all 0.3s ease;
}

.about-focus-card:hover {
  border-color: var(--color-primary-300);
  box-shadow: 0 8px 24px rgba(18, 31, 91, 0.08);
  transform: translateY(-2px);
}

.about-focus-card-header {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--color-border-subtle);
}

.about-focus-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  color: var(--color-primary-600);
  flex-shrink: 0;
  opacity: 0.8;
  transition: all 0.3s ease;
}

.about-focus-icon svg {
  width: 100%;
  height: 100%;
}

.about-focus-card:hover .about-focus-icon {
  opacity: 1;
  transform: scale(1.1);
}

.about-focus-index-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  background: #1e3a8a;
  border-radius: var(--radius-md);
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  color: #ffffff;
  flex-shrink: 0;
}

.about-focus-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: var(--font-weight-bold);
  line-height: 1.3;
  color: var(--color-text-primary);
  margin: 0;
}

.about-focus-desc {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
  margin: 0;
}

.about-focus-cta-row {
  text-align: center;
  margin-top: var(--space-12);
}

.about-focus-cta-link {
  display: inline-flex !important;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-8);
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: var(--font-weight-semibold);
  color: #1e3a8a !important;
  background: #ffd26f;
  border: 2px solid #ffd26f;
  border-radius: var(--radius-md);
  text-decoration: none;
  transition: all 0.3s ease;
}

.about-focus-cta-link:hover {
  color: #ffffff !important;
  background: #1e3a8a;
  border-color: #1e3a8a;
  transform: translateY(-1px);
}

.about-focus-cta-link .cta-arrow {
  font-size: 1.125rem;
  transition: transform 0.3s ease;
}

.about-focus-cta-link:hover .cta-arrow {
  transform: translateX(4px);
}

/* ── Values: Editorial Typography Pattern ── */
.about-values-editorial-wrap {
  display: grid;
  grid-template-columns: 1fr 1.55fr;
  gap: clamp(3rem, 7vw, 6rem);
  align-items: start;
}

.about-values-editorial-left {
  position: sticky;
  top: calc(var(--space-12, 3rem) + 80px);
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-values-editorial-heading {
  font-family: var(--font-display);
  font-size: clamp(2.25rem, 3.5vw, 3.25rem);
  font-weight: var(--font-weight-extrabold);
  line-height: 1.1;
  letter-spacing: -0.035em;
  color: var(--color-text-primary);
  margin: 0;
}

.about-values-editorial-sub {
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.65;
  color: var(--color-text-secondary);
  margin: 0;
}

.about-values-divider {
  width: 48px;
  height: 3px;
  background: #ffd26f;
  border-radius: 2px;
  margin: var(--space-2) 0;
}

.about-values-editorial-note {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-style: italic;
  line-height: 1.6;
  color: var(--color-text-tertiary);
  margin: 0;
}

.about-values-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
}

.about-values-list-item {
  display: grid;
  grid-template-columns: 3.5rem 1fr;
  gap: var(--space-6);
  align-items: start;
  padding: var(--space-8) 0;
  border-bottom: 1px solid var(--color-border-subtle);
  transition: background 0.25s ease;
}

.about-values-list-item:first-child {
  border-top: 1px solid var(--color-border-subtle);
  padding-top: var(--space-8);
}

.about-values-list-item:hover .about-values-item-number {
  color: var(--color-primary-700);
}

.about-values-item-number {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 2.5vw, 2rem);
  font-weight: var(--font-weight-extrabold);
  color: rgba(30, 58, 138, 0.18);
  line-height: 1;
  padding-top: 0.2em;
  transition: color 0.3s ease;
  user-select: none;
}

.about-values-item-body {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding-bottom: var(--space-2);
}

.about-values-item-title {
  font-family: var(--font-display);
  font-size: clamp(1.2rem, 1.6vw, 1.5rem);
  font-weight: var(--font-weight-bold);
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
  margin: 0;
  transition: color 0.25s ease;
}

.about-values-list-item:hover .about-values-item-title {
  color: var(--color-primary-700);
}

.about-values-item-desc {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  line-height: 1.72;
  color: var(--color-text-secondary);
  margin: 0;
}

/* ── Recognition: Degree AMPLIFY Pattern ── */
.about-recognition-showcase {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(2.5rem, 5vw, 4.5rem);
  align-items: center;
  padding: var(--space-10) var(--space-8);
  background: linear-gradient(145deg, #131f5b 0%, #0a1133 100%);
  border: 1.5px solid rgba(255, 210, 111, 0.35);
  border-radius: var(--radius-xl, 20px);
  box-shadow:
    0 16px 48px -12px rgba(18, 31, 91, 0.35),
    0 6px 16px -4px rgba(18, 31, 91, 0.25),
    inset 0 -1px 0 rgba(255, 255, 255, 0.08);
}

.about-recognition-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-recognition-badge-wrap {
  margin-bottom: var(--space-2);
}

.about-recognition-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  background-color: rgba(255, 210, 111, 0.18);
  border: 1.5px solid rgba(255, 210, 111, 0.45);
  border-radius: 999px;
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #ffd26f;
}

.about-recognition-showcase .section-eyebrow {
  color: rgba(255, 210, 111, 0.95);
}

.about-recognition-summary {
  font-family: var(--font-body);
  font-size: 1.0625rem;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.95);
  margin: 0;
}

/* Override section-heading styles for dark background in recognition section */
.about-recognition-showcase .section-heading {
  color: var(--color-white);
  text-align: left;
}

.about-recognition-showcase .section-eyebrow {
  color: var(--color-white);
}

.about-recognition-showcase .section-eyebrow::before,
.about-recognition-showcase .section-eyebrow::after {
  background-color: rgba(255, 210, 111, 0.6);
}

.about-recognition-body {
  font-family: var(--font-body);
  font-size: 0.96875rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.75);
  margin: 0;
}

.about-recognition-actions {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-top: var(--space-2);
}

.btn-about-recognition {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-6);
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary-900);
  background-color: #ffd26f;
  border: none;
  border-radius: var(--radius-md);
  text-decoration: none;
  transition:
    background-color 240ms ease,
    transform 240ms ease,
    box-shadow 240ms ease;
}

.btn-about-recognition:hover {
  background-color: #ffdc8f;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px -6px rgba(255, 210, 111, 0.45);
}

.about-recognition-visual {
  position: relative;
}

.about-recognition-media-frame {
  position: relative;
  aspect-ratio: 4 / 2.5;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.04);
  padding: var(--space-4);
  border: 1.5px solid rgba(255, 255, 255, 0.12);
}

.about-recognition-img {
  width: 100%;
  height: auto;
  border-radius: var(--radius-md);
  box-shadow:
    0 16px 48px -12px rgba(0, 0, 0, 0.4),
    0 6px 16px -4px rgba(0, 0, 0, 0.3);
  transition: transform 580ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-recognition-showcase:hover .about-recognition-img {
  transform: translateY(-4px) scale(1.01);
}

.about-recognition-media-caption {
  display: block;
  margin-top: var(--space-3);
  font-family: var(--font-body);
  font-size: 0.8125rem;
  font-weight: var(--font-weight-medium);
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
}

/* ── Partnership Ecosystem Section ── */
.partners-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-10);
  text-align: center;
  width: 100%;
}

.partners-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  max-width: 720px;
}

.partners-intro {
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
  max-width: 68ch;
  margin: 0 auto;
}

/* Side-by-side row for smaller category blocks */
.partners-secondary-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-6);
  width: 100%;
}

/* Category Block — full width, bordered */
.partners-category-block {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  padding: var(--space-8) var(--space-10);
  background: var(--color-white);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-lg);
  text-align: left;
}

.partners-category-label {
  display: flex;
  align-items: flex-start;
  gap: var(--space-4);
  padding-bottom: var(--space-6);
  border-bottom: 1px solid var(--color-border-subtle);
}

.partners-cat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  min-width: 48px;
  font-size: 1.5rem;
  background: var(--color-primary-50);
  border-radius: var(--radius-md);
  line-height: 1;
}

.partners-cat-title {
  font-family: var(--font-display);
  font-size: 1.125rem;
  font-weight: var(--font-weight-bold);
  line-height: 1.3;
  color: var(--color-text-primary);
  margin: 0 0 var(--space-1) 0;
}

.partners-cat-desc {
  font-family: var(--font-body);
  font-size: 0.875rem;
  line-height: 1.55;
  color: var(--color-text-tertiary);
  margin: 0;
}

/* Logo row — featured (European / Educational): fewer, bigger tiles */
.partner-logos-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
}

.partner-logos-row--featured {
  gap: var(--space-5);
}

.partner-logos-row--grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: var(--space-4);
}

/* Logo Tile */
.partner-logo-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-5);
  background: var(--color-bg-surface);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-md);
  transition: all 0.28s ease;
  min-width: 130px;
}

.partner-logos-row--featured .partner-logo-tile {
  min-width: 170px;
  padding: var(--space-5) var(--space-7);
}

.partner-logo-tile:hover {
  border-color: var(--color-primary-300);
  box-shadow: 0 4px 16px rgba(18, 31, 91, 0.08);
  transform: translateY(-2px);
}

.partner-logo-img {
  max-height: 44px;
  max-width: 120px;
  width: auto;
  object-fit: contain;
  filter: grayscale(15%) opacity(0.9);
  transition: filter 0.28s ease;
}

.partner-logos-row--featured .partner-logo-img {
  max-height: 56px;
  max-width: 150px;
}

.partner-logo-tile:hover .partner-logo-img {
  filter: grayscale(0%) opacity(1);
}

.partner-logo-name {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-tertiary);
  text-align: center;
  line-height: 1.3;
}

.partners-footer-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  padding-top: var(--space-8);
  border-top: 1.5px solid var(--color-border-subtle);
  width: 100%;
}

.partners-footer-text {
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin: 0;
}

.partners-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-8);
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: var(--font-weight-semibold);
  color: #1e3a8a;
  background: #ffd26f;
  border: 2px solid #ffd26f;
  border-radius: var(--radius-md);
  text-decoration: none;
  transition: all 0.3s ease;
}

.partners-cta-btn:hover {
  color: #ffffff;
  background: #1e3a8a;
  border-color: #1e3a8a;
  transform: translateY(-1px);
}

/* ── Story: Purpose Manifesto Pattern ── */
.about-story-manifesto {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: clamp(3rem, 6vw, 5.5rem);
  align-items: center;
}

.about-story-left {
  position: relative;
  display: flex;
  justify-content: center;
}

.about-story-image-wrap {
  position: relative;
  border-radius: var(--radius-lg, 16px);
  overflow: hidden;
  aspect-ratio: 4 / 5;
  width: 100%;
  max-width: 440px;
  background-color: var(--color-bg-surface);
  box-shadow:
    0 12px 32px -8px rgba(18, 31, 91, 0.15),
    0 4px 12px -2px rgba(18, 31, 91, 0.08);
}

.about-story-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top center;
  transition: transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-story-image-wrap:hover .about-story-img {
  transform: scale(1.03);
}

.about-story-right {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

/* Override for story section - left-aligned text in 2-column layout */
.about-story-manifesto .section-heading {
  text-align: left;
}

.about-story-serif {
  font-family: var(--font-body);
  font-style: italic;
  font-weight: var(--font-weight-regular);
  color: var(--color-primary-600);
}

.about-story-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-story-text {
  font-family: var(--font-body);
  font-size: 0.96875rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
  margin: 0;
}

.about-story-action {
  margin-top: var(--space-2);
}

.about-story-cta-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary-700);
  text-decoration: none;
  transition: gap 280ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.about-story-cta-link:hover {
  gap: var(--space-3);
}

.about-story-cta-link .cta-arrow {
  font-size: 1.125rem;
  transition: transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.about-story-cta-link:hover .cta-arrow {
  transform: translateX(4px);
}

/* ── Videos Section ── */
.about-videos-section-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-10);
  text-align: center;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.about-videos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: var(--space-8);
}

.about-video-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-video-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 aspect ratio */
  border-radius: var(--radius-lg);
  overflow: hidden;
  background-color: var(--color-gray-100);
  box-shadow:
    0 12px 32px -8px rgba(18, 31, 91, 0.12),
    0 4px 12px -2px rgba(18, 31, 91, 0.06);
}

.about-video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

.about-video-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.about-video-title {
  font-family: var(--font-display);
  font-size: 1.125rem;
  font-weight: var(--font-weight-bold);
  line-height: 1.3;
  color: var(--color-text-primary);
  margin: 0;
}

.about-video-desc {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
}

/* ── Community: Program Showcase Pattern ── */
.about-community-section-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-12);
  text-align: center;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.about-programs-showcase-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-16);
}

.about-program-showcase-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2.5rem, 5vw, 4rem);
  align-items: center;
  padding: var(--space-8) 0;
  border-top: 1px solid var(--color-border-subtle);
}

.about-program-showcase-card:first-child {
  border-top: 1px solid var(--color-border-subtle);
}

.about-program-showcase-card.is-reversed {
  grid-template-columns: 1fr 1fr;
}

.about-program-showcase-card.is-reversed .about-program-showcase-media {
  order: 2;
}

.about-program-showcase-card.is-reversed .about-program-showcase-content {
  order: 1;
}

.about-program-showcase-media {
  position: relative;
  aspect-ratio: 4 / 2.5;
  width: 100%;
  max-width: 100%;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow:
    0 12px 32px -8px rgba(18, 31, 91, 0.12),
    0 4px 12px -2px rgba(18, 31, 91, 0.06);
  transition:
    transform 480ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 480ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-program-showcase-card.is-reversed .about-program-showcase-media {
  justify-self: end;
}

.about-program-showcase-card:hover .about-program-showcase-media {
  transform: translateY(-3px);
  box-shadow:
    0 20px 48px -12px rgba(18, 31, 91, 0.18),
    0 8px 20px -4px rgba(18, 31, 91, 0.1);
}

.about-program-showcase-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-program-showcase-card:hover .about-program-showcase-img {
  transform: scale(1.02);
}

.about-program-showcase-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-program-header-meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.about-program-index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
