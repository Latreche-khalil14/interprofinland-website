---
/**
 * About Page — InterProFinland
 * Who we are, our mission, and how we support international professionals
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import CtaSection from '@/components/sections/CtaSection.astro';

/* ── Core Values ── */
const values = [
  {
    number: '01',
    title: 'Potentiality',
    description:
      'We believe that there is an inherent ability in every single one of us which can be nurtured and developed to the fullest capacity.',
  },
  {
    number: '02',
    title: 'Recognition',
    description:
      'We believe that all humans deserve to be seen in the totality of their existence, not just in the fragment of the present, but as an entity with a past, skills, and identity that should be recognised.',
  },
  {
    number: '03',
    title: 'Professionalism',
    description:
      'We believe that underutilization of professional skills and training amounts to brain waste, and that harnessing the skills and talents inherent in a society enriches its economy.',
  },
  {
    number: '04',
    title: 'Growth',
    description:
      'We believe that Growth is a natural occurrence which is vital to human existence and wellbeing, and that everyone deserves a chance to grow professionally, economically, and in other areas they need to grow in.',
  },
  {
    number: '05',
    title: 'Inclusion',
    description:
      'We believe that a society is at its best if all who live within it are carried along in all areas, with none left devoid of the feeling of belongingness.',
  },
];

/* ── Impact Statistics ── */
const impact = [
  { number: '1,800+', label: 'Community Members' },
  { number: '80+', label: 'Professions Represented' },
  { number: '74', label: 'Nationalities' },
  { number: '2021', label: 'Established' },
];

/* ── Team Members ── */
const leadership = {
  chairperson: {
    name: 'Henriika Ilkko',
    role: 'Chairperson',
    bio: "Henriika has successfully led numerous projects and excelled in IT, Quality Management and Project Management Office (PMO) functions in her impressive career. In her role as Chairperson, Henriika plays a crucial role in guiding our organization's strategic direction, fostering growth, and ensuring continued excellence in all our endeavors.",
    image: '/images/people/team/henriika-ilkko-chairperson.webp',
  },
  ceo: {
    name: 'Olivia Kumpula',
    role: 'CEO & Founder',
    bio: 'Olivia founded InterProFinland after experiencing firsthand the challenges international professionals face in Finland. Through her expat blog and YouTube channel "My Finland Story," she documented integration experiences and realized that many internationals encounter similar barriers in utilizing their skills and transitioning into the Finnish workforce.',
    website: 'www.oliviakumpula.com',
    image: '/images/people/team/olivia-kumpula-ceo.webp',
    linkedin: 'https://www.linkedin.com/in/oliviakumpula',
  },
};

const team = [
  {
    name: 'Matthew Bowen',
    role: 'CAO',
    image: '/images/people/team/matthew-bowen-cao.webp',
    linkedin: 'https://www.linkedin.com/in/matthew-j-bowen',
  },
  {
    name: 'Meha Bouazizi',
    role: 'Media / Marketing',
    image: '/images/people/team/meha-bouazizi-media-marketing.webp',
    linkedin: 'https://www.linkedin.com/in/meha-bouazizi',
  },
  {
    name: 'Temitope Popoola',
    role: 'Funding / Project Coordinator',
    image: '/images/people/team/temitope-popoola-funding-coordinator.webp',
    linkedin: 'https://www.linkedin.com/in/popoola-temitope',
  },
  {
    name: 'Bruna Eklund',
    role: 'Project & Event Coordinator',
    image: '/images/people/team/bruna-eklund-event-coordinator.webp',
  },
  {
    name: 'Pooja Mattoo',
    role: 'Kielikaverit (Language Club) Coordinator',
    image: '/images/people/team/pooja-mattoo-language-coordinator.webp',
  },
  {
    name: 'Gabriel Ebah',
    role: 'Facilitator, Media & Marketing (Volunteer)',
    image: '/images/people/team/gabriel-ebah-facilitator.webp',
  },
];

/* ── Key Focus Areas ── */
const focusAreas = [
  {
    title: 'Bridging Qualification Gaps',
    description:
      'Navigating the Finnish qualification recognition process is complex. We provide step-by-step guidance through OPH, Valvira, and other competent authorities, helping professionals validate their international credentials.',
  },
  {
    title: 'Building Professional Networks',
    description:
      'Access to the right connections transforms career trajectories. Through mentorship matching, industry events, and community clubs, we create opportunities for meaningful professional relationships.',
  },
  {
    title: 'Understanding Finnish Work Culture',
    description:
      'Success in Finland requires more than qualifications. We help professionals understand Finnish workplace expectations, communication styles, and cultural nuances that make the difference.',
  },
  {
    title: 'Creating Pathways to Employment',
    description:
      'From labour market orientation to job search strategies, we support professionals in identifying opportunities that match their expertise and building careers that reflect their true potential.',
  },
];

/* ── Partnership Ecosystem ── */
const partnerCategories = [
  {
    category: 'European Networks',
    description: 'Connected to innovation and inclusion initiatives across Europe',
    icon: '🇪🇺',
    partners: ['ENIIE (European Network of Innovation for Inclusion)', 'EURES Finland'],
  },
  {
    category: 'Educational Institutions',
    description: 'Collaborating with universities and applied sciences institutions',
    icon: '🎓',
    partners: ['Satakunta University of Applied Sciences (SAMK)'],
  },
  {
    category: 'Regional Organizations',
    description: 'Working with local communities and support networks',
    icon: '🤝',
    partners: ['Moniheli ry', 'Nicehearts ry', 'Satakunnan Monikulttuuriyhdistys (SMY)'],
  },
];
---

<Layout
  title="About InterProFinland — Supporting International Talent Integration"
  description="Learn about InterProFinland's mission to support international professionals in Finland through individualized guidance, mentorship, qualification recognition, and community building."
>
  <!-- ══════════════════════════════════
       HERO SECTION
       ══════════════════════════════════ -->
  <Section>
    <Container size="page">
      <div class="about-hero">
        <div class="about-hero-text">
          <div class="hero-eyebrow-wrap">
            <span class="hero-eyebrow">About InterProFinland</span>
          </div>
          <h1 class="about-hero-heading">
            Empowering International Professionals to Thrive in
            <span class="accent-text">Finland</span>
          </h1>
          <p class="about-hero-lead">
            We are a support network dedicated to helping international professionals overcome
            barriers, validate their qualifications, and build meaningful careers in the Finnish
            labour market.
          </p>

          <!-- Impact Stats Row -->
          <div class="impact-stats-row">
            {
              impact.map((stat) => (
                <div class="impact-stat">
                  <strong class="impact-number">{stat.number}</strong>
                  <span class="impact-label">{stat.label}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="about-hero-media">
          <img
            src="/images/events/kielikaverit/kieli-kaverit-1.webp"
            alt="InterProFinland community members at a networking event"
            width="600"
            height="450"
            loading="eager"
            decoding="async"
            class="about-hero-img"
          />
        </div>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       MISSION & VISION
       ══════════════════════════════════ -->
  <Section background="surface">
    <Container size="content">
      <div class="mission-vision-block">
        <div class="mission-section">
          <span class="section-eyebrow">Our Mission</span>
          <h2 class="mission-heading">Why We Exist</h2>
          <p class="mission-statement">
            Providing a support network and tailored guidance to help international professionals in
            Finland overcome barriers, utilize their skills, and build meaningful careers.
          </p>
        </div>

        <div class="vision-section">
          <span class="section-eyebrow">Our Vision</span>
          <h2 class="vision-heading">What We're Building Toward</h2>
          <p class="vision-statement">
            An inclusive Finland with a balanced workforce that thrives on both local and
            international expertise.
          </p>
        </div>

        <div class="what-we-do-section">
          <h3 class="what-heading">What We Do</h3>
          <p class="what-body">
            Through a diverse range of programs and services, we assist international professionals
            qualified for a profession abroad to overcome obstacles hindering them from utilizing
            their skills in Finland. We provide customised support as well as mentorship and
            networking opportunities. We also offer one-on-one guidance as they take huge career
            steps toward transitioning into the Finnish workforce and advancing their skillset to
            contribute to the society they now call home.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       WHAT WE DO (FOCUS AREAS)
       ══════════════════════════════════ -->
  <Section>
    <Container size="page">
      <div class="focus-section-header">
        <span class="section-eyebrow">What We Do</span>
        <h2 class="section-heading">Four Pillars of Support</h2>
        <p class="section-intro">
          Our work is organized around four interconnected focus areas that address the most
          critical challenges international professionals face in Finland.
        </p>
      </div>

      <div class="focus-areas-grid">
        {
          focusAreas.map((area, idx) => (
            <article class="focus-area-card">
              <div class="focus-index" aria-hidden="true">
                {String(idx + 1).padStart(2, '0')}
              </div>
              <h3 class="focus-title">{area.title}</h3>
              <p class="focus-desc">{area.description}</p>
            </article>
          ))
        }
      </div>

      <div class="focus-cta-row">
        <a href="/services" class="focus-cta-link">
          <span>Explore Our Services in Detail</span>
          <span class="cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       VALUES
       ══════════════════════════════════ -->
  <Section background="primary-tint">
    <Container size="page">
      <div class="values-header">
        <span class="section-eyebrow">Our Values</span>
        <h2 class="section-heading">What Guides Our Work</h2>
      </div>

      <div class="values-grid">
        {
          values.map((value) => (
            <div class="value-card">
              <h3 class="value-title" data-number={value.number}>
                {value.title}
              </h3>
              <p class="value-desc">{value.description}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       RECOGNITION & ACHIEVEMENTS
       ══════════════════════════════════ -->
  <Section background="surface">
    <Container size="page">
      <div class="recognition-card">
        <div class="recognition-content">
          <span class="section-eyebrow">Recognition</span>
          <h2 class="recognition-heading">European Good Practice Recognition</h2>
          <p class="recognition-lead">
            Our flagship Degree AMPLIFY project was recognized as a Finalist in the VII Call for
            Good Practices by the European Network of Innovation for Inclusion (ENIIE) in Madrid
            2023.
          </p>
          <p class="recognition-body">
            This recognition highlights our innovative approach to supporting international
            professionals through the foreign diploma recognition process. Degree AMPLIFY provides
            structured guidance through OPH, Valvira, and other competent authorities, with
            mentorship from professionals who have successfully navigated the process themselves.
          </p>
          <div class="recognition-actions">
            <a href="/projects/degree-amplify" class="btn-recognition">
              <span>Learn About Degree AMPLIFY</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="recognition-media">
          <img
            src="/images/projects/degree-amplify/degree-amplify-finalist.webp"
            alt="Degree AMPLIFY European Good Practice Finalist Certificate"
            width="480"
            height="380"
            loading="lazy"
            decoding="async"
            class="recognition-img"
          />
          <div class="recognition-badge">
            <span class="badge-icon">🏆</span>
            <span class="badge-text">ENIIE Madrid 2023 · European Finalist</span>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       PARTNERSHIP ECOSYSTEM
       ══════════════════════════════════ -->
  <Section>
    <Container size="page">
      <div class="partners-section">
        <span class="section-eyebrow">Partnership & Collaboration</span>
        <h2 class="section-heading">Building an Ecosystem of Support</h2>
        <p class="partners-intro">
          We collaborate with educational institutions, European networks, regional organizations,
          and community groups to create a comprehensive support ecosystem for international
          professionals in Finland.
        </p>

        <div class="partner-categories-grid">
          {
            partnerCategories.map((category) => (
              <article class="partner-card">
                <div class="partner-card-header">
                  <span class="partner-icon" aria-hidden="true">
                    {category.icon}
                  </span>
                  <h3 class="partner-category-title">{category.category}</h3>
                </div>
                <p class="partner-category-desc">{category.description}</p>
                <ul class="partner-list">
                  {category.partners.map((partner) => (
                    <li class="partner-item">{partner}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>

        <div class="partners-footer-cta">
          <p class="partners-footer-text">Interested in partnering with us?</p>
          <a href="/contact" class="partners-cta-btn">
            <span>Contact Our Team</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       OUR STORY
       ══════════════════════════════════ -->
  <Section background="surface">
    <Container size="content">
      <div class="story-block">
        <span class="section-eyebrow">Our Story</span>
        <h2 class="section-heading">How InterProFinland Began</h2>

        <div class="story-content">
          <p class="story-text">
            When our founder, <strong>Olivia Kumpula</strong>, moved to Finland, she spent the first
            few years trying to find her place in her new home country. Through her expat blog and
            YouTube channel, <em>'My Finland Story'</em>, she documented her life and experiences in
            Finland and shared tips for integrating into Finland's society and culture.
          </p>

          <p class="story-text">
            She also started an interactive club on Clubhouse called <em
              >'The Finns and Foreigners Club'</em
            >. Through connections made in the club, she realized that almost all international
            professionals encounter similar challenges which hinder them from utilizing their skills
            and transitioning into the Finnish workforce.
          </p>

          <p class="story-text">
            Although a number of resources are available, many internationals still have trouble
            locating these resources and applying them to their personal situations. In <strong
              >2021</strong
            >, Olivia assembled a team of professionals and <strong
              >International Professionals Finland ry</strong
            > was established.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       ABOUT US IN 60 SECONDS (VIDEOS)
       ══════════════════════════════════ -->
  <Section>
    <Container size="page">
      <div class="videos-section">
        <span class="section-eyebrow">Watch & Learn</span>
        <h2 class="section-heading">About us in 60 seconds</h2>
        <p class="videos-intro">
          Get to know InterProFinland in just one minute. Watch our introduction in English or
          Finnish.
        </p>

        <div class="videos-grid">
          <!-- English Video -->
          <div class="video-card">
            <div class="video-wrapper">
              <iframe
                src="https://www.youtube.com/embed/xKP1M4A2f9E?si=rE0a1cgwVC-w_e1_"
                title="InterProFinland Introduction - English"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="video-info">
              <h3 class="video-title">In English</h3>
              <p class="video-desc">Learn about our mission, services, and impact in English.</p>
            </div>
          </div>

          <!-- Finnish Video -->
          <div class="video-card">
            <div class="video-wrapper">
              <iframe
                src="https://www.youtube.com/embed/NwLTtirsWUk?si=EBN5aHnQV6DdiChY"
                title="InterProFinland Introduction - Finnish"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="video-info">
              <h3 class="video-title">Suomeksi (In Finnish)</h3>
              <p class="video-desc">
                Tutustu tehtäväämme, palveluihimme ja vaikutukseemme suomeksi.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       LEADERSHIP & TEAM
       ══════════════════════════════════ -->
  <!-- ══════════════════════════════════
       COMMUNITY IN ACTION GALLERY
       ══════════════════════════════════ -->
  <Section background="surface">
    <Container size="page">
      <div class="community-gallery-header">
        <span class="section-eyebrow">Community in Action</span>
        <h2 class="section-heading">Our Vibrant Community</h2>
        <p class="section-intro">
          Through workshops, networking events, and social gatherings, our community comes together
          to support each other's professional growth and integration in Finland.
        </p>
      </div>

      <div class="about-community-showcase-list">
        <article class="about-community-showcase-card">
          <div class="about-community-media">
            <img
              src="/images/community/gatherings/community-2.webp"
              alt="InterProFinland community networking event"
              class="about-community-img"
              width="540"
              height="380"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="about-community-content">
            <div class="about-community-meta">
              <span class="about-community-index">01</span>
            </div>
            <h3 class="about-community-title">Networking & Professional Events</h3>
            <p class="about-community-desc">
              Regular networking sessions where international professionals connect with peers,
              mentors, and industry experts to build meaningful professional relationships and expand
              their career opportunities in Finland.
            </p>
          </div>
        </article>

        <article class="about-community-showcase-card is-reversed">
          <div class="about-community-media">
            <img
              src="/images/community/gatherings/community-3.webp"
              alt="Professional networking at InterProFinland event"
              class="about-community-img"
              width="540"
              height="380"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="about-community-content">
            <div class="about-community-meta">
              <span class="about-community-index">02</span>
            </div>
            <h3 class="about-community-title">Collaborative Workshops & Skill Building</h3>
            <p class="about-community-desc">
              Interactive workshops focused on professional development, job search strategies, and
              navigating the Finnish labour market. Learn practical skills in supportive group
              environments.
            </p>
          </div>
        </article>

        <article class="about-community-showcase-card">
          <div class="about-community-media">
            <img
              src="/images/community/gatherings/community-4.webp"
              alt="Community members at InterProFinland gathering"
              class="about-community-img"
              width="540"
              height="380"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="about-community-content">
            <div class="about-community-meta">
              <span class="about-community-index">03</span>
            </div>
            <h3 class="about-community-title">Social Gatherings & Cultural Integration</h3>
            <p class="about-community-desc">
              Relaxed social events that help build lasting friendships beyond professional
              connections. From picnics to cultural celebrations, we create spaces where community
              members feel at home.
            </p>
          </div>
        </article>
      </div>

      <div class="about-community-cta">
        <a href="/community" class="about-community-btn">
          <span>Join Our Community Activities</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       LEADERSHIP & TEAM
       ══════════════════════════════════ -->
  <Section>
    <Container size="page">
      <div class="team-section">
        <span class="section-eyebrow">Leadership & Team</span>
        <h2 class="section-heading">The People Behind InterProFinland</h2>

        <!-- Leadership Profiles -->
        <div class="leadership-grid">
          <!-- CEO & Founder -->
          <div class="leader-card featured">
            <div class="leader-image-wrap">
              <img
                src={leadership.ceo.image}
                alt={leadership.ceo.name}
                width="240"
                height="240"
                loading="lazy"
                decoding="async"
                class="leader-photo"
              />
            </div>
            <div class="leader-header">
              <h3 class="leader-name">{leadership.ceo.name}</h3>
              <span class="leader-role">{leadership.ceo.role}</span>
            </div>
            <p class="leader-bio">{leadership.ceo.bio}</p>
            <div class="leader-links">
              <a
                href={`https://${leadership.ceo.website}`}
                class="leader-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                Visit Website →
              </a>
              <a
                href={leadership.ceo.linkedin}
                class="leader-link leader-link-linkedin"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${leadership.ceo.name} on LinkedIn`}
              >
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
                  />
                </svg>
                LinkedIn
              </a>
            </div>
          </div>

          <!-- Chairperson -->
          <div class="leader-card featured">
            <div class="leader-image-wrap">
              <img
                src={leadership.chairperson.image}
                alt={leadership.chairperson.name}
                width="240"
                height="240"
                loading="lazy"
                decoding="async"
                class="leader-photo"
              />
            </div>
            <div class="leader-header">
              <h3 class="leader-name">{leadership.chairperson.name}</h3>
              <span class="leader-role">{leadership.chairperson.role}</span>
            </div>
            <p class="leader-bio">{leadership.chairperson.bio}</p>
          </div>
        </div>

        <!-- Core Team -->
        <div class="core-team-section">
          <h3 class="team-subheading">Meet the Team</h3>
          <p class="team-intro">
            We are made up of an amazing team of staff, interns and volunteers, working either
            backstage or upfront to help bring the association's vision to light.
          </p>

          <div class="team-grid">
            {
              team.map((member) => (
                <div class="team-member-card">
                  <div class="team-member-image-wrap">
                    <img
                      src={member.image}
                      alt={member.name}
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                      class="team-member-photo"
                    />
                  </div>
                  <h4 class="member-name">{member.name}</h4>
                  <span class="member-role">{member.role}</span>
                  {member.linkedin && (
                    <a
                      href={member.linkedin}
                      class="member-linkedin"
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${member.name} on LinkedIn`}
                    >
                      <svg
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="currentColor"
                        aria-hidden="true"
                      >
