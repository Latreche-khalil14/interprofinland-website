  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 800;
  color: var(--color-white);
  margin-bottom: var(--space-4);
}

.about-value-title {
  font-family: var(--font-display);
  font-size: 1.375rem;
  font-weight: var(--font-weight-bold);
  line-height: 1.3;
  letter-spacing: -0.015em;
  color: var(--color-text-primary);
  margin: 0 0 var(--space-3) 0;
}

.about-value-description {
  font-family: var(--font-body);
  font-size: 0.96875rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
  margin: 0;
}

/* ── Recognition: Degree AMPLIFY Pattern ── */
.about-recognition-showcase {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: clamp(2.5rem, 5vw, 4.5rem);
  align-items: center;
  padding: var(--space-10) var(--space-8);
  background: linear-gradient(145deg, #131f5b 0%, #0a1133 100%);
  border: 1.5px solid rgba(255, 210, 111, 0.35);
  border-radius: var(--radius-xl, 20px);
  box-shadow:
    0 16px 48px -12px rgba(18, 31, 91, 0.35),
    0 6px 16px -4px rgba(18, 31, 91, 0.25),
    inset 0 -1px 0 rgba(255, 255, 255, 0.08);
}

.about-recognition-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-recognition-badge-wrap {
  margin-bottom: var(--space-2);
}

.about-recognition-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) var(--space-4);
  background-color: rgba(255, 210, 111, 0.18);
  border: 1.5px solid rgba(255, 210, 111, 0.45);
  border-radius: 999px;
  font-family: var(--font-display);
  font-size: 0.8125rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #ffd26f;
}

.about-recognition-showcase .section-eyebrow {
  color: rgba(255, 210, 111, 0.95);
}

.about-recognition-heading {
  font-family: var(--font-display);
  font-size: clamp(1.65rem, 2.6vw, 2.15rem);
  font-weight: var(--font-weight-extrabold);
  line-height: 1.18;
  letter-spacing: -0.025em;
  color: var(--color-white);
  margin: 0;
}

.about-recognition-summary {
  font-family: var(--font-body);
  font-size: 1.0625rem;
  line-height: 1.65;
  color: rgba(255, 255, 255, 0.95);
  margin: 0;
}

.about-recognition-body {
  font-family: var(--font-body);
  font-size: 0.96875rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.75);
  margin: 0;
}

.about-recognition-actions {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-top: var(--space-2);
}

.btn-about-recognition {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-6);
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary-900);
  background-color: #ffd26f;
  border: none;
  border-radius: var(--radius-md);
  text-decoration: none;
  transition:
    background-color 240ms ease,
    transform 240ms ease,
    box-shadow 240ms ease;
}

.btn-about-recognition:hover {
  background-color: #ffdc8f;
  transform: translateY(-2px);
  box-shadow: 0 8px 24px -6px rgba(255, 210, 111, 0.45);
}

.about-recognition-visual {
  position: relative;
}

.about-recognition-media-frame {
  position: relative;
  border-radius: var(--radius-lg);
  overflow: hidden;
  background-color: rgba(255, 255, 255, 0.04);
  padding: var(--space-4);
  border: 1.5px solid rgba(255, 255, 255, 0.12);
}

.about-recognition-img {
  width: 100%;
  height: auto;
  border-radius: var(--radius-md);
  box-shadow:
    0 16px 48px -12px rgba(0, 0, 0, 0.4),
    0 6px 16px -4px rgba(0, 0, 0, 0.3);
  transition: transform 580ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-recognition-showcase:hover .about-recognition-img {
  transform: translateY(-4px) scale(1.01);
}

.about-recognition-media-caption {
  display: block;
  margin-top: var(--space-3);
  font-family: var(--font-body);
  font-size: 0.8125rem;
  font-weight: var(--font-weight-medium);
  text-align: center;
  color: rgba(255, 255, 255, 0.6);
}

/* ── Partnership Section ── */
.partners-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
  text-align: center;
}

.partners-intro {
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.65;
  color: var(--color-text-secondary);
  max-width: 70ch;
  margin: 0 auto var(--space-8) auto;
}

.partner-categories-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: var(--space-6);
  text-align: left;
}

.partner-card {
  padding: var(--space-8);
  background-color: var(--color-white);
  border: 1.5px solid var(--color-border-default);
  border-radius: var(--radius-lg);
  transition:
    transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 280ms cubic-bezier(0.22, 1, 0.36, 1),
    border-color 280ms ease;
}

.partner-card:hover {
  transform: translateY(-4px);
  box-shadow:
    0 16px 48px -12px rgba(18, 31, 91, 0.16),
    0 6px 16px -4px rgba(18, 31, 91, 0.08);
  border-color: var(--color-primary-300);
}

.partner-card-header {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

.partner-icon {
  font-size: 1.75rem;
  line-height: 1;
}

.partner-category-title {
  font-family: var(--font-display);
  font-size: 1.125rem;
  font-weight: var(--font-weight-bold);
  line-height: 1.3;
  color: var(--color-text-primary);
  margin: 0;
}

.partner-category-desc {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--color-text-tertiary);
  margin: 0 0 var(--space-4) 0;
}

.partner-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.partner-item {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--color-text-secondary);
  padding-left: var(--space-5);
  position: relative;
}

.partner-item::before {
  content: '→';
  position: absolute;
  left: 0;
  color: var(--color-primary-500);
  font-weight: 600;
}

.partners-footer-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-4);
  margin-top: var(--space-6);
  padding-top: var(--space-8);
  border-top: 1.5px solid var(--color-border-subtle);
}

.partners-footer-text {
  font-family: var(--font-body);
  font-size: 1rem;
  font-weight: var(--font-weight-medium);
  color: var(--color-text-secondary);
  margin: 0;
}

.partners-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-6);
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: var(--font-weight-semibold);
  color: var(--color-white);
  background: linear-gradient(135deg, var(--color-primary-500) 0%, var(--color-primary-600) 100%);
  border: none;
  border-radius: var(--radius-md);
  text-decoration: none;
  transition:
    transform 240ms ease,
    box-shadow 240ms ease;
}

.partners-cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px -6px rgba(18, 31, 91, 0.35);
}

/* ── Story: Purpose Manifesto Pattern ── */
.about-story-manifesto {
  display: grid;
  grid-template-columns: 0.85fr 1.15fr;
  gap: clamp(3rem, 6vw, 5.5rem);
  align-items: center;
}

.about-story-left {
  position: relative;
}

.about-story-image-wrap {
  position: relative;
  border-radius: var(--radius-lg, 16px);
  overflow: hidden;
  aspect-ratio: 4 / 5;
  box-shadow:
    0 12px 32px -8px rgba(18, 31, 91, 0.15),
    0 4px 12px -2px rgba(18, 31, 91, 0.08);
}

.about-story-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-story-image-wrap:hover .about-story-img {
  transform: scale(1.04);
}

.about-story-right {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-story-title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 2.8vw, 2.35rem);
  font-weight: var(--font-weight-extrabold);
  line-height: 1.18;
  letter-spacing: -0.025em;
  color: var(--color-text-primary);
  margin: 0;
}

.about-story-serif {
  font-family: var(--font-body);
  font-style: italic;
  font-weight: var(--font-weight-regular);
  color: var(--color-primary-600);
}

.about-story-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-story-text {
  font-family: var(--font-body);
  font-size: 0.96875rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
  margin: 0;
}

.about-story-action {
  margin-top: var(--space-2);
}

.about-story-cta-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: var(--font-weight-semibold);
  color: var(--color-primary-700);
  text-decoration: none;
  transition: gap 280ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.about-story-cta-link:hover {
  gap: var(--space-3);
}

.about-story-cta-link .cta-arrow {
  font-size: 1.125rem;
  transition: transform 280ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.about-story-cta-link:hover .cta-arrow {
  transform: translateX(4px);
}

/* ── Videos Section ── */
.about-videos-section-header {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-bottom: var(--space-10);
  text-align: center;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.about-videos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: var(--space-8);
}

.about-video-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-video-wrapper {
  position: relative;
  width: 100%;
  padding-bottom: 56.25%; /* 16:9 aspect ratio */
  border-radius: var(--radius-lg);
  overflow: hidden;
  background-color: var(--color-gray-100);
  box-shadow:
    0 12px 32px -8px rgba(18, 31, 91, 0.12),
    0 4px 12px -2px rgba(18, 31, 91, 0.06);
}

.about-video-wrapper iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: none;
}

.about-video-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.about-video-title {
  font-family: var(--font-display);
  font-size: 1.125rem;
  font-weight: var(--font-weight-bold);
  line-height: 1.3;
  color: var(--color-text-primary);
  margin: 0;
}

.about-video-desc {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
}

/* ── Community: Program Showcase Pattern ── */
.about-community-section-header {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  margin-bottom: var(--space-12);
  text-align: center;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
}

.about-programs-showcase-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-16);
}

.about-program-showcase-card {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(2.5rem, 5vw, 4rem);
  align-items: center;
  padding: var(--space-8) 0;
  border-top: 1px solid var(--color-border-subtle);
}

.about-program-showcase-card:first-child {
  border-top: 1px solid var(--color-border-subtle);
}

.about-program-showcase-card.is-reversed {
  grid-template-columns: 1fr 1fr;
}

.about-program-showcase-card.is-reversed .about-program-showcase-media {
  order: 2;
}

.about-program-showcase-card.is-reversed .about-program-showcase-content {
  order: 1;
}

.about-program-showcase-media {
  position: relative;
  width: fit-content;
  max-width: 100%;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow:
    0 12px 32px -8px rgba(18, 31, 91, 0.12),
    0 4px 12px -2px rgba(18, 31, 91, 0.06);
  transition:
    transform 480ms cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 480ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-program-showcase-card.is-reversed .about-program-showcase-media {
  justify-self: end;
}

.about-program-showcase-card:hover .about-program-showcase-media {
  transform: translateY(-3px);
  box-shadow:
    0 20px 48px -12px rgba(18, 31, 91, 0.18),
    0 8px 20px -4px rgba(18, 31, 91, 0.1);
}

.about-program-showcase-img {
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 400px;
  object-fit: cover;
  display: block;
  transition: transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
}

.about-program-showcase-card:hover .about-program-showcase-img {
  transform: scale(1.02);
}

.about-program-showcase-content {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.about-program-header-meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}

.about-program-index {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, var(--color-primary-500) 0%, var(--color-primary-600) 100%);
  border-radius: var(--radius-md);
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 800;
  color: var(--color-white);
}

.about-program-title {
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 2vw, 1.65rem);
  font-weight: var(--font-weight-bold);
  line-height: 1.28;
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
  margin: 0;
}

.about-program-desc {
  font-family: var(--font-body);
  font-size: 0.96875rem;
  line-height: 1.7;
  color: var(--color-text-secondary);
  margin: 0;
}

.about-community-cta-footer {
  text-align: center;
  margin-top: var(--space-12);
  padding-top: var(--space-8);
  border-top: 1.5px solid var(--color-border-subtle);
}

.about-community-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-4) var(--space-6);
  font-family: var(--font-body);
  font-size: 0.9375rem;
  font-weight: var(--font-weight-semibold);
  color: var(--color-white);
  background: linear-gradient(135deg, var(--color-primary-500) 0%, var(--color-primary-600) 100%);
  border: none;
  border-radius: var(--radius-md);
  text-decoration: none;
  transition:
    transform 240ms ease,
    box-shadow 240ms ease;
}

.about-community-cta-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px -6px rgba(18, 31, 91, 0.35);
}

/* â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   RESPONSIVE DESIGN
   â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */

@media (max-width: 1024px) {
  .about-purpose-manifesto {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .about-editorial-split,
  .about-editorial-split.is-reversed {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .about-editorial-split.is-reversed .about-split-content {
    order: 1;
  }

  .about-editorial-split.is-reversed .about-split-visual {
    order: 2;
  }

  .about-focus-areas-layout {
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .about-recognition-showcase {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .about-story-manifesto {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .about-program-showcase-card,
  .about-program-showcase-card.is-reversed {
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .about-program-showcase-card.is-reversed .about-program-showcase-media {
    order: 1;
    justify-self: center;
  }

  .about-program-showcase-card.is-reversed .about-program-showcase-content {
    order: 2;
  }
}

@media (max-width: 640px) {
  .about-impact-stats-row {
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  .about-program-showcase-media,
  .about-program-showcase-img {
    max-height: 300px;
  }

  .partner-categories-grid {
    grid-template-columns: 1fr;
  }

  .about-videos-grid {
    grid-template-columns: 1fr;
  }
}


  •â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     LEADERSHIP & TEAM
     â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• */
  .team-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .leadership-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
    margin-top: var(--space-10);
    width: 100%;
  }

  .leader-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background-color: var(--color-bg-surface);
    border: 2px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    text-align: center;
    align-items: center;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .leader-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.12);
  }

  .leader-image-wrap {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid var(--color-primary-100);
    box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.15);
    margin-bottom: var(--space-2);
  }

  .leader-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .leader-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    align-items: center;
  }

  .leader-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .leader-role {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-primary-600);
  }

  .leader-bio {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: var(--line-height-relaxed);
    color: var(--color-gray-700);
    margin: 0;
    text-align: center;
  }

  .leader-link {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-500);
    text-decoration: none;
    transition: color var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .leader-link:hover {
    color: var(--color-primary-600);
  }

  .leader-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-2);
  }

  .leader-link-linkedin {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .leader-link-linkedin svg {
    width: 16px;
    height: 16px;
  }

