              class="about-purpose-img"
              width="540"
              height="640"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <div class="about-purpose-right">
          <div class="about-purpose-pill">
            <span class="pulse-dot" aria-hidden="true"></span>
            <span>About InterProFinland</span>
          </div>
          <h1 class="about-purpose-title">
            Empowering International Professionals to <span class="about-purpose-serif">Thrive in Finland</span>
          </h1>
          
          <p class="about-purpose-lead">
            We are a support network dedicated to helping international professionals overcome
            barriers, validate their qualifications, and build meaningful careers in the Finnish
            labour market.
          </p>

          <!-- Impact Stats -->
          <div class="about-impact-stats-row">
            {
              impact.map((stat) => (
                <div class="about-impact-stat">
                  <strong class="about-impact-number">{stat.number}</strong>
                  <span class="about-impact-label">{stat.label}</span>
                </div>
              ))
            }
          </div>

          <p class="about-purpose-subtext">
            Since 2021, we've built a vibrant community of international professionals, fostering connections, facilitating qualification recognition, and creating pathways to meaningful employment across Finland.
          </p>
        </div>
      </div>
    </Container>
  </Section>

