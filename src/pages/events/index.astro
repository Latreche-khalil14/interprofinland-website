---
/**
 * Events Hub — InterProFinland
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Layout
  title="Events — InterProFinland"
  description="Upcoming workshops, webinars, networking events, and community gatherings."
>
  <Section>
    <Container size="content">
      <div style="text-align: center; max-width: 800px; margin: 0 auto; padding: 4rem 2rem;">
      <h1>Events Hub</h1>
      
      <h2 style="margin-top: 2rem;">📋 Page Sections</h2>
      <p style="text-align: left; line-height: 2;">
        • Hero<br>
        • Upcoming events<br>
        • Event list<br>
        • Event detail links<br>
        • Workshops<br>
        • Webinars<br>
        • Networking events<br>
        • Community events<br>
        • External registration links<br>
        • CTA / Facebook group
      </p>

      <p style="margin-top: 2rem;"><a href="/events/archive" style="color: #131f5b;">View Past Events →</a></p>

      <p style="margin-top: 2rem;"><em>Page under construction</em></p>
      </div>
    </Container>
  </Section>
</Layout>
