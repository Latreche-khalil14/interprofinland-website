---
/**
 * Contact — InterProFinland
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Layout
  title="Contact Us — InterProFinland"
  description="Get in touch with InterProFinland for support, inquiries, or collaboration opportunities."
>
  <Section>
    <Container size="content">
      <div style="text-align: center; max-width: 800px; margin: 0 auto; padding: 4rem 2rem;">
      <h1>Contact Us</h1>
      
      <h2 style="margin-top: 2rem;">📋 Page Sections</h2>
      <p style="text-align: left; line-height: 2;">
        • Hero<br>
        • Contact introduction<br>
        • Office information<br>
        • Address<br>
        • Email<br>
        • Phone/WhatsApp (after confirmation)<br>
        • Visiting rules<br>
        • Appointment information<br>
        • Contact form<br>
        • Degree recognition contact<br>
        • Social links<br>
        • Map (if valuable)<br>
        • Privacy notice
      </p>

      <p style="margin-top: 2rem;"><em>Page under construction</em></p>
      </div>
    </Container>
  </Section>
</Layout>
