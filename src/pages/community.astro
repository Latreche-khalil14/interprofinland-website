---
/**
 * Community Page — InterProFinland
 * A Community Where International Professionals Connect, Grow & Belong
 * Editorial layout with verified authentic assets and responsive design.
 */
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import { stories, PROGRAM_LABELS } from '@/data/stories';

// Showcase 2 member testimonials
const communityTestimonials = stories.slice(0, 2);
---

<Layout
  title="Community — InterProFinland"
  description="A community where international professionals connect, grow, and belong. Join 1,800+ professionals from 74 nationalities across 80+ professions in Finland."
>

  <!-- ====================================================================
       SUBNAV
       ==================================================================== -->
  <div class="community-subnav">
    <Container size="page">
      <div class="subnav-inner">
        <nav class="subnav-breadcrumbs" aria-label="Breadcrumb">
          <a href="/" class="crumb-link">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Home
          </a>
          <span class="crumb-sep" aria-hidden="true">/</span>
          <span class="crumb-current" aria-current="page">Community</span>
        </nav>
        <span class="subnav-tagline">Network of 1,800+ international professionals in Finland</span>
      </div>
    </Container>
  </div>

  <!-- ====================================================================
       1. HERO SECTION
       ==================================================================== -->
  <section class="community-hero" aria-label="Community introduction">
    <Container size="page">
      <div class="hero-grid">
        
        <!-- Left: Content -->
        <div class="hero-content">
          <span class="section-eyebrow">InterProFinland Community</span>
          <h1 class="hero-title">Where International Professionals Connect, Grow & Belong</h1>
          <p class="hero-description">
            InterProFinland is more than services — we are an active network of skilled international 
            residents supporting each other across Finland. Share experiences, build lasting relationships, 
            and advance your career together.
          </p>

          <!-- Mobile Image: shown between description and stats on small screens -->
          <div class="hero-image-mobile">
            <img
              src="/images/about/Social Gatherings.webp"
              alt="International professionals gathered at an InterProFinland community event"
              class="hero-image"
              width="640"
              height="460"
              loading="eager"
              decoding="async"
            />
          </div>
          
          <div class="hero-stats" aria-label="Community statistics">
            <div class="hero-stat">
              <div class="stat-number">1,800+</div>
              <div class="stat-label">Community Members</div>
            </div>
            <div class="hero-stat">
              <div class="stat-number">80+</div>
              <div class="stat-label">Professions</div>
            </div>
            <div class="hero-stat">
              <div class="stat-number">74</div>
              <div class="stat-label">Nationalities</div>
            </div>
          </div>

          <div class="hero-cta-group">
            <a 
              href="https://form.jotform.com/InterProFinland/membership-application-form" 
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              Join the Community
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
            <a href="#activities" class="btn-outline">
              Explore Activities
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Image -->
        <div class="hero-image-wrapper">
          <img
            src="/images/about/Social Gatherings.webp"
            alt="International professionals gathered at an InterProFinland community event"
            class="hero-image"
            width="640"
            height="460"
            loading="eager"
            decoding="async"
          />
        </div>

      </div>
    </Container>
  </section>

  <!-- ====================================================================
       2. COMMUNITY IN ACTION (3 Pillars)
       ==================================================================== -->
  <div id="activities">
    <Section background="surface">
      <Container size="page">
      <div class="section-header">
        <span class="section-eyebrow">Community Life</span>
        <h2 class="section-title">Building Connections in Action</h2>
        <p class="section-description">
          From informal social gatherings to structured professional development, our community 
          creates spaces where foreign talents feel supported and empowered.
        </p>
      </div>

      <div class="action-grid">
        
        <!-- 01. Picnics & Gatherings -->
        <article class="action-card">
          <div class="action-image-wrapper">
            <img
              src="/images/home/Community Picnics.webp"
              alt="Community members enjoying an informal outdoor gathering"
              class="action-image"
              width="600"
              height="380"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="action-content">
            <div class="action-num">01</div>
            <span class="action-tag">Social Connection</span>
            <h3 class="action-title">Community Picnics & Social Gatherings</h3>
            <p class="action-description">
              Relax, meet peers, and build genuine friendships in informal outdoor settings. 
              Our community picnics bring members and families together for meaningful cross-cultural conversations.
            </p>
            <a href="/contact" class="action-link">
              Participate in Social Events
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

        <!-- 02. Workshops -->
        <article class="action-card">
          <div class="action-image-wrapper">
            <img
              src="/images/about/Collaborative Workshops.webp"
              alt="Interactive collaborative workshop for career advancement"
              class="action-image"
              width="600"
              height="380"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="action-content">
            <div class="action-num">02</div>
            <span class="action-tag">Professional Growth</span>
            <h3 class="action-title">Interactive Workshops & Career Skills</h3>
            <p class="action-description">
              Sharpen your competencies through hands-on sessions covering the Finnish job market, 
              workplace culture, Finnish employment regulations, and professional networking tactics.
            </p>
            <a href="/services/career-guidance" class="action-link">
              Explore Career Guidance
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

        <!-- 03. Wellness & Integration -->
        <article class="action-card">
          <div class="action-image-wrapper">
            <img
              src="/images/home/Wellness & Integration Activities.webp"
              alt="Cultural wellness and integration activities"
              class="action-image"
              width="600"
              height="380"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="action-content">
            <div class="action-num">03</div>
            <span class="action-tag">Wellbeing & Belonging</span>
            <h3 class="action-title">Wellness & Cultural Integration</h3>
            <p class="action-description">
              Balance the demands of your career path with community wellbeing activities, outdoor walks, 
              and peer discussion circles designed to support healthy integration in Finland.
            </p>
            <a href="/contact" class="action-link">
              Join Integration Circles
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

      </div>
    </Container>
  </Section>
  </div>

  <!-- ====================================================================
       3. SIGNATURE PROGRAMS
       ==================================================================== -->
  <Section background="default">
    <Container size="page">
      <div class="section-header">
        <span class="section-eyebrow">Flagship Initiatives</span>
        <h2 class="section-title">Programs You Can Be Part Of</h2>
        <p class="section-description">
          Participate in structured initiatives created specifically to tackle real hurdles in the Finnish labour market.
        </p>
      </div>

      <div class="programs-grid">
        
        <!-- Kielikaverit -->
        <article class="program-card">
          <div class="program-image-wrapper">
            <img
              src="/images/home/Finnish Language Club.webp"
              alt="Kielikaverit Finnish language club gathering"
              class="program-image"
              width="440"
              height="280"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="program-body">
            <span class="program-badge">Weekly Club</span>
            <h3 class="program-title">Kielikaverit — Language Club</h3>
            <p class="program-description">
              Informal Finnish conversation practice for all skill levels. Meet native Finnish speakers 
              and international residents in a relaxed, encouraging setting.
            </p>
            <div class="program-meta">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              Every Wednesday · 17:00 – 18:30 (Pori & Online)
            </div>
            <a href="/contact" class="program-link">
              Join Kielikaverit
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

        <!-- Degree AMPLIFY -->
        <article class="program-card">
          <div class="program-image-wrapper">
            <img
              src="/images/home/Foreign Degree .webp"
              alt="Foreign Degree recognition and OPH Valvira advisory"
              class="program-image"
              width="440"
              height="280"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="program-body">
            <span class="program-badge">Award Finalist</span>
            <h3 class="program-title">Degree AMPLIFY Project</h3>
            <p class="program-description">
              Comprehensive guidance and peer cohort support helping internationally educated 
              professionals navigate OPH equivalency and Valvira healthcare licensing.
            </p>
            <div class="program-meta">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              Seasonal Webinar Series · Online on Zoom
            </div>
            <a href="/projects/degree-amplify" class="program-link">
              Explore Degree AMPLIFY
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

        <!-- SIPF Fair -->
        <article class="program-card">
          <div class="program-image-wrapper">
            <img
              src="/images/home/sipf.webp"
              alt="Satakunta International Professionals Fair networking"
              class="program-image"
              width="440"
              height="280"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="program-body">
            <span class="program-badge">Flagship Gathering</span>
            <h3 class="program-title">Satakunta Fair (SIPF)</h3>
            <p class="program-description">
              The premier regional event connecting international talents with hiring employers, 
              municipal leaders, universities, and regional development partners.
            </p>
            <div class="program-meta">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              Annual Flagship Event · Pori, Satakunta
            </div>
            <a href="/events" class="program-link">
              View Fair Details
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </article>

      </div>
    </Container>
  </Section>

  <!-- ====================================================================
       4. MENTORSHIP & PEER SUPPORT (Split Section)
       ==================================================================== -->
  <Section background="surface">
    <Container size="page">
      <div class="mentorship-split">
        
        <div class="mentorship-image-wrapper">
          <img
            src="/images/home/one-mentor-one.webp"
            alt="One-on-one mentorship session between professional mentor and mentee"
            class="mentorship-image"
            width="560"
            height="420"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="mentorship-content">
          <span class="section-eyebrow">Guidance & Mentorship</span>
          <h2 class="mentorship-heading">You Don't Have to Navigate Finland Alone</h2>
          <p class="mentorship-intro">
            Connect with seasoned mentors who understand the realities of relocating to Finland, 
            navigating Finnish workplace norms, and unlocking your professional potential.
          </p>

          <div class="mentorship-blocks">
            <div class="mentorship-item">
              <div class="mentorship-icon-box">🤝</div>
              <div>
                <h3 class="mentorship-title">One Mentor One Program</h3>
                <p class="mentorship-desc">
                  Tailored 1-on-1 mentorship matching you with an established professional in your industry 
                  for practical job-hunting advice and localized industry insight.
                </p>
                <a href="/services/mentorship" class="mentorship-sublink">Learn about Mentorship →</a>
              </div>
            </div>

            <div class="mentorship-item">
              <div class="mentorship-icon-box">💬</div>
              <div>
                <h3 class="mentorship-title">Peer Support Circles</h3>
                <p class="mentorship-desc">
                  Safe, welcoming spaces to ask honest questions, share integration experiences, 
                  and gain encouragement from colleagues on similar career paths.
                </p>
                <a href="/contact" class="mentorship-sublink">Join a Peer Group →</a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </Container>
  </Section>

  <!-- ====================================================================
       5. MEMBERSHIP BENEFITS
       ==================================================================== -->
  <Section background="default">
    <Container size="page">
      <div class="section-header">
        <span class="section-eyebrow">Why Join</span>
        <h2 class="section-title">What You Gain as an InterProFinland Member</h2>
        <p class="section-description">
          Gain direct access to specialized toolkits, individual advisory sessions, and exclusive network privileges.
        </p>
      </div>

      <div class="benefits-grid">
        
        <div class="benefit-card">
          <div class="benefit-icon">📘</div>
          <h3 class="benefit-title">Degree Recognition Handbook</h3>
          <p class="benefit-description">
            Complete step-by-step documentation on OPH equivalency, sworn translation rules, and Valvira licensing.
          </p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">👤</div>
          <h3 class="benefit-title">Personal Mentor Matching</h3>
          <p class="benefit-description">
            Individualized pairing with a peer or veteran advisor in your field to support your integration.
          </p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">🎓</div>
          <h3 class="benefit-title">Member-Only Workshops</h3>
          <p class="benefit-description">
            Exclusive briefings on Finnish labour rights, taxation (Vero), social security (Kela), and resume tailoring.
          </p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">💼</div>
          <h3 class="benefit-title">Direct Employer Networks</h3>
          <p class="benefit-description">
            Access to regional recruitment roundtables, company visits, and professional networking events.
          </p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">🗂️</div>
          <h3 class="benefit-title">Tools & Career Resource Hub</h3>
          <p class="benefit-description">
            Downloadable CV templates, cover letter frameworks for the Finnish market, and job portal checklists.
          </p>
        </div>

        <div class="benefit-card">
          <div class="benefit-icon">🗣️</div>
          <h3 class="benefit-title">Finnish Language Practice</h3>
          <p class="benefit-description">
            Weekly speaking club access (Kielikaverit) with native speakers and customized conversational themes.
          </p>
        </div>

      </div>

      <div class="benefits-cta">
        <a 
          href="https://form.jotform.com/InterProFinland/membership-application-form" 
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          Apply for Membership
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </Container>
  </Section>

  <!-- ====================================================================
       6. FACEBOOK COMMUNITY HUB
       ==================================================================== -->
  <Section background="surface">
    <Container size="page">
      <div class="facebook-hub-card">
        <div class="facebook-hub-left">
          <div class="facebook-badge">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#1877F2" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            <span>Official Online Community</span>
          </div>
          <h2 class="facebook-hub-title">Stay Connected with 1,800+ Peers on Facebook</h2>
          <p class="facebook-hub-desc">
            Our Facebook group is the active day-to-day meeting point for international talents in Finland. 
            Ask questions, share job leads, organize casual meetups, and hear first about upcoming workshops.
          </p>
          <a 
            href="https://www.facebook.com/groups/interprofinland" 
            target="_blank"
            rel="noopener noreferrer"
            class="btn-facebook"
          >
            Join Our Facebook Group
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="7" y1="17" x2="17" y2="7"></line>
              <polyline points="7 7 17 7 17 17"></polyline>
            </svg>
          </a>
        </div>

        <div class="facebook-hub-right">
          <div class="facebook-stats-box">
            <div class="fb-stat">
              <span class="fb-stat-num">1,800+</span>
              <span class="fb-stat-lbl">Active Members</span>
            </div>
            <div class="fb-stat-divider"></div>
            <div class="fb-stat">
              <span class="fb-stat-num">74</span>
              <span class="fb-stat-lbl">Countries Represented</span>
            </div>
            <div class="fb-stat-divider"></div>
            <div class="fb-stat">
              <span class="fb-stat-num">Daily</span>
              <span class="fb-stat-lbl">Peer Discussions</span>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ====================================================================
       7. MEMBER STORIES SNIPPET
       ==================================================================== -->
  <Section background="default">
    <Container size="page">
      <div class="section-header">
        <span class="section-eyebrow">Real Experiences</span>
        <h2 class="section-title">Hear From Our Community Members</h2>
        <p class="section-description">
          Real stories from international professionals who found their career trajectory in Finland.
        </p>
      </div>

      <div class="community-stories-grid">
        {communityTestimonials.map((story) => (
          <article class="community-story-card">
            <div class="story-card-photo">
              <img
                src={story.image}
                alt={story.name + ' — ' + story.role}
                class="story-card-img"
                width="140"
                height="175"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="story-card-content">
              <span class="story-card-tag">{PROGRAM_LABELS[story.program]}</span>
              <h3 class="story-card-name">{story.name}</h3>
              <p class="story-card-role">{story.role}</p>
              <p class="story-card-quote">"{story.pullQuote}"</p>
              <a href={'/stories/' + story.id} class="story-card-link">
                Read Full Story →
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="stories-cta-footer">
        <a href="/stories" class="btn-outline">
          View All Community Stories
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </Container>
  </Section>

  <!-- ====================================================================
       8. FINAL CTA
       ==================================================================== -->
  <CtaSection
    eyebrow="Join Us"
    heading="Find Your Place in the Community"
    subheading="Whether you're looking for peer connections, Finnish language practice, qualification guidance, or mentorship — there is a supportive seat waiting for you."
    cta={{
      label: 'Join the Community',
      href: 'https://form.jotform.com/InterProFinland/membership-application-form',
      target: '_blank'
    }}
    secondaryCta={{
      label: 'Contact Our Team',
      href: '/contact'
    }}
  />

</Layout>

<style>
  /* ── Subnav ── */
  .community-subnav {
    background: #ffffff;
    border-bottom: 1px solid var(--color-border-subtle, #e2e8f0);
    padding: 12px 0;
  }

  .subnav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .subnav-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .crumb-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-gray-500);
    text-decoration: none;
    transition: color 140ms ease;
  }

  .crumb-link:hover { color: #131F5B; }
  .crumb-sep { color: #cbd5e1; font-size: 0.75rem; }
  .crumb-current {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #131F5B;
  }

  .subnav-tagline {
