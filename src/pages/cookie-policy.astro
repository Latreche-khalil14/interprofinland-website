---
/**
 * Cookie Policy — InterProFinland
 */
import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Layout
  title="Cookie Policy — InterProFinland"
  description="Learn about how International Professionals Finland ry uses cookies and similar technologies on our website."
>

  <!-- Subnav -->
  <div class="policy-subnav">
    <Container size="page">
      <nav class="subnav-breadcrumbs" aria-label="Breadcrumb">
        <a href="/" class="crumb-link">Home</a>
        <span class="crumb-sep">/</span>
        <span class="crumb-current">Cookie Policy</span>
      </nav>
    </Container>
  </div>

  <!-- Header -->
  <Section background="default">
    <Container size="narrow">
      <div class="policy-header">
        <h1 class="policy-title">Cookie Policy</h1>
        <p class="policy-intro">
          This Cookie Policy explains how International Professionals Finland ry (InterProFinland) uses cookies and similar technologies on our website to enhance your browsing experience and improve our services.
        </p>
        <p class="policy-date"><strong>Last updated:</strong> January 2025</p>
      </div>
    </Container>
  </Section>

  <!-- Content -->
  <Section background="surface">
    <Container size="narrow">
      <div class="policy-content">

        <section class="policy-section">
          <h2>1. What Are Cookies?</h2>
          <p>
            Cookies are small text files that are placed on your device (computer, smartphone, or tablet) when you visit a website. They help the website remember your actions and preferences (such as language, font size, and other display preferences) over a period of time, so you don't have to re-enter them whenever you return to the site or browse from one page to another.
          </p>
        </section>

        <section class="policy-section">
          <h2>2. How We Use Cookies</h2>
          <p>We use cookies for the following purposes:</p>
          <ul>
            <li><strong>Essential Functionality:</strong> To enable core website features and ensure the site functions properly</li>
            <li><strong>Performance and Analytics:</strong> To understand how visitors use our website and identify areas for improvement</li>
            <li><strong>User Preferences:</strong> To remember your settings and preferences for a better experience</li>
            <li><strong>Security:</strong> To protect our website and detect malicious activity</li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>3. Types of Cookies We Use</h2>

          <h3>3.1 Strictly Necessary Cookies</h3>
          <p>
            These cookies are essential for the website to function properly. They enable core functionality such as security, network management, and accessibility. You cannot opt out of these cookies without impacting the website's functionality.
          </p>
          <div class="cookie-table">
            <table>
              <thead>
                <tr>
                  <th>Cookie Name</th>
                  <th>Purpose</th>
                  <th>Duration</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>session_id</td>
                  <td>Maintains user session state</td>
                  <td>Session</td>
                </tr>
                <tr>
                  <td>csrf_token</td>
                  <td>Security protection against cross-site request forgery</td>
                  <td>Session</td>
                </tr>
              </tbody>
            </table>
          </div>

          <h3>3.2 Performance and Analytics Cookies</h3>
          <p>
            These cookies collect information about how visitors use our website, such as which pages are visited most often and how users navigate the site. This data helps us improve the website's functionality and user experience. All information collected is aggregated and anonymous.
          </p>
          <div class="cookie-table">
            <table>
              <thead>
                <tr>
                  <th>Cookie Name</th>
                  <th>Purpose</th>
                  <th>Duration</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>_ga</td>
                  <td>Google Analytics - Distinguishes users</td>
                  <td>2 years</td>
                </tr>
                <tr>
                  <td>_gid</td>
                  <td>Google Analytics - Distinguishes users</td>
                  <td>24 hours</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="note">
            <strong>Note:</strong> We currently use minimal analytics. As we develop our website, we may add privacy-respecting analytics tools such as Plausible or Fathom Analytics.
          </p>

          <h3>3.3 Functional Cookies</h3>
          <p>
            These cookies allow the website to remember choices you make (such as language preference or region) and provide enhanced, more personalized features.
          </p>
          <div class="cookie-table">
            <table>
              <thead>
                <tr>
                  <th>Cookie Name</th>
                  <th>Purpose</th>
                  <th>Duration</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>language_pref</td>
                  <td>Stores language preference</td>
                  <td>1 year</td>
                </tr>
                <tr>
                  <td>cookie_consent</td>
                  <td>Remembers your cookie consent preferences</td>
                  <td>1 year</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <section class="policy-section">
          <h2>4. Third-Party Cookies</h2>
          <p>
            Some cookies are placed by third-party services that appear on our pages. We do not control these cookies. Third parties may use cookies in the process of delivering content, including relevant advertisements, that may be of interest to you while on our website or other websites.
          </p>
          <p>Third-party services we may use include:</p>
          <ul>
            <li><strong>Google Analytics:</strong> Web analytics service (if enabled)</li>
            <li><strong>Social Media Platforms:</strong> If you share content via social media buttons</li>
            <li><strong>Content Delivery Networks (CDN):</strong> For faster content delivery (e.g., Cloudflare)</li>
          </ul>
          <p>
            These third parties have their own privacy policies. We recommend reviewing their policies to understand how they use your data.
          </p>
        </section>

        <section class="policy-section">
          <h2>5. How to Control Cookies</h2>
          <p>You have several options to manage or disable cookies:</p>

          <h3>5.1 Browser Settings</h3>
          <p>
            Most web browsers allow you to control cookies through their settings. You can set your browser to refuse cookies or delete certain cookies. Note that if you disable essential cookies, some parts of our website may not function properly.
          </p>
          <p>Here's how to manage cookies in popular browsers:</p>
          <ul>
            <li><strong>Google Chrome:</strong> Settings → Privacy and security → Cookies and other site data</li>
            <li><strong>Mozilla Firefox:</strong> Settings → Privacy & Security → Cookies and Site Data</li>
            <li><strong>Safari:</strong> Preferences → Privacy → Manage Website Data</li>
            <li><strong>Microsoft Edge:</strong> Settings → Cookies and site permissions</li>
          </ul>

          <h3>5.2 Cookie Consent Banner</h3>
          <p>
            When you first visit our website, you will see a cookie consent banner allowing you to accept or decline non-essential cookies. You can change your preferences at any time by clicking the "Cookie Settings" link in our website footer.
          </p>

          <h3>5.3 Opt-Out Tools</h3>
          <p>You can opt out of certain analytics services:</p>
          <ul>
            <li><strong>Google Analytics Opt-out:</strong> <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener">Google Analytics Opt-out Browser Add-on</a></li>
          </ul>
        </section>

        <section class="policy-section">
          <h2>6. Similar Technologies</h2>
          <p>In addition to cookies, we may use other similar technologies:</p>
          <ul>
            <li><strong>Web Beacons:</strong> Small graphic images (also known as "pixel tags") that track page views and email opens</li>
            <li><strong>Local Storage:</strong> Browser-based storage that allows websites to store data locally on your device</li>
            <li><strong>Session Storage:</strong> Temporary storage that is cleared when you close your browser</li>
          </ul>
          <p>These technologies serve similar purposes to cookies and are subject to the same controls.</p>
        </section>

        <section class="policy-section">
          <h2>7. Do Not Track (DNT)</h2>
          <p>
            Some browsers include a "Do Not Track" (DNT) feature that signals to websites that you do not want to be tracked. Currently, there is no industry standard for responding to DNT signals. We do not track users across third-party websites and therefore do not respond to DNT signals at this time. We respect your privacy and minimize data collection to what is necessary for website functionality and improvement.
          </p>
        </section>

        <section class="policy-section">
          <h2>8. Updates to This Cookie Policy</h2>
          <p>
            We may update this Cookie Policy from time to time to reflect changes in technology, legislation, our operations, or for other operational, legal, or regulatory reasons. When we make changes, we will update the "Last updated" date at the top of this page.
          </p>
          <p>
            We encourage you to review this Cookie Policy periodically to stay informed about how we use cookies.
          </p>
        </section>

        <section class="policy-section">
          <h2>9. More Information</h2>
          <p>
            For more information about how we handle your personal data, please read our <a href="/privacy-policy">Privacy Policy</a>.
          </p>
          <p>
            If you have questions about our use of cookies or this Cookie Policy, please contact us:
          </p>
          <p>
            <strong>Email:</strong> <a href="mailto:info@interprofinland.fi">info@interprofinland.fi</a><br>
            <strong>Address:</strong> Otavankatu 5 A, 28100 Pori, Finland
          </p>
          <p>
            For general information about cookies, visit: <a href="https://www.allaboutcookies.org/" target="_blank" rel="noopener">www.allaboutcookies.org</a>
          </p>
        </section>

      </div>

      <div class="policy-footer">
        <p>By continuing to use our website, you consent to our use of cookies in accordance with this Cookie Policy.</p>
      </div>

    </Container>
  </Section>

</Layout>

<style>
  /* Subnav */
  .policy-subnav {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 12px 0;
  }

  .subnav-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .crumb-link {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: none;
    transition: color 140ms ease;
  }

  .crumb-link:hover { color: #131F5B; }

  .crumb-sep { color: #cbd5e1; font-size: 0.75rem; }

  .crumb-current {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #131F5B;
  }

  /* Header */
  .policy-header {
    text-align: center;
    padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(1.5rem, 3vw, 2rem);
  }

  .policy-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #0f172a;
    margin: 0 0 var(--space-4);
    letter-spacing: -0.02em;
  }

  .policy-intro {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    color: #475569;
    line-height: 1.65;
    margin: 0 auto var(--space-3);
    max-width: 65ch;
  }

  .policy-date {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: #64748b;
    margin: 0;
  }

  /* Content */
  .policy-content {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: clamp(2rem, 5vw, 3rem);
  }

  .policy-section {
    margin-bottom: clamp(2rem, 4vw, 2.5rem);
  }

  .policy-section:last-child {
    margin-bottom: 0;
  }

  .policy-section h2 {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.5vw, 1.375rem);
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.01em;
  }

  .policy-section h3 {
    font-family: var(--font-display);
    font-size: clamp(0.9375rem, 2vw, 1.0625rem);
    font-weight: 700;
    color: #1e293b;
    margin: var(--space-4) 0 var(--space-2);
  }

  .policy-section p {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.8vw, 1rem);
    color: #475569;
    line-height: 1.7;
    margin: 0 0 var(--space-3);
  }

  .policy-section p:last-child {
    margin-bottom: 0;
  }

  .policy-section ul {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.8vw, 1rem);
    color: #475569;
    line-height: 1.7;
    margin: 0 0 var(--space-3);
    padding-left: 1.5rem;
  }

  .policy-section li {
    margin-bottom: 0.5rem;
  }

  .policy-section li:last-child {
    margin-bottom: 0;
  }

  .policy-section a {
    color: #131F5B;
    text-decoration: underline;
    transition: color 150ms ease;
  }

  .policy-section a:hover {
    color: #1E3A8A;
  }

  /* Note */
  .note {
    background: #f8fafc;
    border-left: 3px solid #131F5B;
    padding: 1rem 1.25rem;
    border-radius: 0 6px 6px 0;
    font-size: 0.875rem;
  }

  /* Cookie Table */
  .cookie-table {
    overflow-x: auto;
    margin: var(--space-3) 0;
  }

  .cookie-table table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-body);
    font-size: 0.875rem;
  }

  .cookie-table thead {
    background: #f8fafc;
  }

  .cookie-table th {
    text-align: left;
    padding: 10px 12px;
    font-family: var(--font-display);
    font-weight: 700;
    color: #0f172a;
    border-bottom: 2px solid #e2e8f0;
  }

  .cookie-table td {
    padding: 10px 12px;
    color: #475569;
    border-bottom: 1px solid #e2e8f0;
  }

  .cookie-table tbody tr:last-child td {
    border-bottom: none;
  }

  .cookie-table tbody tr:hover {
    background: #f8fafc;
  }

  @media (max-width: 640px) {
    .cookie-table {
      font-size: 0.8125rem;
    }
    
    .cookie-table th,
    .cookie-table td {
      padding: 8px 10px;
    }
  }

  /* Footer */
  .policy-footer {
    text-align: center;
    padding: var(--space-5) 0 0;
  }

  .policy-footer p {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: #64748b;
    font-style: italic;
    margin: 0;
  }
</style>
