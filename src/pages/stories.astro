---
/**
 * Stories — InterProFinland
 */

import Layout from '@/layouts/Layout.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';
---

<Layout
  title="Stories — InterProFinland"
  description="Real experiences from international professionals navigating their career journey in Finland."
>
  <Section>
    <Container size="content">
      <div style="text-align: center; max-width: 800px; margin: 0 auto; padding: 4rem 2rem;">
      <h1>Stories</h1>
      
      <h2 style="margin-top: 2rem;">📋 Page Sections</h2>
      <p style="text-align: left; line-height: 2;">
        • Hero<br>
        • Featured Story<br>
        • Testimonials<br>
        • Success Stories<br>
        • Community Stories<br>
        • Career journeys<br>
        • Project stories<br>
        • Filters/categories (if necessary)<br>
        • Story cards<br>
        • Individual story pages (later)<br>
        • CTA
      </p>

      <p style="background: #e7f3ff; padding: 1rem; border-radius: 8px; margin: 2rem 0;">
        <strong>💡 Note:</strong> These are NOT just testimonials — full stories with context.
      </p>

      <p style="margin-top: 2rem;"><em>Page under construction</em></p>
      </div>
    </Container>
  </Section>
</Layout>
