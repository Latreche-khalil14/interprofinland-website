    font-family: var(--font-body);
    font-size: 0.96875rem;
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* ── Community Social Proof Stats Row ── */
  .community-stats-row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding: var(--space-2) 0;
    border-top: 1px solid var(--color-border-subtle, #e2e8f0);
    border-bottom: 1px solid var(--color-border-subtle, #e2e8f0);
    width: 100%;
    margin: var(--space-1) 0;
  }

  .community-stat-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .community-stat-num {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    font-weight: 800;
    color: var(--color-primary-500, #131f5b);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .community-stat-lbl {
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-gray-600);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .community-teaser-actions-row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .btn-community-teaser {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-gold, #ffd26f);
    color: #131f5b;
    border: 2px solid var(--color-gold, #ffd26f);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px var(--color-gold-shadow, rgba(255, 210, 111, 0.35));
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 150ms ease,
      box-shadow 200ms ease;
  }

  .btn-community-teaser:hover {
    background-color: var(--color-primary-600, #1e3a8a);
    border-color: var(--color-primary-600, #1e3a8a);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(19, 31, 91, 0.3);
  }

  .btn-community-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: #131f5b;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border: 2px solid #131f5b;
    background-color: transparent;
    border-radius: var(--radius-sm);
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 150ms ease,
      box-shadow 200ms ease;
  }

  .btn-community-secondary:hover {
    background-color: #131f5b;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(19, 31, 91, 0.25);
  }

  .community-teaser-media {
    position: relative;
  }

  .community-teaser-frame {
    position: relative;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(19, 31, 91, 0.12);
    background-color: #f8fafc;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .community-teaser-img {
    width: 100%;
    height: auto;
    max-height: 320px;
    object-fit: contain;
    display: block;
    transition: transform 300ms ease;
  }

  .community-teaser-frame:hover .community-teaser-img {
    transform: scale(1.02);
  }

  @media (max-width: 860px) {
    .community-teaser-card {
      grid-template-columns: 1fr;
      padding: var(--space-6);
    }
  }

  /* ── Story & Testimonials ── */
  .story-header {
    text-align: center;
    margin-bottom: var(--space-10);
  }

  /* ── Story Action Footer ── */
  .story-action-footer {
    text-align: center;
    margin-top: var(--space-8);
  }

  .story-all-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-primary-500, #131f5b);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 2px solid var(--color-primary-400, #1e3a8a);
    transition:
      color 200ms ease,
      border-color 200ms ease,
      transform 200ms ease;
  }

  .story-all-link:hover {
    color: var(--color-primary-600, #1e3a8a);
    border-color: var(--color-primary-600, #1e3a8a);
    transform: translateX(4px);
  }

  /* ── Community Showcase Section (same style as programs) ── */
  .community-gallery-header {
    text-align: center;
    margin-bottom: var(--space-12);
  }

  .community-showcase-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .community-showcase-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    padding: var(--space-8) 0;
  }

  .community-showcase-card.is-reversed {
    direction: rtl;
  }

  .community-showcase-card.is-reversed > * {
    direction: ltr;
  }

  .community-showcase-media {
    position: relative;
    overflow: hidden;
    border-radius: 12px;
    background-color: var(--color-gray-100);
  }

  .community-media-link {
    display: block;
  }

  .community-showcase-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 400ms ease;
  }

  .community-showcase-card:hover .community-showcase-img {
    transform: scale(1.05);
  }

  .community-showcase-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .community-header-meta {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .community-index {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-primary-200);
    line-height: 1;
    opacity: 0.6;
  }

  .community-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
    letter-spacing: -0.015em;
    margin: 0;
  }

  .community-title-link {
    color: inherit;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .community-title-link:hover {
    color: var(--color-primary-600);
  }

  .community-desc {
    font-family: var(--font-body);
    font-size: 0.96875rem;
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .community-action-row {
    margin-top: var(--space-2);
  }

  .btn-community-showcase {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-primary-500);
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 6px;
    transition: all 200ms ease;
  }

  .btn-community-showcase:hover {
    background-color: var(--color-primary-600);
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(19, 31, 91, 0.2);
  }

  .btn-community-showcase .cta-arrow {
    transition: transform 200ms ease;
  }

  .btn-community-showcase:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* ── Magazine Feature Section ── */
  .magazine-feature-box {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .magazine-feature-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .magazine-tag-wrap {
    margin-bottom: var(--space-2);
  }

  .magazine-feature-heading {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2.1rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: var(--line-height-tight);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-3);
  }

  .magazine-feature-body {
    font-family: var(--font-body);
    font-size: 0.96875rem;
    line-height: var(--line-height-relaxed);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-3);
  }

  .magazine-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .magazine-highlights li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-gray-700);
    line-height: 1.5;
  }

  .highlight-check {
    color: var(--color-primary-600);
    font-weight: var(--font-weight-bold);
    line-height: 1.4;
  }

  .magazine-feature-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    align-items: center;
  }

  /* ── Magazine Primary CTA — Gold → Navy flip ── */
  .btn-magazine-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-gold, #ffd26f);
    color: var(--color-primary-500);
    border: 2px solid var(--color-gold, #ffd26f);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px var(--color-gold-shadow, rgba(255, 210, 111, 0.35));
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 150ms ease,
      box-shadow 200ms ease;
  }

  .btn-magazine-primary:hover {
    background-color: var(--color-primary-600);
    border-color: var(--color-primary-600);
    color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(19, 31, 91, 0.3);
  }

  /* ── Magazine Secondary CTA — Navy outline button ── */
  .btn-magazine-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    color: #131f5b;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border: 2px solid #131f5b;
    background-color: transparent;
    border-radius: var(--radius-sm);
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 150ms ease,
      box-shadow 200ms ease;
  }

  .btn-magazine-secondary:hover {
    background-color: #131f5b;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(19, 31, 91, 0.25);
  }

  .magazine-media-frame {
    text-align: center;
    perspective: 1000px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .magazine-cover-img {
    max-width: 270px;
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-md, 12px);
    box-shadow:
      0 20px 40px -10px rgba(0, 0, 0, 0.2),
      0 0 1px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--color-border-default);
    margin: 0 auto var(--space-3);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .magazine-media-frame:hover .magazine-cover-img {
    transform: rotateY(-5deg) translateY(-4px);
  }

  .magazine-cover-caption {
    display: block;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ── Featured Events & Activities Grid (Section 7) ── */
  .events-section-header {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: end;
    margin-bottom: var(--space-10);
  }

  .events-section-heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.8vw, 2.35rem);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: 1.18;
    letter-spacing: -0.02em;
    margin: var(--space-2) 0 0;
  }

  .events-section-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  /* ── Alternating Programs Showcase (Clean Luxury Editorial Rows) ── */
  .programs-showcase-list {
    display: flex;
    flex-direction: column;
    margin-bottom: var(--space-12);
  }

  .program-showcase-card {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border-subtle, #e2e8f0);
    padding: clamp(2rem, 3.5vw, 3rem) 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
    box-shadow: none;
  }

  .program-showcase-card:first-child {
    border-top: 1px solid var(--color-border-subtle, #e2e8f0);
  }

  .program-showcase-card:hover {
    transform: none;
    box-shadow: none;
  }

  /* Reversed layout (Image Right, Content Left) */
  .program-showcase-card.is-reversed {
    grid-template-columns: 1fr 1fr;
  }

  .program-showcase-card.is-reversed .program-showcase-media {
    order: 2;
  }

  .program-showcase-card.is-reversed .program-showcase-content {
    order: 1;
  }

  /* Auto-Adaptive Media Box — Hugs the image's natural dimensions */
  .program-showcase-media {
    position: relative;
    width: fit-content;
    max-width: 100%;
    height: auto;
    max-height: 380px;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    box-shadow:
      0 10px 28px -6px rgba(19, 31, 91, 0.12),
      0 0 0 1px rgba(19, 31, 91, 0.08);
    background-color: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: start;
    flex-shrink: 0;
    transition:
      box-shadow 300ms ease,
      transform 300ms ease;
  }

  .program-showcase-card.is-reversed .program-showcase-media {
    justify-self: end;
  }

  .program-showcase-card:hover .program-showcase-media {
    transform: translateY(-3px);
    box-shadow:
      0 16px 36px -8px rgba(19, 31, 91, 0.18),
      0 0 0 1px rgba(19, 31, 91, 0.12);
  }

  .program-media-link {
    display: inline-flex;
    width: auto;
    height: auto;
    max-height: 380px;
  }

  .program-showcase-img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 380px;
    object-fit: contain;
    display: block;
    border-radius: var(--radius-lg, 16px);
    transition: transform 400ms ease;
  }

  .program-showcase-card:hover .program-showcase-img {
    transform: scale(1.02);
  }

  .program-showcase-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .program-header-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .program-index {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: #131f5b;
    opacity: 0.3;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .program-meta-chips {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .meta-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-display);
    font-size: 0.78125rem;
    font-weight: 600;
    color: #131f5b;
    background-color: #f1f5f9;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-subtle, #e2e8f0);
  }

  .chip-icon {
    font-size: 0.78125rem;
  }

  .program-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: var(--space-1) 0;
  }

  .program-title-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .program-title-link:hover {
    color: var(--color-primary-600);
  }

  .program-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-gray-700);
    margin: 0;
    max-width: 60ch;
  }

  .program-action-row {
    margin-top: var(--space-2);
  }

  /* ── Program CTA Button — Navy Outline ── */
  .btn-program-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: #131f5b;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-2) var(--space-5);
    border: 2px solid #131f5b;
    background-color: transparent;
    border-radius: var(--radius-sm);
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 150ms ease,
      box-shadow 200ms ease;
  }

  .btn-program-cta:hover {
    background-color: #131f5b;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(19, 31, 91, 0.25);
  }

  .btn-program-cta .cta-arrow {
    transition: transform 200ms ease;
  }

  .btn-program-cta:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* ── Events Community Callout ── */
  .events-community-callout {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg, 16px);
    padding: var(--space-8) var(--space-10);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .callout-content {
    max-width: 60ch;
  }

  .callout-heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin: 0 0 var(--space-2);
  }

  .callout-desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .callout-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  /* ── Callout Primary — Gold → Navy (Join Facebook) ── */
  .btn-callout-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background-color: var(--color-gold, #ffd26f);
    color: var(--color-primary-500);
    border: 2px solid var(--color-gold, #ffd26f);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px var(--color-gold-shadow, rgba(255, 210, 111, 0.35));
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 150ms ease,
      box-shadow 200ms ease;
  }

  .btn-callout-primary:hover {
    background-color: var(--color-primary-600);
    border-color: var(--color-primary-600);
    color: var(--color-white);
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(19, 31, 91, 0.3);
  }

  /* ── Callout Secondary — Navy outline ── */
  .btn-callout-secondary {
    display: inline-flex;
    align-items: center;
    background-color: transparent;
    color: var(--color-primary-500);
    border: 1.5px solid var(--color-primary-500);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-sm);
    transition:
      background-color 200ms ease,
      color 200ms ease,
      border-color 200ms ease,
      transform 150ms ease;
  }

  .btn-callout-secondary:hover {
    background-color: var(--color-primary-500);
    color: var(--color-white);
    border-color: var(--color-primary-500);
    transform: translateY(-1px);
  }

  .btn-notice-secondary:hover {
    background-color: var(--color-primary-50);
    border-color: var(--color-primary-500);
  }

  /* ── Partners Section ── */
  .partners-section {
    text-align: center;
  }

  .partners-heading {
    font-family: var(--font-display);
