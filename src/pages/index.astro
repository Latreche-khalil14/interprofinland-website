---
/**
 * Homepage — InterProFinland
 * Supporting international professionals in Finland
 * Editorial design inspired by modern high-contrast reference architecture
 */

import Layout from '@/layouts/Layout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import StoryBlock from '@/components/ui/StoryBlock.astro';
import CtaSection from '@/components/sections/CtaSection.astro';
import Section from '@/components/ui/Section.astro';
import Container from '@/components/ui/Container.astro';

/* ── The 4 Core Focus Areas (Editorial Service Pathways) ── */
const services = [
  {
    index: '01',
    category: 'Labour Market Guidance',
    title: 'Career Guidance & Workplace Culture',
    description:
      'Gain practical insights into the Finnish labour market, working culture expectations, recruitment standards, and strategic job search approaches tailored to your profession.',
    href: '/services/career-guidance',
  },
  {
    index: '02',
    category: 'Diploma Equivalency',
    title: 'Foreign Qualification & Degree Recognition',
    description:
      'Step-by-step navigation through OPH, Valvira, and regulated profession authorities to navigate the recognition of your international qualifications and professional credentials in Finland.',
    href: '/services/qualification-recognition',
  },
  {
    index: '03',
    category: 'Mentorship & Clubs',
    title: '1-on-1 Mentorship & Peer Community',
    description:
      'Connect directly with experienced professionals in your field and participate in weekly Finnish language clubs (Kielikaverit) to gain local industry context and lasting connections.',
    href: '/services/mentorship',
  },
  {
    index: '04',
    category: 'Professional Networks',
    title: 'Networking & Regional Opportunities',
    description:
      'Bridge the gap to Finnish working life through regional employer linkups, professional networks, and annual international talent fairs across Satakunta.',
    href: '/services/networking',
  },
];

/* ── Authentic Community & Signature Events ── */
const featuredEvents = [
  {
    title: 'Kielikaverit — Finnish Language Club',
    badge: 'Weekly Community Club',
    schedule: 'Every Wednesday · 17:00 – 18:30',
    location: 'Pori & Online',
    description:
      'Informal, welcoming Finnish conversation practice for all skill levels. Meet native speakers and fellow international residents in a relaxed environment.',
    image: '/images/events/kielikaverit/kieli-kaverit-1.webp',
    href: '/community',
  },
  {
    title: 'Foreign Degree Recognition & OPH/Valvira Support',
    badge: 'Seasonal Series',
    schedule: 'Seasonal Sessions · Live on Zoom',
    location: 'Online Webinar',
    description:
      'Specialized webinars detailing diploma equivalency procedures, sworn translations, and licensing steps for regulated professions in Finland.',
    image: '/images/projects/degree-amplify/da-webinar-poster-2023.webp',
    href: '/projects/degree-amplify',
  },
  {
    title: 'Satakunta International Professionals Fair (SIPF)',
    badge: 'Flagship Event',
    schedule: 'Annual Regional Gathering',
    location: 'Pori, Satakunta',
    description:
      'The region’s premier international gathering connecting skilled foreign residents with employers, universities, and municipal organizations.',
    image: '/images/events/sipf/sipf-2024.webp',
    href: '/events',
  },
];

/* ── Authentic Partner Logos ── */
const partnerLogos = [
  {
    name: 'European Network of Innovation for Inclusion (ENIIE)',
    logo: '/images/partners/eniie-logo.webp',
  },
  { name: 'EURES Finland', logo: '/images/partners/eures-logo.webp' },
  { name: 'Satakunta University of Applied Sciences (SAMK)', logo: '/images/partners/samk-logo.webp' },
  { name: 'Moniheli ry', logo: '/images/partners/moniheli-logo.webp' },
  { name: 'Nicehearts ry', logo: '/images/partners/nicehearts-logo.webp' },
  { name: 'Pori Entrepreneurship Society (PoriES)', logo: '/images/partners/pories-logo.webp' },
  { name: 'JCI Pori', logo: '/images/partners/jci-pori-logo.webp' },
  { name: 'Satarekry', logo: '/images/partners/satarekry-logo.webp' },
  { name: 'Finnwards', logo: '/images/partners/finnwards-logo.webp' },
  { name: 'African Music & Arts (AMA)', logo: '/images/partners/ama-logo.webp' },
  { name: 'International Working Women of Finland (IWWOF)', logo: '/images/partners/iwwof-logo.webp' },
  { name: 'KYKY Today', logo: '/images/partners/kyky-today-logo.webp' },
  { name: 'Satakunnan Monikulttuuriyhdistys (SMY)', logo: '/images/partners/smy-logo.webp' },
  { name: 'Seasons', logo: '/images/partners/seasons-logo.webp' },
];
---

<Layout
  title="InterProFinland — Supporting International Professionals in Finland"
  description="A support network providing individualized guidance, qualification recognition assistance, mentorship, and community connections to help international talents build meaningful careers in Finland."
>
  <!-- Hero Section with Performance-Optimized Video -->
  <HeroSection
    eyebrow="Support Network for International Talents in Finland"
    headline="Supporting International Professionals in Finland"
    subheadline="Providing a supportive network and tailored guidance to help international talents overcome barriers, recognize qualifications, and build meaningful careers in the Finnish labour market."
    badge="European Recognition · Socio-Labour Innovation"
    primaryCta={{ label: 'Explore Our Services', href: '/services' }}
    secondaryCta={{ label: 'Contact Our Team', href: '/contact' }}
    video={{
      src: '/assets/video-working-together.mp4',
      poster: '/images/hero/homepage/poster-hero.png',
    }}
  />

  <!-- ══════════════════════════════════
       SECTION 2: WHY WE EXIST
       ══════════════════════════════════ -->
  <Section background="surface">
    <Container size="page">
      <div class="purpose-manifesto">
        <div class="purpose-manifesto-left">
          <div class="purpose-image-wrap">
            <img
              src="/images/projects/connect-integrate/connect-integrate-pori.webp"
              alt="International professionals connecting and integrating in Finland through InterProFinland programs"
              class="purpose-img"
              width="540"
              height="640"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <div class="purpose-manifesto-right">
          <div class="purpose-pill">
            <span class="pulse-dot" aria-hidden="true"></span>
            <span>Why We Exist</span>
          </div>
          <h2 class="purpose-title">
            Bridging Global Talent with <span class="purpose-serif">Finnish Opportunities</span>
          </h2>
          
          <p class="purpose-lead">
            International professionals often face barriers that prevent them from using their
            skills and qualifications in Finland. InterProFinland provides guidance, support and
            connections to help turn international expertise into meaningful opportunities.
          </p>
          <p class="purpose-subtext">
            We exist as an active network of individualized guidance, empowering professionals to
            build rewarding careers while enabling the Finnish economy to benefit sustainably from
            the global expertise living here.
          </p>
          <div class="purpose-action">
            <a href="/about" class="purpose-cta-link">
              <span>About InterProFinland</span>
              <span class="cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       SECTION 3: WHAT WE DO (EDITORIAL PATHWAYS)
       ══════════════════════════════════ -->
  <Section>
    <Container size="page">
      <div class="editorial-services-header">
        <div class="editorial-services-title-wrap">
          <span class="section-eyebrow">What We Do</span>
          <h2 class="editorial-services-heading">Four Ways We Support Your Journey</h2>
        </div>
        <p class="editorial-services-desc">
          Structured guidance designed to move you from initial orientation to full qualification
          equivalency and long-term career growth in Finland.
        </p>
      </div>

      <div class="editorial-services-layout">
      <!-- Service 01: Career Guidance (Text | Image) -->
      <article class="editorial-service-split">
        <div class="service-split-content">
          <div class="service-index-badge">
            <span>01</span>
          </div>
          <span class="service-category">Labour Market Guidance</span>
          <h3 class="service-title">
            <a href="/services/career-guidance" class="service-title-link">
              Career Guidance & Workplace Culture
            </a>
          </h3>
          <p class="service-description">
            Gain practical insights into the Finnish labour market, working culture expectations,
            recruitment standards, and strategic job search approaches tailored to your profession.
          </p>
          <a href="/services/career-guidance" class="service-learn-more">
            <span>Learn More</span>
            <span class="learn-more-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="service-split-visual">
          <img
            src="/images/services/career-connect-workshop.jpg"
            alt="Career Connect workshop with recruitment experts and international professionals"
            class="service-split-image"
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
        </div>
      </article>

      <!-- Service 02: Qualification Recognition (Image | Text - Reversed) -->
      <article class="editorial-service-split is-reversed">
        <div class="service-split-content">
          <div class="service-index-badge">
            <span>02</span>
          </div>
          <span class="service-category">Diploma Equivalency</span>
          <h3 class="service-title">
            <a href="/services/qualification-recognition" class="service-title-link">
              Foreign Qualification & Degree Recognition
            </a>
          </h3>
          <p class="service-description">
            Step-by-step navigation through OPH, Valvira, and regulated profession authorities to
            navigate the recognition of your international qualifications and professional
            credentials in Finland.
          </p>
          <a href="/services/qualification-recognition" class="service-learn-more">
            <span>Learn More</span>
            <span class="learn-more-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="service-split-visual">
          <img
            src="/images/services/degree-recognition-support.png"
            alt="Degree recognition support session for international professionals"
            class="service-split-image"
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
        </div>
      </article>

      <!-- Service 03: Mentorship (Text | Image) -->
      <article class="editorial-service-split">
        <div class="service-split-content">
          <div class="service-index-badge">
            <span>03</span>
          </div>
          <span class="service-category">Mentorship & Clubs</span>
          <h3 class="service-title">
            <a href="/services/mentorship" class="service-title-link">
              1-on-1 Mentorship & Peer Community
            </a>
          </h3>
          <p class="service-description">
            Connect directly with experienced professionals in your field and participate in weekly
            Finnish language clubs (Kielikaverit) to gain local industry context and lasting
            connections.
          </p>
          <a href="/services/mentorship" class="service-learn-more">
            <span>Learn More</span>
            <span class="learn-more-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="service-split-visual">
          <img
            src="/images/events/kielikaverit/kieli-kaverit-1.webp"
            alt="Mentorship and peer community connections"
            class="service-split-image"
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
        </div>
      </article>

      <!-- Service 04: Networking (Image | Text - Reversed) -->
      <article class="editorial-service-split is-reversed">
        <div class="service-split-content">
          <div class="service-index-badge">
            <span>04</span>
          </div>
          <span class="service-category">Professional Networks</span>
          <h3 class="service-title">
            <a href="/services/networking" class="service-title-link">
              Networking & Regional Opportunities
            </a>
          </h3>
          <p class="service-description">
            Bridge the gap to Finnish working life through regional employer linkups, professional
            networks, and annual international talent fairs across Satakunta.
          </p>
          <a href="/services/networking" class="service-learn-more">
            <span>Learn More</span>
            <span class="learn-more-arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <div class="service-split-visual">
          <img
            src="/images/events/sipf/sipf-2024.webp"
            alt="Networking opportunities and regional talent fairs"
            class="service-split-image"
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
        </div>
      </article>
      </div>

      <div class="editorial-services-footer">
        <a href="/services" class="btn-all-services">
          <span>Explore All Programs & Services</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       SECTION 4: FEATURED FLAGSHIP INITIATIVE (DEGREE AMPLIFY)
       ══════════════════════════════════ -->
  <Section background="surface">
    <Container size="page">
      <div class="flagship-showcase-card">
        <div class="flagship-content">
          <div class="flagship-eyebrow-row">
            <span class="section-eyebrow">Flagship Project</span>
            <span class="flagship-award-badge">🏆 Madrid 2023 · European Finalist</span>
          </div>

          <h2 class="flagship-title">Degree AMPLIFY</h2>
          <p class="flagship-subtitle">Foreign Diploma & Qualification Recognition Support</p>

          <p class="flagship-summary">
            Our flagship yearly initiative empowering international professionals to understand,
            prepare, and successfully navigate the official foreign diploma recognition process in
            Finland. Specialists who navigated the process guide new applicants step by step through
            competent Finnish authorities.
          </p>

          <div class="flagship-pillars-grid">
            <div class="flagship-pillar-item">
              <span class="pillar-check" aria-hidden="true">✓</span>
              <div class="pillar-info">
                <strong>OPH & Valvira Navigation:</strong> Guidance through official evaluation and licensing
                procedures for regulated and non-regulated professions.
              </div>
            </div>
            <div class="flagship-pillar-item">
              <span class="pillar-check" aria-hidden="true">✓</span>
              <div class="pillar-info">
                <strong>Specialist Mentors:</strong> 1-on-1 coaching from peers who already achieved credential
                recognition in Finland.
              </div>
            </div>
            <div class="flagship-pillar-item">
              <span class="pillar-check" aria-hidden="true">✓</span>
              <div class="pillar-info">
                <strong>European Good Practice:</strong> Recognized as an Innovative Good Practice Finalist
                by ENIIE and presented at the Madrid European Forum.
              </div>
            </div>
          </div>

          <div class="flagship-actions-row">
            <a href="/projects/degree-amplify" class="btn-flagship-primary">
              <span>Explore Degree AMPLIFY</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="mailto:degree.amplify@interprofinland.fi" class="btn-flagship-secondary">
              <span>Inquire via Email</span>
            </a>
          </div>
        </div>

        <div class="flagship-visual">
          <div class="flagship-media-frame">
            <img
              src="/images/projects/degree-amplify/degree-amplify-finalist.webp"
              alt="Degree AMPLIFY — European Good Practice Finalist Certificate, Madrid 2023"
              class="flagship-certificate-img"
              width="540"
              height="380"
              loading="lazy"
              decoding="async"
            />
            <span class="flagship-media-caption"
              >VII Call for Good Practices · ENIIE Madrid 2023</span
            >
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       SECTION 5: COMMUNITY & CONNECTION
       ══════════════════════════════════ -->
  <Section>
    <Container size="page">
      <div class="community-teaser-card">
        <div class="community-teaser-content">
          <span class="section-eyebrow">Community & Membership</span>
          <h2 class="community-teaser-heading">Join the InterProFinland Community</h2>
          <p class="community-teaser-desc">
            Become a member and access the association’s membership opportunities and resources.
          </p>

          <!-- Community Social Proof Stats -->
          <div class="community-stats-row">
            <div class="community-stat-item">
              <strong class="community-stat-num">1,800+</strong>
              <span class="community-stat-lbl">Community Members</span>
            </div>
            <div class="community-stat-item">
              <strong class="community-stat-num">80+</strong>
              <span class="community-stat-lbl">Professions</span>
            </div>
            <div class="community-stat-item">
              <strong class="community-stat-num">74</strong>
              <span class="community-stat-lbl">Nationalities</span>
            </div>
          </div>

          <div class="community-teaser-actions-row">
            <a
              href="https://form.jotform.com/InterProFinland/membership-application-form"
              class="btn-community-teaser"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Apply for Membership via official form (opens in new tab)"
            >
              <span>Apply for Membership</span>
              <span aria-hidden="true">→</span>
            </a>
            <a href="/community" class="btn-community-secondary">
              <span>Explore Community Activities</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="community-teaser-media">
          <div class="community-teaser-frame">
            <img
              src="/images/events/kielikaverit/kieli-kaverit-1.webp"
              alt="InterProFinland Finnish Language Club and community gathering"
              width="540"
              height="360"
              loading="lazy"
              decoding="async"
              class="community-teaser-img"
            />
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Featured Story & Real Experiences -->
  <Section background="surface">
    <Container size="page">
      <div class="story-header">
        <span class="section-eyebrow">Real Experiences</span>
        <h2 class="section-heading">Voices from Our Community</h2>
        <p class="section-intro">
          Real stories from international professionals who navigated qualification recognition,
          mentorship, and integration in Finland.
        </p>
      </div>

      <StoryBlock
        title="Navigating Diploma Equivalency with 1-on-1 Mentorship"
        summary="Through the One Mentor One program, Cyrille gained direct advice from an experienced mentor who had successfully navigated the diploma recognition process in Finland, saving valuable time and providing strategic career clarity."
        quote="I was able to save time because my mentor knows how the diploma equivalency process works and gave me great advice about it."
        person="Cyrille"
        personRole="Participant, One Mentor One Program"
        personImage="/images/people/testimonials/cyrille.webp"
        href="/stories"
      />

      <div class="story-action-footer">
        <a href="/stories" class="story-all-link">
          <span>Read All Participant Success Stories</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </Container>
  </Section>

  <!-- Community Gallery Showcase -->
  <Section>
    <Container size="page">
      <div class="community-gallery-header">
        <span class="section-eyebrow">Community in Action</span>
        <h2 class="section-heading">Building Connections Together</h2>
        <p class="section-intro">
          From networking events to social gatherings, our community comes together to support,
          connect, and grow professionally.
        </p>
      </div>

      <div class="community-showcase-list">
        <article class="community-showcase-card">
          <div class="community-showcase-media">
            <img
              src="/images/events/general/picnic.webp"
              alt="InterProFinland community picnic event"
              class="community-showcase-img"
              width="540"
              height="380"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="community-showcase-content">
            <div class="community-header-meta">
              <span class="community-index">01</span>
            </div>

            <h3 class="community-title">Community Picnics & Social Gatherings</h3>

            <p class="community-desc">
              Regular outdoor events and social meetups where community members connect in a relaxed
              atmosphere, building lasting friendships and professional networks beyond formal settings.
            </p>

            <div class="community-action-row">
              <a href="/community" class="btn-community-showcase">
                <span>Join Community Events</span>
                <span class="cta-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <article class="community-showcase-card is-reversed">
          <div class="community-showcase-media">
            <img
              src="/images/community/gatherings/img-4678.webp"
              alt="InterProFinland workshop and professional development session"
              class="community-showcase-img"
              width="540"
              height="380"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="community-showcase-content">
            <div class="community-header-meta">
              <span class="community-index">02</span>
            </div>

            <h3 class="community-title">Workshops & Professional Development</h3>

            <p class="community-desc">
              Interactive sessions focused on career advancement, skill building, and navigating the
              Finnish job market. Learn from experts and peers in collaborative environments.
            </p>

            <div class="community-action-row">
              <a href="/community" class="btn-community-showcase">
                <span>Explore Workshops</span>
                <span class="cta-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>

        <article class="community-showcase-card">
          <div class="community-showcase-media">
            <img
              src="/images/events/general/wellness.webp"
              alt="Wellness and integration event for international professionals"
              class="community-showcase-img"
              width="540"
              height="380"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="community-showcase-content">
            <div class="community-header-meta">
              <span class="community-index">03</span>
            </div>

            <h3 class="community-title">Wellness & Integration Activities</h3>

            <p class="community-desc">
              Holistic support through wellness events, cultural integration activities, and peer
              support sessions that help international professionals feel at home in Finland.
            </p>

            <div class="community-action-row">
              <a href="/community" class="btn-community-showcase">
                <span>View All Activities</span>
                <span class="cta-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </Container>
  </Section>

  <!-- ══════════════════════════════════
       SECTION 7: SIGNATURE PROGRAMS & REGULAR FORMATS
       ══════════════════════════════════ -->
  <Section>
    <Container size="page">
      <div class="events-section-header">
        <div class="events-section-title-wrap">
          <span class="section-eyebrow">Community Activities & Initiatives</span>
          <h2 class="events-section-heading">Signature Programs & Regular Formats</h2>
        </div>
        <p class="events-section-desc">
          Discover our recurring language clubs, qualification guidance series, and regional talent
          fairs designed to empower international professionals.
        </p>
      </div>

      <div class="programs-showcase-list">
        {
          featuredEvents.map((evt, idx) => (
            <article class={`program-showcase-card ${idx % 2 !== 0 ? 'is-reversed' : ''}`}>
              <div class="program-showcase-media">
                <a href={evt.href} class="program-media-link" tabindex="-1" aria-hidden="true">
                  <img
                    src={evt.image}
                    alt={evt.title}
                    class="program-showcase-img"
                    width="480"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </div>

              <div class="program-showcase-content">
                <div class="program-header-meta">
                  <span class="program-index">0{idx + 1}</span>
                  <div class="program-meta-chips">
                    <span class="meta-chip">
                      <span class="chip-icon" aria-hidden="true">
                        🗓
                      </span>
                      <span>{evt.schedule}</span>
                    </span>
                    <span class="meta-chip">
                      <span class="chip-icon" aria-hidden="true">
                        📍
                      </span>
                      <span>{evt.location}</span>
                    </span>
                  </div>
                </div>

                <h3 class="program-title">
                  <a href={evt.href} class="program-title-link">
                    {evt.title}
                  </a>
                </h3>

                <p class="program-desc">{evt.description}</p>

                <div class="program-action-row">
                  <a href={evt.href} class="btn-program-cta">
                    <span>Explore This Format</span>
                    <span class="cta-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Real-time community connect callout -->
      <div class="events-community-callout">
        <div class="callout-content">
          <h3 class="callout-heading">Looking for Real-Time Schedules & Pop-up Sessions?</h3>
          <p class="callout-desc">
            We regularly post weekly club locations, workshop links, and guest speaker announcements
            in our Facebook group.
          </p>
        </div>
        <div class="callout-actions">
          <a
