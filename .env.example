# ==============================================================================
# InterProFinland Environment Variables
# ==============================================================================

# Public Environment Variables (exposed to client)
PUBLIC_SITE_URL=http://localhost:4321

# Private Environment Variables (server-only / Astro Actions)
# 1. Resend API Key (Create an API key at https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# 2. Contact Form Recipient Email (Destination inbox for contact inquiries)
# Default fallback if unset: info@interprofinland.fi
CONTACT_TO_EMAIL=info@interprofinland.fi

# 3. Verified Sender Email (Must be configured and verified in Resend domain settings)
# For local testing, Resend allows: onboarding@resend.dev
CONTACT_FROM_EMAIL=InterProFinland Contact <onboarding@resend.dev>
